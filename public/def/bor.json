{"L":{"boraginacee":{"c":"substantiv feminin","t":"(La pl.) Familie de plante erbacee, cu tulpinile și frunzele acoperite cu peri, cu flori constituite în inflorescențe și cu fructele formate din patru nucule cu câte o sămânță; (și la sg.) plantă care face parte din această familie.","s":"DEX '98"},"borî":{"c":"verb","t":"Intranz. și tranz. (Pop.) A vomita.","s":"DEX '98"},"boroni":{"c":"verb","t":"Tranz. (Reg.) A grăpa.","s":"DEX '98"},"borșire":{"c":"verb","t":"Refl. A se acri (ca borșul). ◊ (Despre mâncăruri, fructe etc.) A se strica (înăcrindu-se).","s":"DEX '98"},"borși":{"c":"verb","t":"1. Refl. (Despre oameni) A lua o atitudine amenințătoare, a deveni furios; a se mânia, a se înfuria; a țipa, a se răsti la cineva. 2. Tranz. (Despre păsări, animale) A-și înfoia, a-și zbârli penele, părul. ◊ A ciufuli părul unei persoane. 3. Refl. (Despre unele alimente) A începe să fermenteze, să se altereze, căpătând un aspect și un gust neplăcut, specific; a se acri, a se strica. Smântâna s-a zborșit. ◊ Fig. …","s":"DEX '98"},"borteli":{"c":"verb","t":"Tranz. (Reg.) A găuri. - Contaminare între bortă și sfredeli.","s":"DEX '98"},"borti":{"c":"verb","t":"Tranz. (Reg.) A găuri.","s":"DEX '98"},"borzoli":{"c":"verb","t":"Refl. 1. A se mânia brusc; a se răsti (la cineva); a se bursuca. ◊ Fig. (Despre vreme) A se schimba în rău. ◊ Refl. și tranz. fact. (Înv.) A (se) răscula, a (se) răzvrăti. 2. (Despre păr) A se zbârli. ♦ Expr. (Tranz.; fam.) A-și burzului creasta = a se grozăvi, a se îngâmfa.","s":"DEX '98"},"boraci":{"c":"substantiv neutru","t":"Unealtă portabilă, acționată manual, prevăzută cu un burghiu mișcat de o roată cu clichet și cu ajutorul căreia se dau găuri în piesele metalice mari, greu transportabile.","s":"DEX '98"},"bordaj":{"c":"substantiv neutru","t":"Înveliș exterior, metalic sau lemnos, al scheletului unei ambarcații.","s":"DEX '98"},"borș":{"c":"substantiv neutru","t":"Zeamă acră preparată din tărâțe de grâu, de secară sau de sfeclă de zahăr fermentate în apă; p. ext. ciorbă preparată cu această zeamă. ♦ Expr. A-i sufla (cuiva) în borș sau a sufla în borșul cuiva = a se amesteca (neîntrebat) în treburile cuiva. (Fam.) A mânca borș = a minți. A-i da (cuiva) borșul = a-i țâșni cuiva sângele din nas. A se face borș = a se înfuria. ◊ (Arg.) Sânge.","s":"DEX '98"},"borșit":{"c":"adjectiv","t":"Care s-a stricat (făcându-se acru ca borșul). - V. borși.","s":"DEX '98"},"bordurat":{"c":"verb","t":"Tranz. A face operația de răsfrângere a marginilor unui obiect prin tragere și întindere.","s":"DEX '98"},"bordura":{"c":"verb","t":"Tranz. A face operația de răsfrângere a marginilor unui obiect prin tragere și întindere.","s":"DEX '98"},"bornat":{"c":"adjectiv","t":"Cu borne. - V. borna.","s":"DEX '98"},"borna":{"c":"verb","t":"Tranz. A pune borne (1).","s":"DEX '98"},"borcănos":{"c":"adjectiv","t":"Mare, gros, umflat (ca un borcan). - Borcan + suf. -at.","s":"DEX '98"},"bordoși":{"c":"verb","t":"1. Tranz. A umple ceva ca pe un burduf (1); a îndesa, a ticsi. ◊ Refl. (Rar; despre ape) A se umfla. 2. Refl. (Despre tencuiala sau varul de pe pereți, despre placajul unei mobile etc.) A se scoroji, a se coșcovi. 3. Tranz. Fig. (Fam.) A bate zdravăn pe cineva.","s":"DEX '98"},"bortos":{"c":"adjectiv","t":"1. (Adesea substantivat) Care are burtă mare; pântecos, burduhănos, burduhos, burticos. 2. (Despre un vas, p. ext. despre alte obiecte) Bombat, pântecos. - Burtă + suf. -os.","s":"DEX '98"},"bord":{"c":"substantiv neutru","t":"Margine circulară (răsfrântă) care înconjură calota pălăriei.","s":"DEX '98"},"borbona":{"c":"verb","t":"Tranz. și refl. A (se) acoperi cu broboane. [Var.: brobona vb. I]","s":"DEX '98"},"bort":{"c":"substantiv neutru","t":"Diamant brut cu structură fibroasă și cu luciu, întrebuințat ca abraziv.","s":"DEX '98"},"borbonare":{"c":"verb","t":"I v. broboni.","s":"DEX '98"},"borborosi":{"c":"verb","t":"1. Intranz. și tranz. A vorbi nedeslușit. ◊ A vorbi într-o limbă străină (pe care ascultătorii nu o înțeleg). 2. Intranz. (Despre lichide) A gâlgâi, a scoate un zgomot asemănător cu cel al apei care fierbe. ◊ (Pop.) A chiorăi.","s":"DEX '98"},"bordel":{"c":"substantiv neutru","t":"Casă în care se practică prostituția; lupanar.","s":"DEX '98"},"borât":{"c":"adjectiv","t":"(Fam.) Dezgustător, scârbos, hidos. - V. borî.","s":"DEX '98"},"borâtură":{"c":"substantiv feminin","t":"(Pop.) Ceea ce se vomită. ◊ (Fam.) Epitet injurios dat cuiva. - Borî + suf. -tură.","s":"DEX '98"},"boronă":{"c":"substantiv feminin","t":"(Reg.) Grapă.","s":"DEX '98"},"bortili":{"c":"verb","t":"Tranz. (Reg.) A găuri. - Contaminare între bortă și sfredeli.","s":"DEX '98"},"bortilit":{"c":"adjectiv","t":"(Reg.) Găurit. - V. borteli.","s":"DEX '98"},"bora":{"c":"substantiv masculin","t":"invar. Vânt puternic, uscat și rece, care bate iarna dinspre munte spre mare, mai ales pe coastele de nord-est ale Mării Adriatice și ale Mării Negre.","s":"DEX '98"},"boric":{"c":"adjectiv","t":"(În sintagma) Acid boric = acid al borului, care se prezintă ca o pulbere albă, cristalină, fără miros, solubilă în apă, folosit ca antiseptic slab.","s":"DEX '98"},"borză":{"c":"substantiv feminin","t":"Gândac mare, negru, care trăiește în locuri umede și elimină la atingere o secreție rău mirositoare (Blaps mortisaga).","s":"DEX '98"},"bortă":{"c":"substantiv feminin","t":"(Reg.) Gaură; scorbură; groapă; vizuină.","s":"DEX '98"},"borsetă":{"c":"substantiv feminin","t":"Gentuță bărbătească pentru acte, documente etc.","s":"DEX '98"},"boreal":{"c":"adjectiv","t":"Din emisfera nordică; septentrional. [Pr.: -re-al]","s":"DEX '98"},"borț":{"c":"substantiv feminin","t":"Pește de apă dulce, lung de câțiva centimetri, care își depune icrele între valvele unor moluște (Rhodeus sericeus).","s":"DEX '98"},"borcănat":{"c":"adjectiv","t":"Mare, gros, umflat (ca un borcan). - Borcan + suf. -at.","s":"DEX '98"},"bor":{"c":"substantiv neutru","t":"Element chimic, semimetal negru-cenușiu, cristalin.","s":"DEX '98"},"bori":{"c":"verb","t":"Intranz. și tranz. (Pop.) A vomita.","s":"DEX '98"},"borură":{"c":"substantiv feminin","t":"Compus al borului cu metalele.","s":"DEX '98"},"boroană":{"c":"substantiv feminin","t":"(Reg.) Grapă.","s":"DEX '98"},"boron":{"c":"substantiv feminin","t":"(Reg.) Grapă.","s":"DEX '98"},"borangic":{"c":"substantiv neutru","t":"1. Fir depănat de pe gogoșile viermilor-de-mătase. 2. Țesătură făcută în industria casnică din acest fir. ◊ (La pl.) Diferite feluri de țesături de borangic (1). [Var.: burangic s. n.]","s":"DEX '98"},"borat":{"c":"substantiv masculin","t":"Sare a acidului boric.","s":"DEX '98"},"borax":{"c":"substantiv neutru","t":"Borat de sodiu.","s":"DEX '98"},"boronit":{"c":"substantiv neutru","t":"(Reg.) Acțiunea de a boroni; grăpat. - V. boroni.","s":"DEX '98"},"borboană":{"c":"substantiv feminin","t":"1. Picătură mare (de sudoare). 2. (Pop.) Bubuliță, zgrăbunță.","s":"DEX '98"},"borcan":{"c":"substantiv neutru","t":"Vas (cilindric) de sticlă, folosit pentru păstrarea conservelor, a preparatelor farmaceutice etc.","s":"DEX '98"},"borcănaș":{"c":"substantiv neutru","t":"Diminutiv al lui borcan. - Borcan + suf. -aș.","s":"DEX '98"},"borceag":{"c":"substantiv masculin","t":"(2) borceaguri, s. n. 1. S. m. Numele a două plante: a) măzăriche; b) plantă erbacee agățătoare, cu florile de culoare albă-gălbuie sau purpurie și cu fructe în formă de păstăi păroase (Vicia pannonica). 2. S. n. Amestec de măzăriche sau de mazăre furajeră cu o cereală păioasă, folosit ca nutreț.","s":"DEX '98"},"bordo":{"c":"adjectiv","t":"invar., s. n. Roșu-închis.","s":"DEX '98"},"bordură":{"c":"substantiv feminin","t":"1. Fâșie, panglică sau cusătură la marginea unui obiect textil. 2. Zonă care înconjură marginea unui obiect, cu o structură diferită de a acestuia; spec. zonă de la marginea dinspre partea carosabilă a trotuarului. Bordura de flori a unei peluze.","s":"DEX '98"},"bordei":{"c":"substantiv neutru","t":"1. Încăpere săpată (pe jumătate) în pământ și acoperită cu pământ, paie sau stuf. 2. P. ext. Locuință mică, rudimentară, sărăcăcioasă.","s":"DEX '98"},"bordeiaș":{"c":"substantiv neutru","t":"Diminutiv al lui bordei. - Bordei + suf. -aș.","s":"DEX '98"},"borderou":{"c":"substantiv neutru","t":"Listă recapitulativă de mărfuri, de sumele unui cont, de acte dintr-un dosar, de materiale dintr-o magazie etc.","s":"DEX '98"},"bordurare":{"c":"substantiv feminin","t":"Acțiunea de a bordura și rezultatul ei. - V. bordura.","s":"DEX '98"},"boreasă":{"c":"substantiv feminin","t":"(Reg.) Nevastă.","s":"DEX '98"},"borfaș":{"c":"substantiv masculin","t":"Hoț de rufe, de haine, de lucruri mărunte; găinar, bojogar. - Boarfă + suf. -aș.","s":"DEX '98"},"borfășie":{"c":"substantiv feminin","t":"(Rar) Îndeletnicirea borfașului; furt de lucruri mărunte. - Borfaș + suf. -ie.","s":"DEX '98"},"borviz":{"c":"substantiv neutru","t":"Apă minerală.","s":"DEX '98"},"borhot":{"c":"substantiv neutru","t":"Ceea ce rămâne din amestecul fermentat de fructe sau de cereale, după ce a fost folosit la fabricarea țuicii, a berii etc. ◊ (Rar; la pl.) Mațe, măruntaie de porc, de miel etc. necurățate.","s":"DEX '98"},"boricat":{"c":"adjectiv","t":"Preparat cu acid boric. ♦ Apă boricată = apă în care s-a dizolvat acid boric. Vaselină boricată = vaselină preparată cu acid boric.","s":"DEX '98"},"bormașină":{"c":"substantiv feminin","t":"Mașină de găurit metale, piatră etc. cu ajutorul unui burghiu rotitor.","s":"DEX '98"},"bornă":{"c":"substantiv feminin","t":"1. Stâlp fixat pe marginea unui drum pentru indicarea kilometrajului, a distanței până la localitățile de pe șosea etc. ◊ Stâlp implantat la distanțe regulate în marginea unui drum carosabil. 2. Piesă de contact montată la capătul unui conductor electric.","s":"DEX '98"},"bornare":{"c":"substantiv feminin","t":"Acțiunea de a borna și rezultatul ei; bornaj. - V. borna.","s":"DEX '98"},"bornaj":{"c":"substantiv neutru","t":"Bornare.","s":"DEX '98"},"boroboață":{"c":"substantiv feminin","t":"(Fam.) Poznă, neghiobie, faptă necugetată.","s":"DEX '98"},"borșișor":{"c":"substantiv masculin","t":"Plantă erbacee cu frunze cărnoase și flori roz, răspândită pe stâncile calcaroase (Sempervivum schlehani). - Borș + suf. -ișor.","s":"DEX '98"},"bortelit":{"c":"adjectiv","t":"(Reg.) Găurit. - V. borteli.","s":"DEX '98"},"bortit":{"c":"adjectiv","t":"(Reg.) Găurit. ◊ Scorburos. - V. borti.","s":"DEX '98"},"borțos":{"c":"adjectiv","t":"(Pop. și fam.; adesea substantivat) Cu burtă mare. ◊ (La f.) Gravidă. - Borț + suf. -os.","s":"DEX '98"}},"F":{"boraginaceea":["boraginacee"],"boraginaceei":["boraginacee"],"boraginaceele":["boraginacee"],"boraginaceelor":["boraginacee"],"borâre":["borî"],"boronire":["boroni"],"borșire":["borșire","borși"],"bortelire":["borteli"],"bortire":["borti"],"borzolire":["borzoli"],"borace":["boraci"],"boraciul":["boraci"],"boraciului":["boraci"],"boracele":["boraci"],"boracelor":["boraci"],"boraciu":["boraci"],"bordaje":["bordaj"],"bordajul":["bordaj"],"bordajului":["bordaj"],"bordajele":["bordaj"],"bordajelor":["bordaj"],"borșuri":["borș"],"borșul":["borș"],"borșului":["borș"],"borșurile":["borș"],"borșurilor":["borș"],"borșit":["borșit","borși"],"borșiți":["borși","borșit"],"borșitul":["borșit"],"borșitului":["borșit"],"borșiții":["borșit"],"borșiților":["borșit"],"borșită":["borșit"],"borșite":["borșit"],"borșita":["borșit"],"borșitei":["borșit"],"borșitele":["borșit"],"borșitelor":["borșit"],"borșitu":["borși","borșit"],"bordurat":["bordurat","bordura"],"bordurați":["bordura","bordurat"],"borduratu":["bordura","bordurat"],"bornat":["bornat","borna"],"bornați":["borna","bornat"],"bornatul":["bornat"],"bornatului":["bornat"],"bornații":["bornat"],"bornaților":["bornat"],"bornată":["bornat"],"bornate":["bornat"],"bornata":["bornat"],"bornatei":["bornat"],"bornatele":["bornat"],"bornatelor":["bornat"],"bornatu":["borna","bornat"],"borcănoși":["borcănos"],"borcănosul":["borcănos"],"borcănosului":["borcănos"],"borcănoșii":["borcănos"],"borcănoșilor":["borcănos"],"borcănoasă":["borcănos"],"borcănoa