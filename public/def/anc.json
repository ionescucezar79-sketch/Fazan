{"L":{"anchetare":{"c":"substantiv feminin","t":"Acțiunea de a ancheta. - V. ancheta.","s":"DEX '98"},"ancheta":{"c":"verb","t":"Tranz. A supune unei cercetări amănunțite; a face o anchetă.","s":"DEX '98"},"anchiloza":{"c":"verb","t":"Tranz. și refl. A produce sau a căpăta o anchiloză. ◊ Refl. Fig. A deveni sclav al rutinei, căpătând deprinderi de lucru mecanice.","s":"DEX '98"},"anchilozare":{"c":"substantiv feminin","t":"Faptul de a (se) anchiloza. - V. anchiloza.","s":"DEX '98"},"anclanșa":{"c":"verb","t":"Tranz. (Tehn.) A angrena un mecanism în vederea declanșării; a transmite o mișcare unei piese. ◊ A închide un circuit electric într-un releu printr-un dispozitiv (electro)mecanic.","s":"DEX '98"},"anclanșare":{"c":"substantiv feminin","t":"Acțiunea de a anclanșa și rezultatul ei. - V. anclanșa.","s":"DEX '98"},"ancolare":{"c":"substantiv feminin","t":"(Rar) Încleiere. - V. ancola.","s":"DEX '98"},"ancola":{"c":"verb","t":"Tranz. (Rar) A încleia.","s":"DEX '98"},"ancorare":{"c":"substantiv feminin","t":"Acțiunea de a (se) ancora; ancoraj (1). - V. ancora.","s":"DEX '98"},"ancora":{"c":"verb","t":"1. Intranz. A fixa o navă sau un corp plutitor de fundul apei cu ajutorul unei ancore; p. ext. a se opri, a ajunge (definitiv) undeva. ◊ Tranz. și refl. Fig. A (se) fixa. 2. Tranz. A lega un sistem tehnic de un alt sistem tehnic sau de pământ (pentru a împiedica deplasarea sau răsturnarea lui).","s":"DEX '98"},"ancrasa":{"c":"verb","t":"Tranz. și refl. (Despre o piesă într-un mecanism, despre un mecanism) A se acoperi de impurități (zgură, ulei, rugină etc.) care împiedică buna funcționare.","s":"DEX '98"},"ancrasare":{"c":"substantiv feminin","t":"Depunere de praf și de reziduuri pe anumite piese ale unui sistem tehnic, care împiedică funcționarea lor normală. - V. ancrasa.","s":"DEX '98"},"anchiloză":{"c":"substantiv feminin","t":"Suprimare parțială sau totală a mișcărilor într-o articulație; înțepenire a unei articulații.","s":"DEX '98"},"anclavă":{"c":"substantiv feminin","t":"1. Fragmente de roci înglobate în masa rocilor eruptive. 2. Grup de populație străină izolată în mijlocul populației indigene.","s":"DEX '98"},"ancoră":{"c":"substantiv feminin","t":"1. Piesă grea de metal cu brațele ca niște gheare, care se coboară cu un lanț, o frânghie sau o parâmă de pe o navă în fundul apei, unde se agață pentru a ține nava în loc. ♦ Expr. A arunca ancora = a ancora; a se opri. A ridica ancora = a pleca în călătorie (cu o navă). 2. Bară (de metal) în formă de T sau de X care împiedică un zid să se dărâme. ◊ Cablu care fixează stâlpi, coșuri înalte de fabrică.","s":"DEX '98"},"ancastrament":{"c":"substantiv neutru","t":"Locaș în zidăria unui chei pentru fixarea unei pasarele, a unei schele etc.","s":"DEX '98"},"ancombrament":{"c":"substantiv neutru","t":"Spațiu necesar pentru montarea, așezarea etc. unui utilaj, a unui obiect etc.","s":"DEX '98"},"ancoraj":{"c":"substantiv neutru","t":"1. Ancorare. 2. Loc unde se ancorează. 3. Ansamblu de piese care servește la ancorare. ◊ Sistem de cabluri, sfori etc. prin care se fixează un stâlp, o construcție înaltă etc. - Ancoră + suf. -aj (după fr. ancrage, it. ancoraggio).","s":"DEX '98"},"ancorator":{"c":"substantiv neutru","t":"Dispozitiv folosit la navele cu vele pentru coborârea ancorei (1). - Ancoră + suf. -tor.","s":"DEX '98"},"ancorot":{"c":"substantiv neutru","t":"Ancoră (1) mică folosită la ambarcațiile ușoare.","s":"DEX '98"},"anchilozat":{"c":"adjectiv","t":"(Adesea fig.) Care suferă de anchiloză. - V. anchiloza.","s":"DEX '98"},"anclanșat":{"c":"adjectiv","t":"(Despre mecanisme) Angrenat în vederea declanșării. - V. anclanșa.","s":"DEX '98"},"ancestral":{"c":"adjectiv","t":"Strămoșesc.","s":"DEX '98"},"anchetă":{"c":"substantiv feminin","t":"Cercetare ordonată sau efectuată de o autoritate publică, pentru a clarifica împrejurările în care s-a produs un fapt și pentru a stabili răspunderile. ◊ Cercetare științifică făcută pe teren.","s":"DEX '98"},"anchetator":{"c":"substantiv masculin și feminin","t":"Persoană care face o anchetă. - Anchetă + suf. -tor.","s":"DEX '98"},"anchetatoare":{"c":"substantiv masculin și feminin","t":"Persoană care face o anchetă. - Anchetă + suf. -tor.","s":"DEX '98"},"anceps":{"c":"substantiv neutru","t":"Semn care marchează cantitatea unei silabe.","s":"DEX '98"},"ancablură":{"c":"substantiv feminin","t":"Unitate de măsură pentru lungime egală cu a zecea parte dintr-o milă marină.","s":"DEX '98"},"ancoșă":{"c":"substantiv feminin","t":"1. (Cin.) Decupare făcută pe marginea peliculei cinematografice pentru a declanșa anumite operații în procesul de developare. 2. (Elt.) Canal făcut într-o piesă metalică pentru a introduce în el conductorii electrici ai unei înfășurări.","s":"DEX '98"},"ancilar":{"c":"adjectiv","t":"(Livr.) De slugă; p. ext. subordonat, umil.","s":"DEX '98"},"anchilostom":{"c":"substantiv masculin","t":"Vierme intestinal care perforează vasele de sânge din intestin (Ankilostoma duodenale).","s":"DEX '98"},"ancadrament":{"c":"substantiv neutru","t":"Chenar decorativ în relief care înconjură o ușă, o fereastră etc.","s":"DEX '98"},"anchilostomiază":{"c":"substantiv feminin","t":"Boală provocată de anchilostom, caracterizată prin inflamarea mucoasei intestinale și prin pierderea hemoglobinei. [Pr.: -mi-a-]","s":"DEX '98"},"ancie":{"c":"substantiv feminin","t":"Mică lamă elastică (de metal, de lemn sau de trestie) fixată în muștiucul unui instrument de suflat pentru a produce sunete sau pentru a le intensifica.","s":"DEX '98"}},"F":{"anchetare":["anchetare","ancheta"],"anchetări":["anchetare"],"anchetarea":["anchetare"],"anchetării":["anchetare"],"anchetările":["anchetare"],"anchetărilor":["anchetare"],"anchilozare":["anchilozare","anchiloza"],"anchilozări":["anchilozare"],"anchilozarea":["anchilozare"],"anchilozării":["anchilozare"],"anchilozările":["anchilozare"],"anchilozărilor":["anchilozare"],"anclanșare":["anclanșare","anclanșa"],"anclanșări":["anclanșare"],"anclanșarea":["anclanșare"],"anclanșării