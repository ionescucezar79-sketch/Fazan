{"L":{"tăgârța":{"c":"verb","t":"Refl. (Reg.) A se agăța de cineva.","s":"DEX '98"},"tăgăduire":{"c":"substantiv feminin","t":"Acțiunea de a tăgădui și rezultatul ei; tăgăduială. - V. tăgădui.","s":"DEX '98"},"tăgădui":{"c":"verb","t":"Tranz. A contesta o afirmație, a nu recunoaște ceva; a nega; a dezminți. ◊ (Rar) A refuza.","s":"DEX '98"},"tagmă":{"c":"substantiv feminin","t":"Totalitatea persoanelor care aparțin aceleiași categorii profesionale sau sociale; breaslă; ceată. ◊ (Peior.) Clică, gașcă.","s":"DEX '98"},"tăgadă":{"c":"substantiv feminin","t":"Tăgăduială. ♦ Loc. adv. fără (putință de) tăgadă = neîndoios, nedezmințit, sigur.","s":"DEX '98"},"tăgăduință":{"c":"substantiv feminin","t":"(Înv.) Tăgăduială. - Tăgădui + suf. -ință.","s":"DEX '98"},"tăgârță":{"c":"substantiv feminin","t":"(Reg.) Traistă, sac.","s":"DEX '98"},"țagră":{"c":"substantiv feminin","t":"1. Semifabricat de oțel cu secțiunea dreptunghiulară sau circulară, din care se laminează bare, sârme etc. și din care se forjează sau se ștanțează diferite piese; biletă. 2. Partea ascuțită a unui par, care intră în pământ. ♦ Expr. A rămâne cu ochii țaglă = a rămâne cu ochii țintă, pironiți.","s":"DEX '98"},"tăgăduială":{"c":"substantiv feminin","t":"Faptul de a tăgădui; negare, contestare; tăgadă, tăgăduire, tăgăduință. [Pr.: -du-ia-] - Tăgădui + suf. -eală.","s":"DEX '98"},"tăgadnic":{"c":"adjectiv","t":"(Înv.) Care tăgăduiește; mincinos. - Tăgadă + suf. -nic.","s":"DEX '98"},"tăgăduit":{"c":"adjectiv","t":"Care poate fi pus la îndoială, contestat. - V. tăgădui.","s":"DEX '98"},"tagă":{"c":"substantiv feminin","t":"(Înv.) Tăgăduială, tăgadă, negare; contestare. ♦ Loc. adv. Fără (de) tagă = fără îndoială, incontestabil.","s":"DEX '98"},"țaglă":{"c":"substantiv feminin","t":"1. Semifabricat de oțel cu secțiunea dreptunghiulară sau circulară, din care se laminează bare, sârme etc. și din care se forjează sau se ștanțează diferite piese; biletă. 2. Partea ascuțită a unui par, care intră în pământ. ♦ Expr