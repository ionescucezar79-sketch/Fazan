{"L":{"hăui":{"c":"verb","t":"IV v. hăui.","s":"DEX '98"},"hăuire":{"c":"verb","t":"IV v. aui.","s":"DEX '96"},"hau":{"c":"interjecție","t":"(De obicei repetat) Cuvânt care imită lătratul câinelui sau urletul lupului.","s":"DEX '96"},"hăugaș":{"c":"substantiv neutru","t":"Urmă adâncă (și îngustă) săpată în pământ de șuvoaiele apelor de ploaie sau lăsată de roțile unui vehicul. ◊ Scobitură săpată pe întreaga lungime a frontului minier de abataj, pentru a ușura desprinderea ulterioară a rocii. ◊ Fig. Direcție, drum. Și-a orientat cercetările pe un nou făgaș. [Pl. și: făgașuri. - Var.: (reg.) hăugaș, hogaș, văgaș s. n.]","s":"DEX '96"},"hăuli":{"c":"verb","t":"Intranz. (Despre oameni) A chiui (1). ◊ (Despre voce, zgomote etc.) A răsuna prelung; a hăui, a hui. ◊ Tranz. (Rar) A cânta ceva (prelung, chiuind). [Pr.: hă-u-]","s":"DEX '96"},"hăulit":{"c":"substantiv neutru","t":"Hăulire. [Pr.: hă-u-] - V. hăuli.","s":"DEX '96"},"hăuit":{"c":"substantiv neutru","t":"Răsunet prelung, ecou; hău. [Pr.: hă-u-] - V. hăui.","s":"DEX '96"},"hău":{"c":"substantiv neutru","t":"Prăpastie adâncă; abis, genune, adânc (II). ♦ Expr. (Pop.) Cât (e) hăul = niciodată; cu nici un preț.","s":"DEX '96"},"haustor":{"c":"substantiv masculin","t":"Organ vegetal asemănător cu o ventuză, cu ajutorul căruia unele plante parazite își absorb hrana din plantele pe care parazitează. [Pr.: ha-us-] - După fr. haustorie.","s":"DEX '96"},"hăuială":{"c":"substantiv feminin","t":"(Pop.) Zgomot confuz, monoton și prelung. [Pr.: a-u-. - Var.: hăuială s. f.] - Aui + suf. -eală.","s":"DEX '96"},"hăulire":{"c":"substantiv feminin","t":"Acțiunea de a hăuli și rezultatul ei; chiuit, hăulit. [Pr.: hă-u-] - V. hăuli.","s":"DEX '96"},"hăulitură":{"c":"substantiv feminin","t":"Chiuitură. [Pr.: hă-u-] - Hăuli + suf. -tură.","s":"DEX '96"}},"F":{"hăuire":["hăuire","hăui"],"hăugașe":["hăugaș"],"hăugașul":["hăugaș"],"hăugașului":["hăugaș"],"hăugașele":["hăugaș"],"hăugașelor":["hăugaș"],"hăulit":["hăulit","hăuli"],"hăuliți":["