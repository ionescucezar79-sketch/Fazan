{"L":{"ischemie":{"c":"substantiv feminin","t":"(Med.) Întrerupere a circulației sanguine într-un țesut sau organ, datorită unui spasm arterial sau astupării unui vas.","s":"DEX '98"},"ischialgie":{"c":"substantiv feminin","t":"(Med.) Nevralgie sciatică. [Pr.: -chi-al-]","s":"DEX '98"},"iscare":{"c":"substantiv feminin","t":"Acțiunea de a (se) isca și rezultatul ei. - V. isca.","s":"DEX '98"},"isca":{"c":"verb","t":"Refl. A se naște, a lua ființă, a se ivi, a se produce, a apărea (pe neașteptate, deodată). ◊ Tranz. A face să se nască, să se ivească, a scoate la iveală, a provoca (pe neașteptate); p. ext. a născoci, a inventa.","s":"DEX '98"},"iscăli":{"c":"verb","t":"Tranz., intranz. și refl. A(-și) scrie numele pe textul unui act oficial, al unei scrisori, al unei chitanțe etc., a(-și) pune semnătura (pentru a întări, a autentifica etc.); a (se) semna.","s":"DEX '98"},"iscălire":{"c":"substantiv feminin","t":"Acțiunea de a (se) iscăli și rezultatul ei. - V. iscăli.","s":"DEX '98"},"iscodi":{"c":"verb","t":"Tranz. 1. A cerceta ceva sau pe cineva cu de-amănuntul (și în ascuns) pentru a afla un secret, adevărul etc.; a spiona. ♦ Refl. recipr. Se iscodeau cu privirea. 2. A pune cuiva întrebări insistente pentru a se informa, pentru a afla un secret etc. 3. A născoci, a inventa un lucru; a scorni, a plăsmui.","s":"DEX '98"},"iscodire":{"c":"substantiv feminin","t":"Acțiunea de a (se) iscodi și rezultatul ei. - V. iscodi.","s":"DEX '98"},"iscusi":{"c":"verb","t":"Tranz. și refl. (Înv.) A (se) face mai îndemânatic, mai ager, mai isteț; a (se) face mai fin, mai rafinat.","s":"DEX '98"},"iscodeală":{"c":"substantiv feminin","t":"1. Acțiunea de a iscodi. 2. Născocire, invenție, scornitură, iscodenie. - Iscodi + suf. -eală.","s":"DEX '98"},"iscoadă":{"c":"substantiv feminin","t":"Persoană însărcinată să facă, în taină, cercetări sau să obțină informații în interesul cuiva; militar trimis în recunoaștere; spion.","s":"DEX '98"},"iscusință":{"c":"substantiv feminin","t":"Îndemânare, dibăcie, pricepere; p. ext. talent, artă. - Iscusi + suf. -ință.","s":"DEX '98"},"ischemic":{"c":"adjectiv","t":"(Med.) Referitor la ischemie; provocat de ischemie.","s":"DEX '98"},"ischiatic":{"c":"adjectiv","t":"(Med.) Al ischionului. [Pr.: -chi-a-]","s":"DEX '98"},"iscoditor":{"c":"adjectiv","t":"1. Care caută să pătrundă cu mintea, să afle, să observe cu de-amănuntul; care spionează. ◊ (Adverbial) Bănuitor. 2. Care pune cuiva întrebări insistente pentru a se informa, care caută să descoasă pe cineva. 3. Care inventează; născocitor. - Iscodi + suf. -tor.","s":"DEX '98"},"iscat":{"c":"verb","t":"Refl. A se naște, a lua ființă, a se ivi, a se produce, a apărea (pe neașteptate, deodată). ◊ Tranz. A face să se nască, să se ivească, a scoate la iveală, a provoca (pe neașteptate); p. ext. a născoci, a inventa.","s":"DEX '98"},"iscălit":{"c":"substantiv neutru","t":"Faptul de a (se) iscăli. - V. iscăli.","s":"DEX '98"},"iscusit":{"c":"adjectiv","t":"1. Îndemânatic, dibaci, abil, ingenios, priceput; învățat. 2. Făcut cu pricepere, cu măiestrie, cu artă. - V. iscusi.","s":"DEX '98"},"iscălitură":{"c":"substantiv feminin","t":"Numele unei persoane scris de ea însăși pe un act oficial, pe o scrisoare, pe o chitanță etc. (pentru a le certifica); semnătură; p. ext. felul cum iscălește cineva. - Iscăli + suf. -tură.","s":"DEX '98"},"iscoditură":{"c":"substantiv feminin","t":"(Rar) Lucru iscodit; invenție, scornitură; minciună. - Iscodi + suf. -tură.","s":"DEX '98"},"ișchiuzar":{"c":"adjectiv","t":"s. m. și f. (Înv.) (Om) dibaci, șiret, șmecher, iscusit. [Var.: ișchiuzar, -ă adj., s. m. și f.]","s":"DEX '98"},"ișchiuzară":{"c":"adjectiv","t":"s. m. și f. (Înv.) (Om) dibaci, șiret, șmecher, iscusit. [Var.: ișchiuzar, -ă adj., s. m. și f.]","s":"DEX '98"},"ischion":{"c":"substantiv neutru","t":"Una dintre cele trei părți care formează osul iliac. [Pr.: -chi-on]","s":"DEX '98"},"ischiuzar":{"c":"adjectiv","t":"s. m. și f. (Înv.) (Om) dibaci, șiret, șmecher, iscusit. [Var.: ișchiuzar, -ă adj., s. m. și f.]","s":"DEX '98"},"ischiuzară":{"c":"adjectiv","t":"s. m. și f. (Înv.) (Om) dibaci, șiret, șmecher, iscusit. [Var.: ișchiuzar, -ă adj., s. m. și f.]","s":"DEX '98"},"iscodenie":{"c":"substantiv feminin","t":"(Rar) Iscodeală (2). - Iscodi + suf. -enie.","s":"DEX '98"}},"F":{"ischemii":["ischemie"],"ischemia":["ischemie"],"ischemiei":["ischemie"],"ischemiile":["ischemie"],"ischemiilor":["ischemie"],"ischialgii":["ischialgie"],"ischialgia":["ischialgie"],"ischialgiei":["ischialgie"],"ischialgiile":["ischialgie"],"ischialgiilor":["ischialgie"],"iscare":["iscare","isca"],"iscări":["iscare"],"iscarea":["iscare"],"iscării":["iscare"],"iscările":["iscare"],"iscărilor":["iscare"],"iscălire":["iscălire","iscăli"],"iscăliri":["iscălire"],"iscălirea":["iscălire"],"iscălirii":["iscălire"],"iscălirile":["iscălire"],"iscălirilor":["iscălire"],"iscodire":["iscodire","iscodi"],"iscodiri":["iscodire"],"iscodirea":["iscodire"],"iscodirii":["iscodire"],"iscodirile":["iscodire"],"iscodirilor":["iscodire"],"iscusire":["iscusi"],"iscodeli":["iscodeală"],"iscodeala":["iscodeală"],"iscodelii":["iscodeală"],"iscodelile":["iscodeală"],"iscodelilor":["iscodeală"],"iscoade":["iscoadă"],"iscoada":["iscoadă"],"iscoadei":["iscoadă"],"iscoadele":["iscoadă"],"iscoadelor":["iscoadă"],"iscusințe":["iscusință"],"iscusința":["iscusință"],"iscusinței":["iscusință"],"iscusințele":["iscusință"],"iscusințelor":["iscusință"],"ischemici":["ischemic"],"ischemicul":["ischemic"],"ischemicului":["ischemic"],"ischemicii":["ischemic"],"ischemicilor":["ischemic"],"ischemică":["ischemic"],"ischemice":["ischemic"],"ischemica":["ischemic"],"ischemicei":["ischemic"],"ischemicele":["ischemic"],"ischemicelor":["ischemic"],"ischiatici":["ischiatic"],"ischiaticul":["ischiatic"],"ischiaticului":["ischiatic"],"ischiaticii":["ischiatic"],"ischiaticilor":["ischiatic"],"ischiatică":["ischiatic"],"ischiatice":["ischiatic"],"ischiatica":["ischiatic"],"ischiaticei":["ischiatic"],"ischiaticele":["ischia