{"L":{"hurie":{"c":"substantiv feminin","t":"(În religia musulmană) Fecioară deosebit de frumoasă promisă de Mahomed credincioșilor în paradis. ◊ P. ext. Fecioară sau femeie foarte frumoasă.","s":"DEX '96"},"huruitor":{"c":"adjectiv","t":"(Rar) Care huruie. [Pr.: -ru-i-] - Hurui + suf. -tor.","s":"DEX '96"},"hurducare":{"c":"substantiv feminin","t":"Acțiunea de a (se) hurduca și rezultatul ei. - V. hurduca.","s":"DEX '96"},"hurduca":{"c":"verb","t":"1. Tranz. și refl. A se mișca încoace și încolo cu putere, a (se) clătina, a (se) scutura, a (se) zgâlțâi, a (se) zdruncina. 2. Intranz. (Reg.) A face zgomot mare; a hurui. [Var.: urduca vb. I]","s":"DEX '96"},"hurducăire":{"c":"verb","t":"(Reg.) 1. Tranz. și refl. A (se) clătina, a (se) scutura (tare); a (se) zdruncina, a (se) zgudui. 2. Intranz. A face zgomot, a hodorogi.","s":"DEX '96"},"hurducăi":{"c":"verb","t":"(Reg.) 1. Tranz. și refl. A (se) clătina, a (se) scutura (tare); a (se) zdruncina, a (se) zgudui. 2. Intranz. A face zgomot, a hodorogi.","s":"DEX '96"},"hurdui":{"c":"verb","t":"Intranz. (Reg.) A hurui.","s":"DEX '96"},"hurduire":{"c":"verb","t":"Intranz. (Reg.) A hurui.","s":"DEX '96"},"hurui":{"c":"verb","t":"IV v. hurui.","s":"DEX '98"},"hurtă":{"c":"substantiv feminin","t":"(Reg.; în loc. adv.) Cu hurta = cu grămada, cu toptanul. La hurtă = la întâmplare, fără alegere. [Var.: vurtă s. f.]","s":"DEX '96"},"hurducăială":{"c":"substantiv feminin","t":"Hurducătură. [Pr.: -că-ia-] - Hurducăi + suf. -eală.","s":"DEX '96"},"huruială":{"c":"substantiv feminin","t":"Huruitură. [Pr.: -ru-ia-] - Hurui + suf. -eală.","s":"DEX '96"},"hural":{"c":"substantiv neutru","t":"Fiecare dintre organele locale ale puterii de stat în Mongolia. ♦ Marele hural = parlamentul mongol.","s":"DEX '96"},"hurdler":{"c":"substantiv masculin","t":"Alergător în proba de garduri. [Pr.: hardlăr] - Cuv. engl.","s":"DEX '96"},"hurez":{"c":"substantiv masculin","t":"Numele a două păsări răpitoare de noapte, asemănătoare cu bufnița, fără smocuri de pene pe cap, care scot un strigăt caracteristic și trăiesc în scorburi de copaci; ciuhurez (Strix aluco și urelensis). ♦ Expr. A sta ca un huhurez (sau ca huhurezul) = a sta singur, părăsit. A se scula ca huhurezii = a se scula foarte devreme dimineața. [Var.: (reg.) hurez s. m.] - Huhura + suf. -ez.","s":"DEX '96"},"hurican":{"c":"substantiv neutru","t":"Furtună puternică, uragan care bântuie în insulele Antile.","s":"DEX '96"},"hurmuz":{"c":"substantiv neutru","t":"(2) hurmuzi, s. m. 1. S. n. Mărgea de sticlă imitând mărgăritarul; (la pl.) șirag de astfel de mărgele. 2. S. m. Arbust ornamental cu flori trandafirii și cu fructe bace albe de mărimea cireșelor (Symphoricarpus albus).","s":"DEX '96"},"huron":{"c":"substantiv masculin","t":"Persoană din tribul indian existent altădată la marginea lacurilor Huron și Ontario.","s":"DEX '96"},"hursuz":{"c":"adjectiv","t":"(Despre oameni și manifestările lor; adesea substantivat) Morocănos, posac, neprietenos, necomunicativ, nesociabil. ◊ Fig. Lipsit de atracție, de căldură; respingător. [Var.: (pop.) hursuz, -ă adj.]","s":"DEX '96"},"hursuzlâc":{"c":"substantiv neutru","t":"(Înv.) 1. Nenoroc, ghinion; pacoste. 2. Ursuzenie. [Var.: hursuzlâc s. n.]","s":"DEX '98"},"huruit":{"c":"adjectiv","t":"huruit.","s":"DEX '96"},"hurducăit":{"c":"verb","t":"(Reg.) 1. Tranz. și refl. A (se) clătina, a (se) scutura (tare); a (se) zdruncina, a (se) zgudui. 2. Intranz. A face zgomot, a hodorogi.","s":"DEX '96"},"hurducătură":{"c":"substantiv feminin","t":"Zdruncinătură, zguduire; zgomot produs de ceva care (se) hurducă; hurducăială. - Hurduca + suf. -ătură.","s":"DEX '96"},"hurduitură":{"c":"substantiv feminin","t":"(Reg.) Huruitură. [Pr.: -du-i-] - Hurdui + suf. -tură.","s":"DEX '96"},"huruitură":{"c":"substantiv feminin","t":"v. huruitură.","s":"DEX '98"}},"F":{"hurii":["hurie"],"huria":["hurie"],"huriei":["hurie"],"huriile":["hurie"],"huriilor":["hurie"],"huruitoare":["huruitor"],"huruitori":["huruitor"],"huruitoarea":["huruitor"]