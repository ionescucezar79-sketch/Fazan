{"L":{"deloc":{"c":"adverb","t":"Nicidecum. - De + loc.","s":"DEX '98"},"delabora":{"c":"verb","t":"Tranz. A demonta dintr-un loc instalațiile, mașinile și munițiile devenite inutilizabile sau periculoase.","s":"DEX '98"},"delaborare":{"c":"substantiv feminin","t":"Acțiunea de a delabora. - V. delabora.","s":"DEX '98"},"delabra":{"c":"verb","t":"Tranz. (Franțuzism) A deteriora, a strica, a ruina.","s":"DEX '98"},"delapida":{"c":"verb","t":"Tranz. A sustrage, a fura, bani sau alte bunuri din avutul statului.","s":"DEX '98"},"delapidare":{"c":"substantiv feminin","t":"Acțiunea de a delapida și rezultatul ei; infracțiune care constă în însușirea, folosirea sau traficarea de către un angajat, în interesul său sau al altei persoane, a unor sume de bani sau a altor bunuri aflate în gestiunea sau în administrarea sa; sustragere de bani sau de bunuri din avutul statului. - V. delapida.","s":"DEX '98"},"delăsare":{"c":"substantiv feminin","t":"Faptul de a se delăsa; nepăsare, neglijență față de o muncă începută. - V. delăsa.","s":"DEX '98"},"delăsa":{"c":"verb","t":"Refl. (Folosit mai ales la perf. c.) A dovedi nepăsare, neglijență față de o muncă începută, a abandona o treabă începută.","s":"DEX '98"},"delecta":{"c":"verb","t":"Tranz. și refl. A (se) desfăta, a (se) încânta, a (se) bucura.","s":"DEX '98"},"delectare":{"c":"substantiv feminin","t":"Faptul de a (se) delecta; desfătare, încântare; distracție. - V. delecta.","s":"DEX '98"},"delestare":{"c":"substantiv feminin","t":"Acțiunea de a delesta. - V. delesta.","s":"DEX '98"},"delesta":{"c":"verb","t":"Tranz. A arunca lestul din corăbii, din baloane pentru a le ușura.","s":"DEX '98"},"delexicalizare":{"c":"substantiv feminin","t":"Faptul de a (se) delexicaliza. - V. delexicaliza.","s":"DEX '98"},"delexicaliza":{"c":"verb","t":"Tranz. și refl. (Lingv.) A face să piardă sau a pierde conținutul semantic. - Des- + lexical + suf. -iza.","s":"DEX '98"},"deliberare":{"c":"substantiv feminin","t":"Acțiunea de a delibera și rezultatul ei; consfătuire, chibzuire; dezbatere, deliberație. - V. delibera.","s":"DEX '98"},"delibera":{"c":"verb","t":"1. Intranz. (Despre membrii unei instanțe judecătorești, ai unei adunări legiuitoare) A chibzui în comun și a discuta (în secret) asupra luării unei hotărâri. 2. Tranz. A decide, a rezolva.","s":"DEX '98"},"delimitare":{"c":"substantiv feminin","t":"Acțiunea de a (se) delimita și rezultatul ei; fixare a limitelor unui lucru. - V. delimita.","s":"DEX '98"},"delimita":{"c":"verb","t":"Tranz. și refl. A (se) stabili, a (se) fixa limitele unui lucru; a (se) mărgini, a (se) limita. ◊ A (se) contura.","s":"DEX '98"},"delintersa":{"c":"verb","t":"Tranz. A îndepărta, pe cale chimică sau mecanică, firele scurte de pe semințele de bumbac egrenate, înainte de decorticarea lor. - Des- + linters.","s":"DEX '98"},"delintersare":{"c":"substantiv feminin","t":"Acțiunea de a delintersa și rezultatul ei. - V. delintersa.","s":"DEX '98"},"delirare":{"c":"substantiv feminin","t":"Acțiunea de a delira și rezultatul ei. - V. delira.","s":"DEX '98"},"delira":{"c":"verb","t":"Intranz. A fi în stare de delir; a aiura.","s":"DEX '98"},"deliricizare":{"c":"substantiv feminin","t":"Pierdere sau înlăturare a lirismului. - Des- + liricizare.","s":"DEX '98"},"delegațiune":{"c":"substantiv feminin","t":"1. Misiune sau însărcinare de-a se prezenta sau de a acționa în numele cuiva ◊ (Concr.) Act prin care cineva este desemnat ca delegat. 2. Grup de persoane împuternicit cu o misiune specială.","s":"DEX '98"},"delir":{"c":"substantiv neutru","t":"1. Tulburare a conștiinței, manifestată prin halucinații, aiurări, iluzii etc., întâlnită în unele boli mintale, în stări febrile etc. 2. Fig. Stare de exaltare, de extaz, de frenezie; entuziasm excesiv.","s":"DEX '98"},"delicateță":{"c":"substantiv feminin","t":"Însușirea a ceea ce este delicat; finețe, gingășie; discreție, subtilitate. [Var.: delicateță s. f.]","s":"DEX '98"},"delicatețe":{"c":"substantiv feminin","t":"Însușirea a ceea ce este delicat; finețe, gingășie; discreție, subtilitate. [Var.: delicateță s. f.]","s":"DEX '98"},"delicvență":{"c":"substantiv feminin","t":"1. Fenomen social care constă în săvârșirea de delicte. 2. Totalitatea delictelor săvârșite, la un moment dat, într-un anumit mediu sau de către persoane de o anumită vârstă. [Var.: delicvență s. f.]","s":"DEX '98"},"delitescență":{"c":"substantiv feminin","t":"Dispariție subită a unei tumori sau a unei inflamații.","s":"DEX '98"},"delniță":{"c":"substantiv feminin","t":"1. (În evul mediu, în Țara Românească) Parte din hotarul moșiei satului care se afla în stăpânirea ereditară a unei familii de țărani ce locuiau în satul respectiv; jirebie. 2. (În evul mediu, în Țara Românească și în Moldova) Parte dintr-o anumită subîmpărțire structurală a pământului satului. Patru delnițe de fânaț. 3. (Înv. și reg.) Fâșie îngustă și lungă de teren situată într-o luncă sau pe un delușor; p. ext. …","s":"DEX '98"},"deltă":{"c":"substantiv feminin","t":"Formă de relief rezultată din depunerea de mâl și de nisip la vărsarea unei ape curgătoare într-un lac, în mare sau în ocean, pe un teren cu panta lină, în condițiile lipsei mareelor și a acțiunii curenților litorali.","s":"DEX '98"},"delta":{"c":"substantiv masculin","t":"invar. A patra literă a alfabetului grecesc (în formă de triunghi). ◊ Fig. Simbol al adevărului; p. ext. adevăr. - Cuv. gr.","s":"DEX '98"},"deliu":{"c":"substantiv masculin","t":"adj. (Înv.) 1. S. m. Soldat din călărimea ușoară turcă. ◊ (În Țara Românească și în Moldova) Soldat din corpul de călăreți înființat de Minai Viteazul o dată cu corpul beșliilor; (în perioada fanariotă) soldat din garda domnească. 2. Adj., s. m. (Om) voinic, viteaz, îndrăzneț. 3. Adj. Furios, vehement, nebun.","s":"DEX '98"},"delibașă":{"c":"substantiv masculin","t":"(În evul mediu, în epoca fanariotă) Șeful gărzii domnești, căpetenia deliilor.","s":"DEX '98"},"delibașa":{"c":"substantiv masculin","t":"(În evul mediu, în epoca fanariotă) Șeful gărzii domnești, căpetenia deliilor.","s":"DEX '98"},"delicios":{"c":"adjectiv","t":"(Despre mâncăruri și băuturi) Foarte gustos, savuros. ◊ Fig. Extrem de plăcut, încântător, fermecător.","s":"DEX '98"},"deliciosus":{"c":"substantiv masculin","t":"Ciupercă comestibilă cu pălăria de culoare portocalie-cărămizie și cu picior galben-portocaliu, care crește prin pădurile de fag și de brad și care secretă un latex (Lactarius deliciosus).","s":"DEX '98"},"delătura":{"c":"verb","t":"Tranz. (Reg.) A înlătura. - De + latură.","s":"DEX '98"},"deletnici":{"c":"verb","t":"Refl. A se ocupa cu ceva, a-și petrece vremea cu ceva.","s":"DEX '98"},"delebil":{"c":"adjectiv","t":"(Livr.) Care poate fi șters.","s":"DEX '98"},"delectabil":{"c":"adjectiv","t":"Plăcut, agreabil, încântător.","s":"DEX '98"},"deleter":{"c":"adjectiv","t":"(Livr.) Vătămător.","s":"DEX '98"},"deliberant":{"c":"adjectiv","t":"Care deliberează.","s":"DEX '98"},"deliberativ":{"c":"adjectiv","t":"Care deliberează având dreptul de a lua o hotărâre. ♦ Vot deliberativ = vot al cărui rezultat este obligatoriu.","s":"DEX '98"},"delicat":{"c":"adjectiv","t":"1. (Despre ființe și lucruri, cu privire la forma, la aspectul lor) Fin, gingaș, subțirel, grațios; p. ext. fragil; (despre ființe) plăpând, șubred, slăbuț. ◊ (Despre culori, nuanțe) Discret, atenuat, pal, estompat. 2. De calitate bună (în ceea ce privește finețea materialului și a execuției). ◊ (Despre mâncăruri, băuturi, parfumuri) Fin, ales. 3. (Despre oameni și despre manifestările lor; …","s":"DEX '98"},"delict":{"c":"substantiv neutru","t":"Fapt nepermis de legea penală; infracțiune de mai mică gravitate, care se sancționează cu amendă penală sau cu închisoare corecțională.","s":"DEX '98"},"delicvescent":{"c":"adjectiv","t":"(Despre substanțe chimice) Care absoarbe vaporii de apă din atmosferă până la solubilizare.","s":"DEX '98"},"delimitabil":{"c":"adjectiv","t":"Care poate fi delimitat.","s":"DEX '98"},"delimitativ":{"c":"adjectiv","t":"(Rar) Care delimitează, care servește pentru a delimita; delimitator. - Delimita + suf. -ativ.","s":"DEX '98"},"delirant":{"c":"adjectiv","t":"Care este în stare de delir, ca de delir. ◊ Fig. Care se manifestă într-o formă asemănătoare delirului; excesiv, exaltat, frenetic.","s":"DEX '98"},"deltoid":{"c":"adjectiv","t":"s. m. 1. Adj. În formă de triunghi. 2. S. m. Mușchi al articulației umărului, în forma literei delta, fixat pe omoplat, claviculă și capătul humerusului, care determină rotația internă și externă a brațului.","s":"DEX '98"},"deluleț":{"c":"substantiv neutru","t":"(Rar) Delușor. - Deal + suf. -uleț.","s":"DEX '98"},"deluros":{"c":"adjectiv","t":"Cu multe dealuri (1); accidentat. - Deal + suf. -os.","s":"DEX '98"},"delușor":{"c":"substantiv neutru","t":"Diminutiv al lui deal; deluț, deluleț. - Deal + suf. -ușor.","s":"DEX '98"},"deluț":{"c":"substantiv neutru","t":"(Pop.) Delușor. - Deal + suf. -uț.","s":"DEX '98"},"delestat":{"c":"verb","t":"Tranz. A arunca lestul din corăbii, din baloane pentru a le ușura.","s":"DEX '98"},"delexicalizat":{"c":"adjectiv","t":"Care nu mai are conținut semantic. - V. delexicaliza.","s":"DEX '98"},"delintersat":{"c":"verb","t":"Tranz. A îndepărta, pe cale chimică sau mecanică, firele scurte de pe semințele de bumbac egrenate, înainte de decorticarea lor. - Des- + linters.","s":"DEX '98"},"deliberat":{"c":"adjectiv","t":"(Adesea adverbial) Care a fost făcut în mod intenționat, din proprie voință. - V. delibera. Cf. fr. délibéré.","s":"DEX '98"},"delapidator":{"c":"substantiv masculin și feminin","t":"Persoană care delapidează.","s":"DEX '98"},"delapidatoare":{"c":"substantiv masculin și feminin","t":"Persoană care delapidează.","s":"DEX '98"},"delega":{"c":"verb","t":"Tranz. A transmite cuiva dreptul de a acționa ca reprezentant al unei persoane sau al unei instituții. ◊ A însărcina pe cineva, pe timp limitat, cu executarea, supravegherea sau organizarea unei lucrări.","s":"DEX '98"},"delegat":{"c":"substantiv masculin și feminin","t":"1. Persoană care a primit o delegație. 2. Reprezentant sau trimis al unui stat ori al unui guvern la o conferință, la un congres sau la o organizație națională sau internațională.","s":"DEX '98"},"delegație":{"c":"substantiv feminin","t":"1. Misiune sau însărcinare de-a se prezenta sau de a acționa în numele cuiva ◊ (Concr.) Act prin care cineva este desemnat ca delegat. 2. Grup de persoane împuternicit cu o misiune specială.","s":"DEX '98"},"delegată":{"c":"substantiv masculin și feminin","t":"1. Persoană care a primit o delegație. 2. Reprezentant sau trimis al unui stat ori al unui guvern la o conferință, la un congres sau la o organizație națională sau internațională.","s":"DEX '98"},"deliberație":{"c":"substantiv feminin","t":"(Înv.) Deliberare.","s":"DEX '98"},"deliciu":{"c":"substantiv neutru","t":"Plăcere deosebit de mare; desfătare. ◊ Fig. (Fam.) Lucru, ființă încântătoare.","s":"DEX '98"},"delincvent":{"c":"substantiv masculin și feminin","t":"Persoană care a săvârșit un delict penal. [Var.: delicvent, -ă s. m. și f.]","s":"DEX '98"},"delincventă":{"c":"substantiv masculin și feminin","t":"Persoană care a săvârșit un delict penal. [Var.: delicvent, -ă s. m. și f.]","s":"DEX '98"},"delicvent":{"c":"substantiv masculin și feminin","t":"Persoană care a săvârșit un delict penal. [Var.: delicvent, -ă s. m. și f.]","s":"DEX '98"},"delicventă":{"c":"substantiv masculin și feminin","t":"Persoană care a săvârșit un delict penal. [Var.: delicvent, -ă s. m. și f.]","s":"DEX '98"},"delicvescență":{"c":"substantiv feminin","t":"Proprietate a unor substanțe solide de a fi delicvescente. ◊ Fig. Decadență, degenerare, degenerescență.","s":"DEX '98"},"delăsător":{"c":"adjectiv","t":"s. m. și f. (Persoană) care se delasă; neglijent, indolent. - Delăsa + suf. -tor.","s":"DEX '98"},"delăsătoare":{"c":"adjectiv","t":"s. m. și f. (Persoană) care se delasă; neglijent, indolent. - Delăsa + suf. -tor.","s":"DEX '98"},"delco":{"c":"substantiv neutru","t":"Cap distribuitor la motoarele cu aprindere electrică.","s":"DEX '98"},"delcou":{"c":"substantiv neutru","t":"Cap distribuitor la motoarele cu aprindere electrică.","s":"DEX '98"},"delegatar":{"c":"adjectiv","t":"s. m. și f. (Persoană) care deleagă, (persoană) care dă o delegație.","s":"DEX '98"},"delegatară":{"c":"adjectiv","t":"s. m. și f. (Persoană) care deleagă, (persoană) care dă o delegație.","s":"DEX '98"},"delfinist":{"c":"substantiv masculin și feminin","t":"Înotător în stilul delfin (3).","s":"DEX '98"},"delfinistă":{"c":"substantiv masculin și feminin","t":"Înotător în stilul delfin (3).","s":"DEX '98"},"delincvență":{"c":"substantiv feminin","t":"1. Fenomen social care constă în săvârșirea de delicte. 2. Totalitatea delictelor săvârșite, la un moment dat, într-un anumit mediu sau de către persoane de o anumită vârstă. [Var.: delicvență s. f.]","s":"DEX '98"},"deltaplanist":{"c":"substantiv masculin","t":"Pilot sportiv al deltaplanului.","s":"DEX '98"},"delfin":{"c":"substantiv masculin","t":"1. Mamifer marin cu corpul în formă de fus, care atinge mărimea de trei metri, cu botul alungit, prevăzut cu numeroși dinți conici, și care trăiește în grupuri compacte în toate mările; porc-de-mare (Delphinus delphis). 2. (Art.) Constelație din emisfera boreală, în vecinătatea Căii-Laptelui. 3. …","s":"DEX '98"},"delimitator":{"c":"adjectiv","t":"Delimitativ. - Delimita + suf. -tor.","s":"DEX '98"},"delator":{"c":"substantiv masculin și feminin","t":"Persoană care face o delațiune; denunțător, pârâtor.","s":"DEX '98"},"delatoare":{"c":"substantiv masculin și feminin","t":"Persoană care face o delațiune; denunțător, pârâtor.","s":"DEX '98"},"delfinariu":{"c":"substantiv neutru","t":"1. Bazin amenajat pentru delfini (1). 2. Sală sau clădire care adăpostește un delfinariu (1) în care au loc reprezentații cu delfini (1). - Delfin + suf. -ariu.","s":"DEX '98"},"deltaplan":{"c":"substantiv neutru","t":"1. Aparat de zbor foarte ușor (de forma literei grecești delta) care poate plana în curentul dinamic de pantă sau pluti în curentul termic ascensional. 2. Deltaplanism.","s":"DEX '98"},"delațiune":{"c":"substantiv feminin","t":"Denunțare, denunț; pâră. [Pr.: -ți-u-]","s":"DEX '98"},"deleatur":{"c":"substantiv neutru","t":"Nume dat semnului de corectură tipografică prin care se indică suprimarea unei litere, a unui grup de litere etc. [Pr.: -le-a-] - Cuv. lat.","s":"DEX '98"},"delictual":{"c":"adjectiv","t":"Delictuos. [Pr.: -tu-al]","s":"DEX '98"},"delictuos":{"c":"adjectiv","t":"(Despre fapte) Care prezintă caracterele unui delict, care ține de delict; delictual. [Pr.: -tu-os]","s":"DEX '98"},"delineavit":{"c":"substantiv neutru","t":"Cuvânt care însoțește, într-unul din colțurile de jos ale unei gravuri, numele autorului. [Pr.: -ne-a-] - Cuv. lat.","s":"DEX '98"},"deltaic":{"c":"adjectiv","t":"Care ține de deltă, privitor la deltă. [Pr.: -ta-ic]","s":"DEX '98"},"deltaplanism":{"c":"substantiv neutru","t":"Sport aviatic practicat cu deltaplanul (1); deltaplan (2).","s":"DEX '98"},"deluviu":{"c":"substantiv neutru","t":"Material sedimentar provenit din alterarea și dezagregarea rocilor, aflat în curs de scurgere sub influența apelor de șiroire pe pantele diferiților versanți.","s":"DEX '98"},"deluzoriu":{"c":"adjectiv","t":"(Livr.) Înșelător, iluzoriu.","s":"DEX '98"},"delicatesă":{"c":"substantiv feminin","t":"(Mai ales la pl.) Aliment fin, ales (îndeosebi prăjituri și specialități culinare).","s":"DEX '98"},"deligație":{"c":"substantiv feminin","t":"Aplicație a unui bandaj, a unui aparat sau a unui medicament extern.","s":"DEX '98"}},"F":{"delaborare":["delaborare","delabora"],"delaborări":["delaborare"],"delaborarea":["delaborare"],"delaborării":["delaborare"],"delaborările":["delaborare"],"delaborărilor":["delaborare"],"delabrare":["delabra"],"delapidare":["delapidare","delapida"],"delapidări":["delapidare"],"delapidarea":["delapidare"],"delapidării":["delapidare"],"delapidările":["delapidare"],"delapidărilor":["delapidare"],"delăsare":["delăsare","delăsa"],"delăsări":