iv","t":"Care poate fi remaniat. [Pr.: -ni-a-]","s":"DEX '98"},"remediere":{"c":"substantiv feminin","t":"Acțiunea de a remedia și rezultatul ei. [Pr.: -di-e-] - V. remedia.","s":"DEX '98"},"remediabil":{"c":"adjectiv","t":"Care poate fi remediat, corectat, căruia i se poate aduce o îndreptare, o îmbunătățire, căruia i s-a găsit un remediu. [Pr.: -di-a-]","s":"DEX '98"},"remediu":{"c":"substantiv neutru","t":"Mijloc de îndreptare sau de îmbunătățire a unei situații, a unei stări etc.; soluție. ◊ Leac, doctorie, medicament.","s":"DEX '98"},"remisiune":{"c":"substantiv feminin","t":"1. (Livr.) Iertare. 2. Ameliorare sau dispariție temporară a manifestărilor unei boli. [Pr.: -si-u-]","s":"DEX '98"},"remontoar":{"c":"substantiv neutru","t":"Mecanism cu ajutorul căruia se întoarce un ceas.","s":"DEX '98"},"remuneratoriu":{"c":"adjectiv","t":"Care remunerează; care aduce câștig, folos; folositor, rentabil.","s":"DEX '98"}},"F":{"remarcare":["remarcare","remarca"],"remarcări":["remarcare"],"remarcarea":["remarcare"],"remarcării":["remarcare"],"remarcările":["remarcare"],"remarcărilor":["remarcare"],"remăritare":["remăritare","remărita"],"rememorare":["rememorare","rememora"],"rememorări":["rememorare"],"rememorarea":["rememorare"],"rememorării":["rememorare"],"rememorările":["rememorare"],"rememorărilor":["rememorare"],"remilitarizare":["remilitarizare","remilitariza"],"remilitarizări":["remilitarizare"],"remilitarizarea":["remilitarizare"],"remilitarizării":["remilitarizare"],"remilitarizările":["remilitarizare"],"remilitarizărilor":["remilitarizare"],"remizare":["remizare","remiza"],"remizări":["remizare"],"remizarea":["remizare"],"remizării":["remizare"],"remizările":["remizare"],"remizărilor":["remizare"],"remobilare":["remobilare","remobila"],"remobilări":["remobilare"],"remobilarea":["remobilare"],"remobilării":["remobilare"],"remobilările":["remobilare"],"remobilărilor":["remobilare"],"remontare":["remontare","remonta"],"remontări":["remontare"],"remontarea":["remon