{"L":{"remarca":{"c":"verb","t":"Tranz. A observa; a băga de seamă; a releva. ◊ Refl. A se distinge, a se deosebi; a se evidenția.","s":"DEX '98"},"remarcare":{"c":"substantiv feminin","t":"Acțiunea de a (se) remarca și rezultatul ei. - V. remarca.","s":"DEX '98"},"remăritare":{"c":"verb","t":"Refl. A se mărita din nou; a se recăsători. - Re- + mărita.","s":"DEX '98"},"remărita":{"c":"verb","t":"Refl. A se mărita din nou; a se recăsători. - Re- + mărita.","s":"DEX '98"},"rememora":{"c":"verb","t":"Tranz. A-și reaminti, a-și aduce din nou aminte.","s":"DEX '98"},"rememorare":{"c":"substantiv feminin","t":"Acțiunea de a rememora și rezultatul ei. - V. rememora.","s":"DEX '98"},"remilitariza":{"c":"verb","t":"Tranz. A reorganiza armata unei țări, a reface industria de război a acesteia.","s":"DEX '98"},"remilitarizare":{"c":"substantiv feminin","t":"Acțiunea de a remilitariza și rezultatul ei. - V. remilitariza.","s":"DEX '98"},"remizare":{"c":"substantiv feminin","t":"Acțiunea de a remiza. - V. remiza.","s":"DEX '98"},"remiza":{"c":"verb","t":"Intranz. A termina o partidă de șah la egalitate.","s":"DEX '98"},"remobilare":{"c":"substantiv feminin","t":"Acțiunea de a remobila și rezultatul ei. - V. remobila.","s":"DEX '98"},"remobila":{"c":"verb","t":"Tranz. A mobila din nou, a schimba mobila. - Re- + mobila.","s":"DEX '98"},"remontare":{"c":"substantiv feminin","t":"Acțiunea de a (se) remonta și rezultatul ei. - V. remonta.","s":"DEX '98"},"remonta":{"c":"verb","t":"1. Tranz. A monta din nou o fabrică, o instalație etc. 2. Refl. și tranz. Fig. A-și reveni, a se reface, a se redresa sau a face să-și revină, să se refacă, să se redreseze. 3. Tranz. A procura cai pentru armată.","s":"DEX '98"},"remorca":{"c":"verb","t":"Tranz. A trage după sine legat (cu un cablu) un vapor; a târî cu sila; a atașa pe cineva unui grup. [Prez. ind. și: remorc]","s":"DEX '98"},"remorcare":{"c":"substantiv feminin","t":"Acțiunea de a remorca și rezultatul ei; tragere a unui vehicul de către un alt vehicul autopropulsat, astfel încât vehiculul atașat să se deplaseze fără consum propriu de energie; remorcaj. - V. remorca.","s":"DEX '98"},"remunerare":{"c":"substantiv feminin","t":"Acțiunea de a remunera și rezultatul ei; remunerație. - V. remunera.","s":"DEX '98"},"remunera":{"c":"verb","t":"Tranz. A retribui; a plăti.","s":"DEX '98"},"remușcare":{"c":"substantiv feminin","t":"Mustrare de cuget; părere de rău; căință, regret. - Re- + mușcare (după fr. remords).","s":"DEX '98"},"remite":{"c":"verb","t":"Tranz. 1. A preda, a înmâna, a da. 2. A renunța la o sumă de bani datorată unui debitor, a face să se stingă o datorie. 3. (Rar) A amâna.","s":"DEX '98"},"remitere":{"c":"substantiv feminin","t":"Acțiunea de a remite și rezultatul ei. ♦ Remitere de datorie = renunțare totală sau parțială a unui creditor la dreptul său împotriva debitorului; iertare de datorie. - V. remite.","s":"DEX '98"},"remunerațiune":{"c":"substantiv feminin","t":"Retribuție, plată, remunerare.","s":"DEX '98"},"remanență":{"c":"substantiv feminin","t":"(în sintagmele) Remanență electrică = stare de polarizare a unui corp electric păstrată de acesta după anularea câmpului electric polarizator extern. Remanență magnetică = stare de magnetizare a unui corp feromagnetic păstrată de acesta după anularea câmpului de magnetizare exterior.","s":"DEX '98"},"reminiscență":{"c":"substantiv feminin","t":"Amintire vagă a unor fapte aproape dispărute din memorie. ◊ Rămășiță, rest, urmă (abia perceptibilă).","s":"DEX '98"},"remitență":{"c":"substantiv feminin","t":"1. (Livr.) Remisiune (1). 2. (Med.) Remisiune (2).","s":"DEX '98"},"remiză":{"c":"substantiv feminin","t":"1. Situație în care doi șahiști angajați într-o partidă amicală sau oficială consimt reciproc asupra unui rezultat de egalitate; partidă de șah terminată la egalitate. 2. Formă de retribuire (în comerț) potrivit căreia lucrătorii primesc pentru munca prestată o sumă de bani calculată în funcție de volumul vânzărilor, cumpărărilor, contractărilor etc. pe care aceștia le efectuează; …","s":"DEX '98"},"remontă":{"c":"substantiv feminin","t":"(Și în sintagma cal de remontă) Cal tânăr (de tracțiune), folosit în armată. ◊ Serviciu militar însărcinat cu procurarea cailor pentru armată.","s":"DEX '98"},"rem":{"c":"substantiv masculin","t":"(Fiz.) Unitate de măsură a dozelor de radiație raportate la efectul lor biologic (egală cu doza primită de un anumit țesut iradiat astfel încât doza absorbită să fie de un rad).","s":"DEX '98"},"remi":{"c":"substantiv neutru","t":"Joc de societate cu cărți sau cu mici plăci prismatice de piatră, de lemn, material plastic etc., marcate cu cifre de diferite culori; pietre. [Pr.: römi] - Cuv. engl.","s":"DEX '98"},"remu":{"c":"substantiv neutru","t":"(Mar.) Contracurent în lungul malurilor unui curs de apă. ◊ (Met.) Remuu de aer = zonă instabilă a sistemului baric, unde apar curenți ascendenți și descendenți. [Var.: remu s. n.]","s":"DEX '98"},"remanent":{"c":"adjectiv","t":"(Despre câmpuri electrice sau magnetice). Care se datorește fenomenului de remanență.","s":"DEX '98"},"remarcabil":{"c":"adjectiv","t":"Vrednic de luat în seamă; deosebit, ales, însemnat.","s":"DEX '98"},"rememorativ":{"c":"adjectiv","t":"De amintire; comemorativ.","s":"DEX '98"},"remontant":{"c":"adjectiv","t":"Care întărește, înviorează. ◊ (Despre plante) Care înflorește de mai multe ori în perioada de vegetație.","s":"DEX '98"},"remorcabil":{"c":"adjectiv","t":"Care poate fi remorcat. - Remorca + suf. -bil.","s":"DEX '98"},"remorcaj":{"c":"substantiv neutru","t":"Remorcare.","s":"DEX '98"},"remuu":{"c":"substantiv neutru","t":"(Mar.) Contracurent în lungul malurilor unui curs de apă. ◊ (Met.) Remuu de aer = zonă instabilă a sistemului baric, unde apar curenți ascendenți și descendenți. [Var.: remu s. n.]","s":"DEX '98"},"remunerativ":{"c":"adjectiv","t":"Care servește pentru remunerare. ◊ Profitabil.","s":"DEX '98"},"remușcător":{"c":"adjectiv","t":"(Rar) Care provoacă mustrare de cuget, remușcări. - Remușc[are] + suf. -ător.","s":"DEX '98"},"remania":{"c":"verb","t":"Tranz. 1. A face modificări în organizarea unei instituții, în compoziția unui guvern etc. 2. A transforma parțial o mașină, o instalație sau o construcție, după o deteriorare, cu scopul readucerii în starea de funcționare sau pentru a-i îmbunătăți caracteristicile funcționale. 3. …","s":"DEX '98"},"remedia":{"c":"verb","t":"Tranz. A îndrepta, a îmbunătăți o situație, o stare etc. [Pr.: -di-a]","s":"DEX '98"},"remilitarizat":{"c":"verb","t":"Tranz. A reorganiza armata unei țări, a reface industria de război a acesteia.","s":"DEX '98"},"remis":{"c":"verb","t":"Tranz. 1. A preda, a înmâna, a da. 2. A renunța la o sumă de bani datorată unui debitor, a face să se stingă o datorie. 3. (Rar) A amâna.","s":"DEX '98"},"remobilat":{"c":"verb","t":"Tranz. A mobila din nou, a schimba mobila. - Re- + mobila.","s":"DEX '98"},"remontat":{"c":"verb","t":"1. Tranz. A monta din nou o fabrică, o instalație etc. 2. Refl. și tranz. Fig. A-și reveni, a se reface, a se redresa sau a face să-și revină, să se refacă, să se redreseze. 3. Tranz. A procura cai pentru armată.","s":"DEX '98"},"remunerat":{"c":"verb","t":"Tranz. A retribui; a plăti.","s":"DEX '98"},"remunerație":{"c":"substantiv feminin","t":"Retribuție, plată, remunerare.","s":"DEX '98"},"remarcă":{"c":"substantiv feminin","t":"Observație, constatare; notă, însemnare.","s":"DEX '98"},"remaia":{"c":"verb","t":"Tranz. A repara ciorapii sau un tricot, ridicând și prinzând cu un instrument special ochiurile rupte ori scăpate sau firele deșirate.","s":"DEX '98"},"remaiere":{"c":"substantiv feminin","t":"Acțiunea de a remaia și rezultatul ei; remaiat. - V. remaia.","s":"DEX '98"},"remaiat":{"c":"substantiv neutru","t":"Faptul de a remaia; remaiere. - V. remaia.","s":"DEX '98"},"remaieză":{"c":"substantiv feminin","t":"Persoană care se ocupă cu remaierea ciorapilor.","s":"DEX '98"},"remaniare":{"c":"substantiv feminin","t":"Acțiunea de a remania și rezultatul ei. 