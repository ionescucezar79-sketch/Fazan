{"L":{"toxicodermie":{"c":"substantiv feminin","t":"(Med.) Toxidermie.","s":"DEX '98"},"toxicofobie":{"c":"substantiv feminin","t":"Teamă patologică de otrăvire; toxofobie.","s":"DEX '98"},"toxidermie":{"c":"substantiv feminin","t":"(Med.) Erupție cutanată datorită unei substanțe toxice; toxicodermie.","s":"DEX '98"},"toxofobie":{"c":"substantiv feminin","t":"(Med.) Toxicofobie.","s":"DEX '98"},"toxicoză":{"c":"substantiv feminin","t":"Infecție gravă a copiilor mici, manifestată prin diaree, vomă, denutriție etc.","s":"DEX '98"},"toxină":{"c":"substantiv feminin","t":"1. Substanță organică (mai frecvent proteică) cu acțiune toxică, produsă de organisme vegetale sau animale. 2. Substanță care îngreunează sau împiedică flotația minereurilor.","s":"DEX '98"},"toxicogen":{"c":"adjectiv","t":"Care produce o substanță toxică.","s":"DEX '98"},"toxicologic":{"c":"adjectiv","t":"Care aparține toxicologiei, privitor la toxicologie.","s":"DEX '98"},"toxic":{"c":"adjectiv","t":"s. n. 1. Adj. Care poate intoxica, otrăvi; otrăvitor. 2. Otravă.","s":"DEX '98"},"toxică":{"c":"adjectiv","t":"s. n. 1. Adj. Care poate intoxica, otrăvi; otrăvitor. 2. Otravă.","s":"DEX '98"},"toxicolog":{"c":"substantiv masculin și feminin","t":"Specialist în toxicologie.","s":"DEX '98"},"toxicologie":{"c":"substantiv feminin","t":"Ramură a medicinii care se ocupă cu studierea otrăvurilor și a toxinelor (1) și cu tratarea celor otrăviți.","s":"DEX '98"},"toxicologă":{"c":"substantiv masculin și feminin","t":"Specialist în toxicologie.","s":"DEX '98"},"toxoplasmoză":{"c":"substantiv feminin","t":"(Med.) Boală parazitară provocată de toxoplasmă.","s":"DEX '98"},"toxicofor":{"c":"adjectiv","t":"(Despre viețuitoare) Care conține substanțe toxice (pentru om).","s":"DEX '98"},"toxicomanie":{"c":"substantiv feminin","t":"Obișnuință morbidă de a folosi doze repetate și crescânde de substanțe toxice.","s":"DEX '98"},"toxicoman":{"c":"substantiv masculin și feminin","t":"adj. (Persoană) care suferă de toxicomanie