{"L":{"izbăvire":{"c":"substantiv feminin","t":"(Pop.) Acțiunea de a (se) izbăvi și rezultatul ei; scăpare, salvare, mântuire. - V. izbăvi.","s":"DEX '98"},"izbăvi":{"c":"verb","t":"Tranz. și refl. (Pop.) A scăpa (dintr-o primejdie, boală etc.); a (se) salva, a (se) mântui.","s":"DEX '98"},"izbândi":{"c":"verb","t":"1. Intranz. A învinge (în luptă), a fi victorios; a birui, a triumfa. 2. Tranz. A reuși într-o acțiune, a izbuti să realizeze ceva. ◊ A duce la îndeplinire; a realiza, a împlini.","s":"DEX '98"},"izbi":{"c":"verb","t":"1. Tranz. și refl. A (se) lovi cu putere (de ceva, de cineva sau cu ceva); a (se) repezi cu violență; a (se) trânti. ◊ Tranz. și refl. A (se) arunca cu putere; a (se) azvârli. 2. Tranz. (Despre lumină) A cădea cu putere, a lovi drept în față, în ochi. 3. Tranz. A ataca. 4. Tranz. Fig. A impresiona puternic pe cineva; a surprinde, a frapa, a bate la ochi.","s":"DEX '98"},"izbire":{"c":"substantiv feminin","t":"Acțiunea de a (se) izbi și rezultatul ei; lovire. - V. izbi.","s":"DEX '98"},"izbucnire":{"c":"substantiv feminin","t":"Acțiunea de a izbucni și rezultatul ei; dezlănțuire. - V. izbucni.","s":"DEX '98"},"izbucni":{"c":"verb","t":"Intranz. 1. A se manifesta brusc și cu putere; a se arăta deodată; p. ext. a țâșni. 2. (Despre sunete, vorbe etc.; la pers. 3) A se porni deodată și cu intensitate, a se auzi deodată. [Var.: zbucni vb. IV]","s":"DEX '98"},"izbuti":{"c":"verb","t":"Tranz. și intranz. A duce ceva la bun sfârșit; a reuși, a izbândi.","s":"DEX '98"},"izbutire":{"c":"substantiv feminin","t":"Acțiunea de a izbuti și rezultatul ei; succes, reușită, izbândă. - V. izbuti.","s":"DEX '98"},"izbă":{"c":"substantiv feminin","t":"Căsuță (de lemn) specifică unor sate rusești.","s":"DEX '98"},"izbândă":{"c":"substantiv feminin","t":"Victorie, biruință (în luptă). ◊ Reușită, succes (într-o acțiune).","s":"DEX '98"},"izbăvitoare":{"c":"substantiv masculin și feminin","t":"adj. (Pop.) 1. S. m. și f. Persoană care izbăvește; salvator, mântuitor. 2. Adj. Care izbăvește, vindecă. - Izbăvi + suf. -tor.","s":"DEX '98"},"izbăvitor":{"c":"substantiv masculin și feminin","t":"adj. (Pop.) 1. S. m. și f. Persoană care izbăvește; salvator, mântuitor. 2. Adj. Care izbăvește, vindecă. - Izbăvi + suf. -tor.","s":"DEX '98"},"izbeliște":{"c":"substantiv feminin","t":"(Pop.; în expr.) (A lăsa) de izbeliște = (a lăsa) la voia întâmplării, părăsit de toți, fără supraveghere. - Izbi + suf. -eliște.","s":"DEX '98"},"izbânditor":{"c":"adjectiv","t":"(Rar) Care izbândește; biruitor, învingător. - Izbândi + suf. -tor.","s":"DEX '98"},"izbitor":{"c":"adjectiv","t":"Care impresionează puternic; impresionant, frapant, uimitor. - Izbi + suf. -tor.","s":"DEX '98"},"izbuc":{"c":"substantiv neutru","t":"Izvor de apă cu debit intermitent.","s":"DEX '98"},"izbândit":{"c":"verb","t":"1. Intranz. A învinge (în luptă), a fi victorios; a birui, a triumfa. 2. Tranz. A reuși într-o acțiune, a izbuti să realizeze ceva. ◊ A duce la îndeplinire; a realiza, a împlini.","s":"DEX '98"},"izbăvit":{"c":"adjectiv","t":"(Pop.) Scăpat, salvat; mântuit. - V. izbăvi.","s":"DEX '98"},"izbutit":{"c":"adjectiv","t":"Care a fost bine realizat, care s-a bucurat de succes; reușit. - V. izbuti.","s":"DEX '98"},"izbitură":{"c":"substantiv feminin","t":"Lovitură puternică. ◊ (Rar) Semn rămas în urma unei lovituri; contuzie. - Izbi + suf. -tură.","s":"DEX '98"}},"F":{"izbăvire":["izbăvire","izbăvi"],"izbăviri":["izbăvire"],"izbăvirea":["izbăvire"],"izbăvirii":["izbăvire"],"izbăvirile":["izbăvire"],"izbăvirilor":["izbăvire"],"izbândire":["izbândi"],"izbire":["izbire","izbi"],"izbiri":["izbire"],"izbirea":["izbire"],"izbirii":["izbire"],"izbirile":["izbire"],"izbirilor":["izbire"],"izbucnire":["izbucnire","izbucni"],"izbucniri":["izbucnire"],"izbucnirea":["izbucnire"],"izbucnirii":["izbucnire"],"izbucnirile":["izbucnire"],"izbucnirilor":["izbucnire"],"izbutire":["izbutire","izbuti"],"izbutiri":["izbutire"],"izbutirea":["izbutire"],"izbutirii":["izbutire"],"izbutirile"