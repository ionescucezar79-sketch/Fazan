{"L":{"snopi":{"c":"verb","t":"Tranz. 1. (Reg.) A strânge și a lega cerealele păioase în snopi, a face snopi. 2. Fig. (Fam.) A bate foarte rău pe cineva. ◊ Refl. (Rar) A se obosi foarte tare (din cauza unei munci grele); a se istovi.","s":"DEX '98"},"snopire":{"c":"substantiv feminin","t":"Acțiunea de a (se) snopi și rezultatul ei. - V. snopi.","s":"DEX '98"},"snoavă":{"c":"substantiv feminin","t":"Mică povestire (de tip popular) cu conținut anecdotic.","s":"DEX '98"},"snopeală":{"c":"substantiv feminin","t":"Bătaie strașnică; chelfăneală. - Snopi + suf. -eală.","s":"DEX '98"},"snopuleț":{"c":"substantiv masculin","t":"Snopușor. - Snop + suf. -uleț.","s":"DEX '98"},"snopușor":{"c":"substantiv masculin","t":"Diminutiv al lui snop; snopuleț. - Snop + suf. -ușor.","s":"DEX '98"},"snop":{"c":"substantiv masculin","t":"1. Legătură mare făcută din mănunchiuri de cereale păioase (secerate). 2. Grup de lucruri de același fel care formează un mănunchi, o legătură. ◊ Fig. Fascicul de lumină, de raze luminoase etc. 3. Schije, alice sau gloanțe trase o dată cu o armă și răspândite într-o anumită direcție.","s":"DEX '98"},"snob":{"c":"substantiv masculin și feminin","t":"adj. (Persoană) care admiră și adoptă fără discernământ și cu orice preț tot ce este la modă.","s":"DEX '98"},"snoabă":{"c":"substantiv masculin și feminin","t":"adj. (Persoană) care admiră și adoptă fără discernământ și cu orice preț tot ce este la modă.","s":"DEX '98"},"snobism":{"c":"substantiv neutru","t":"Atitudine, conduită specifică snobului.","s":"DEX '98"}},"F":{"snopire":["snopire","snopi"],"snopiri":["snopire"],"snopirea":["snopire"],"snopirii":["snopire"],"snopirile":["snopire"],"snopirilor":["snopire"],"snoave":["snoavă"],"snoava":["snoavă"],"snoavei":["snoavă"],"snoavele":["snoavă"],"snoavelor":["snoavă"],"snopeli":["snopeală"],"snopeala":["snopeală"],"snopelii":["snopeală"],"snopelile":["snopeală"],"snopelilor":["snopeală"],"snopește":["snopi"],"snopuleți":["snopuleț"],"snopulețul":["snopuleț"],"s