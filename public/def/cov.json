{"L":{"covița":{"c":"verb","t":"Intranz. (Reg.) A guița.","s":"DEX '98"},"coviț":{"c":"interjecție","t":"(Reg.) Guiț.","s":"DEX '98"},"covățică":{"c":"substantiv feminin","t":"Diminutiv al lui covată. - Covată + suf. -ică.","s":"DEX '98"},"covariație":{"c":"substantiv feminin","t":"Variație simultană, reciproc condiționată; covarianță. [Pr.: -ri-a-]","s":"DEX '98"},"covăcie":{"c":"substantiv feminin","t":"(Reg.) 1. Meseria covaciului; fierărie (2), covălie (1). 2. Atelierul covaciului; fierărie (1), covălie (2). - Covaci + suf. -ie.","s":"DEX '98"},"covălie":{"c":"substantiv feminin","t":"(Reg.) 1. Covăcie (1). 2. Covăcie (2). - Covali + suf. -ie.","s":"DEX '98"},"covăsi":{"c":"verb","t":"Tranz. (Pop.) A acri laptele dulce cu ajutorul unui cuib de smântână sau de covăseală.","s":"DEX '98"},"covârși":{"c":"verb","t":"Tranz. A depăși, a întrece (cu mult) în măsură, în număr, în forță etc.; p. ext. a copleși, a învinge.","s":"DEX '98"},"covițăi":{"c":"verb","t":"Intranz. (Reg.) A guița.","s":"DEX '98"},"covrigi":{"c":"verb","t":"Refl. (Rar) A se încovriga.","s":"DEX '98"},"covalență":{"c":"substantiv feminin","t":"Legătură chimică realizată prin punerea în comun a unuia sau a mai multor electroni de către fiecare dintre atomii participanți.","s":"DEX '98"},"covertă":{"c":"substantiv feminin","t":"Puntea superioară a unei nave; punte de manevră.","s":"DEX '98"},"covercă":{"c":"substantiv feminin","t":"(Reg.) 1. Coviltir. ◊ Acoperământ de frunze, de crengi, de rogojini etc. care servește ca adăpost împotriva soarelui, a ploii etc. 2. Nuia încovoiată. ◊ Fiecare dintre sârmele care alcătuiesc scheletul umbrelei. [Var.: covercă s. f.]","s":"DEX '98"},"covergă":{"c":"substantiv feminin","t":"(Reg.) 1. Coviltir. ◊ Acoperământ de frunze, de crengi, de rogojini etc. care servește ca adăpost împotriva soarelui, a ploii etc. 2. Nuia încovoiată. ◊ Fiecare dintre sârmele care alcătuiesc scheletul umbrelei. [Var.: covercă s. f.]","s":"DEX '98"},"covăseală":{"c":"substantiv feminin","t":"(Pop.) Lapte prins sau covăsit, întrebuințat drept cuib pentru fermentarea laptelui dulce. - Covăsi + suf. -eală.","s":"DEX '98"},"covată":{"c":"substantiv feminin","t":"(Reg.) 1. Albie (1). 2. Ladă de scânduri în care curge făina la moară în timpul măcinatului. 3. Vas în care se încarcă materialul dezagregat în unele mine metalifere.","s":"DEX '98"},"covrigar":{"c":"substantiv masculin","t":"Persoană care face sau vinde covrigi. - Covrig + suf. -ar.","s":"DEX '98"},"covrigărie":{"c":"substantiv feminin","t":"Loc unde se fac și se vând covrigi. - Covrig + suf. -ărie.","s":"DEX '98"},"covăsneancă":{"c":"substantiv feminin","t":"Femeie născută și crescută în municipiul sau județul Covasna. ◊ Locuitoare din municipiul sau județul Covasna. - Covăsnean + suf. -că.","s":"DEX '98"},"covalent":{"c":"adjectiv","t":"(Despre elemente chimice) Care prezintă covalență.","s":"DEX '98"},"covârșitor":{"c":"adjectiv","t":"Care covârșește; copleșitor; p. ext. foarte mare, dominant, extraordinar. - Covârși + suf. -tor.","s":"DEX '98"},"covăsnean":{"c":"substantiv masculin","t":"adj. 1. S. m. Persoană născută și crescută în municipiul sau județul Covasna. 2. Adj., s. m. (Locuitor) din municipiul sau județul Covasna. - Covasna (n. pr.) + suf. -ean.","s":"DEX '98"},"covercot":{"c":"substantiv neutru","t":"Stofă fină de lână, cu țesătura deasă, folosită la confecționarea pardesielor, hainelor, taioarelor etc.","s":"DEX '98"},"coviltir":{"c":"substantiv neutru","t":"Acoperiș la căruță făcut dintr-un schelet de nuiele curbate peste care se întind rogojini sau pânză groasă.","s":"DEX '98"},"covor":{"c":"substantiv neutru","t":"Țesătură groasă de lână, de bumbac etc. (cu figuri și desene de diferite culori), folosită pentru împodobirea încăperilor.","s":"DEX '98"},"covoraș":{"c":"substantiv neutru","t":"Diminutiv al lui covor. - Covor + suf. -aș.","s":"DEX '98"},"covali":{"c":"substantiv masculin","t":"(Reg.) Fierar.","s":"DEX '98"},"covrig":{"c":"substantiv masculin","t":"Produs alimentar în formă de inel, de opt etc., preparat din făină de grâu (și presărat cu sare, susan, mac etc.). ♦ Expr. A se face covrig = a se încovriga, a se încolăci. A scoate (sau a ajunge, a ieși) la covrigi = a face să devină (sau a deveni) foarte sărac.","s":"DEX '98"},"covaci":{"c":"substantiv masculin","t":"(Reg.) Fierar.","s":"DEX '98"},"covăsit":{"c":"adjectiv","t":"n. (În sintagma) Lapte covăsit = lapte închegat și înăcrit cu ajutorul unui cuib de smântână sau de covăseală. - V. covăsi.","s":"DEX '98"},"covelină":{"c":"substantiv feminin","t":"Sulfură naturală de cupru, metalică, moale, de culoare albastră-violet, frecventă în zonele de alterare a zăcămintelor cuprifere.","s":"DEX '98"},"covarianță":{"c":"substantiv feminin","t":"Covariație. [Pr.: -ri-an-]","s":"DEX '98"},"covrigel":{"c":"substantiv masculin","t":"Diminutiv al lui covrig. - Covrig + suf. -el.","s":"DEX '98"},"covru":{"c":"substantiv neutru","t":"(Reg.) Vizuină, bârlog, cotlon.","s":"DEX '98"}},"F":{"coviț":["coviț","covița"],"covățele":["covățică"],"covățelei":["covățică"],"covățelele":["covățică"],"covățelelor":["covățică"],"covariații":["covariație"],"covariația":["covariație"],"covariației":["covariație"],"covariațiile":["covariație"],"covariațiilor":["covariație"],"covăcii":["covăcie"],"covăcia":["covăcie"],"covăciei":["covăcie"],"covăciile":["covăcie"],"covăciilor":["covăcie"],"covălii":["covălie"],"covălia":["covălie"],"covăliei":["covălie"],"covăliile":["covălie"],"covăliilor":["covălie"],"covițare":["covița"],"covăsire":["covăsi"],"covârșire":["covârși"],"covițăire":["covițăi"],"covrigire":["covrigi"],"covalențe":["covalență"],"covalența":["covalență"],"covalenței":["covalență"],"covalențele":["covalență"],"covalențelor":["covalență"],"coverte":["covertă"],"coverta":["covertă"],"covertei":["covertă"],"covertele":["covertă"],"covertelor":["covertă"],"covățica":["covățică"],"coverci":["covercă"],"coverca":["covercă"],"covercii":["covercă"],"covercile":["covercă"],"covercilor":["covercă"],"cov