{"L":{"inovare":{"c":"substantiv feminin","t":"Acțiunea de a inova și rezultatul ei; înnoire, inovație. - V. inova.","s":"DEX '98"},"inova":{"c":"verb","t":"Intranz. A face o schimbare, a introduce o noutate într-un domeniu, într-un sistem etc.; a înnoi. ◊ A introduce, a adopta, a propaga o inovație.","s":"DEX '98"},"înotare":{"c":"substantiv feminin","t":"Acțiunea de a înota; înotat. - V. înota.","s":"DEX '98"},"înota":{"c":"verb","t":"Intranz. 1. A se mișca ritmic pentru a pluti și a înainta la suprafața apei sau în apă. ◊ A pluti. 2. A fi cufundat într-un lichid; a fi înconjurat din toate părțile de un lichid. ◊ Fig. A fi copleșit, apăsat de ceva. ◊ Fig. A înainta cu greu (prin noroi, prin zăpadă etc.). ◊ Fig. A avea ceva din abundență.","s":"DEX '98"},"înovare":{"c":"substantiv feminin","t":"Acțiunea de a inova și rezultatul ei; înnoire, inovație. - V. inova.","s":"DEX '98"},"inovațiune":{"c":"substantiv feminin","t":"Noutate, schimbare, prefacere. ◊ Rezolvare a unei probleme de tehnică sau de organizare a muncii cu scopul îmbunătățirii (productivității) muncii, perfecționării tehnice sau raționalizării soluțiilor aplicate. [Var.: (înv.) inovațiune s. f.]","s":"DEX '98"},"înotător":{"c":"adjectiv","t":"subst. 1. Adj., s. m. și f. (Persoană, ființă) care înoată, care știe să înoate. 2. S. f. Aripioară a peștelui sau a altor animale acvatice, care servește ca organ de propulsie și de stabilitate; aripă. - Înota + suf. -ător.","s":"DEX '98"},"înotătoare":{"c":"adjectiv","t":"subst. 1. Adj., s. m. și f. (Persoană, ființă) care înoată, care știe să înoate. 2. S. f. Aripioară a peștelui sau a altor animale acvatice, care servește ca organ de propulsie și de stabilitate; aripă. - Înota + suf. -ător.","s":"DEX '98"},"inocență":{"c":"substantiv feminin","t":"Curățenie sufletească, nevinovăție; candoare. ◊ (Ir.) Naivitate, simplitate; ignoranță.","s":"DEX '98"},"înova":{"c":"verb","t":"Intranz. A face o schimbare, a introduce o noutate într-un domeniu, într-un sistem etc.; a înnoi. ◊ A introduce, a adopta, a propaga o inovație.","s":"DEX '98"},"inodor":{"c":"adjectiv","t":"Care nu emană miros; fără miros.","s":"DEX '98"},"inodora":{"c":"substantiv feminin","t":"(Bot.; regional) Mușețel. [Var.: romăniță s. f.]","s":"DEX '98"},"inoculare":{"c":"substantiv feminin","t":"Acțiunea de a inocula și rezultatul ei; inoculație. - V. inocula.","s":"DEX '98"},"inocula":{"c":"verb","t":"Tranz. 1. A introduce în organism o substanță, un ser, un vaccin pentru precizarea diagnosticului unei boli, experiențe, imunizare etc. 2. Fig. A băga în mintea cuiva anumite concepții, idei etc. [Var.: înocula, vb. I]","s":"DEX '98"},"inopinat":{"c":"adjectiv","t":"La care nu te gândești; neprevăzut, neașteptat.","s":"DEX '98"},"inovator":{"c":"substantiv masculin și feminin","t":"adj. (Persoană) care realizează o inovație; (persoană) care inovează ceva.","s":"DEX '98"},"inovatoare":{"c":"substantiv masculin și feminin","t":"adj. (Persoană) care realizează o inovație; (persoană) care inovează ceva.","s":"DEX '98"},"inocent":{"c":"adjectiv","t":"Curat la suflet, căruia nu i se poate imputa nimic; care exprimă nevinovăție; candid. ◊ (Ir.) Naiv, simplu; ignorant.","s":"DEX '98"},"inoculabil":{"c":"adjectiv","t":"Care se poate inocula.","s":"DEX '98"},"inombrabil":{"c":"adjectiv","t":"(Rar) Care nu poate fi numărat; nenumărat.","s":"DEX '98"},"inorog":{"c":"substantiv masculin","t":"Animal fabulos imaginat sub forma unui cal cu un corn în frunte, întâlnit mai ales în arta și literatura medievală; licorn. ◊ (Rar) Rinocer. [Var.: inoroh s. m.]","s":"DEX '98"},"inoroh":{"c":"substantiv masculin","t":"Animal fabulos imaginat sub forma unui cal cu un corn în frunte, întâlnit mai ales în arta și literatura medievală; licorn. ◊ (Rar) Rinocer. [Var.: inoroh s. m.]","s":"DEX '98"},"înot":{"c":"substantiv neutru","t":"Plutire și înaintare (a unor ființe) la suprafața sau în interiorul apei, deplasare în apă prin mișcări ritmice. ♦ Loc. adv. De-a înotul = înotând. ◊ (Adverbial) Înotând.","s":"DEX '98"},"inoculat":{"c":"adjectiv","t":"(Despre seruri, substanțe, vaccinuri) Introdus în organism. - V. inocula.","s":"DEX '98"},"inoculație":{"c":"substantiv feminin","t":"Inoculare.","s":"DEX '98"},"înoculat":{"c":"verb","t":"I v. inocula.","s":"DEX '98"},"înocula":{"c":"verb","t":"Tranz. 1. A introduce în organism o substanță, un ser, un vaccin pentru precizarea diagnosticului unei boli, experiențe, imunizare etc. 2. Fig. A băga în mintea cuiva anumite concepții, idei etc. [Var.: înocula, vb. I]","s":"DEX '98"},"înoculare":{"c":"verb","t":"I v. inocula.","s":"DEX '98"},"inoportuna":{"c":"verb","t":"Tranz. și intranz. (Fam.) A importuna.","s":"DEX '98"},"înotat":{"c":"substantiv neutru","t":"(Înv.) Înotare. - V. înota.","s":"DEX '98"},"inofensivitate":{"c":"substantiv feminin","t":"(Rar) Însușirea de a fi inofensiv. - Inofensiv + suf. -itate.","s":"DEX '98"},"inoportun":{"c":"adjectiv","t":"Care nu este sau nu se întâmplă la timpul oportun; nepotrivit, neoportun. ◊ (Despre oameni) Care incomodează; neplăcut; plictisitor.","s":"DEX '98"},"inobservabil":{"c":"adjectiv","t":"Care nu poate fi observat (decât cu greu); neobservabil.","s":"DEX '98"},"inocuitate":{"c":"substantiv feminin","t":"(Med.) Însușire a unui agent fizic, chimic, biologic de a nu constitui un pericol pentru organism. [Pr.: -cu-i-]","s":"DEX '98"},"inofensiv":{"c":"adjectiv","t":"Care nu face rău; nevătămător, neofensiv.","s":"DEX '98"},"inoperant":{"c":"adjectiv","t":"Lipsit de efect sau de rezultat; fără urmare, neoperant.","s":"DEX '98"},"inoportunitate":{"c":"substantiv feminin","t":"Faptul de a fi inoportun; neoportunitate.","s":"DEX '98"},"inopozabil":{"c":"adjectiv","t":"(Despre un act juridic) Care nu poate fi invocat față de alte persoane și în alte cazuri decât cele determinate de lege; neopozabil.","s":"DEX '98"},"inospitalier":{"c":"adjectiv","t":"Care nu este ospitalier; neospitalier, neprimitor, rece. [Pr.: -li-er]","s":"DEX '98"},"inovație":{"c":"substantiv femini