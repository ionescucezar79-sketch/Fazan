{"L":{"odrăsli":{"c":"verb","t":"Intranz. 1. A se naște, a se ivi; a crește, a se dezvolta. 2. (Înv. și pop.; despre plante; la pers. 3) A da mlădițe, a lăstări; p. ext. a înmuguri, a înverzi.","s":"DEX '98"},"odrăslit":{"c":"adjectiv","t":"1. Născut, zămislit, ivit; crescut, dezvoltat. 2. (Înv. și pop.; despre plante) Care a dat lăstari; p. ext. înmugurit, înverzit. - V. odrăsli.","s":"DEX '98"},"odraslă":{"c":"substantiv feminin","t":"1. Copil, descendent, urmaș; progenitură. ◊ (La animale) Pui, prăsilă. 2. (Înv. și pop.) Ramură tânără, lăstar, mlădiță, vlăstar.","s":"DEX '98"},"odrasle":{"c":"substantiv feminin","t":"1. Copil, descendent, urmaș; progenitură. ◊ (La animale) Pui, prăsilă. 2. (Înv. și pop.) Ramură tânără, lăstar, mlădiță, vlăstar.","s":"DEX '98"},"odrăslire":{"c":"substantiv feminin","t":"Faptul de a odrăsli. - V. odrăsli.","s":"DEX '98"},"odrăslitor":{"c":"adjectiv","t":"(Înv.) Care dă lăstari, care odrăslește. - Odrăsli + suf. -tor.","s":"DEX '98"},"odrăsluță":{"c":"substantiv feminin","t":"Diminutiv al lui odraslă. - Odraslă + suf. -uță.","s":"DEX '98"}},"F":{"odrăslit":["odrăslit","odrăsli"],"odrăsliți":["odrăsli","odrăslit"],"odrăslitul":["odrăslit"],"odrăslitului":["odrăslit"],"odrăsliții":["odrăslit"],"odrăsliților":["odrăslit"],"odrăslită":["odrăslit"],"odrăslite":["odrăslit"],"odrăslita":["odrăslit"],"odrăslitei":["odrăslit"],"odrăslitele":["odrăslit"],"odrăslitelor":["odrăslit"],"odrăslitu":["odrăsli","odrăslit"],"odrasle":["odrasle","odraslă"],"odrasla":["odraslă"],"odraslei":["odraslă"],"odraslele":["odraslă"],"odraslelor":["odraslă"],"odrăslire":["odrăslire","odrăsli"],"odrăslește":["odrăsli"],"odrăslind":["odrăsli"],"odrăslesc":["odrăsli"],"odrăslești":["odrăsli"],"odrăslim":["odrăsli"],"odrăslească":["odrăsli"],"odrăsleam":["odrăsli"],"odrăsleai":["odrăsli"],"odrăslea":["odrăsli"],"odrăsleați":["odrăsli"],"odrăsleau":["odrăsli"],"odrăslii":["odrăsli"],"odrăsliși":["odrăsli"],"odrăslirăm":["odrăsli"],"odrăslirăți":["odrăsli"],"odrăslir