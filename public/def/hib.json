{"L":{"hibernare":{"c":"substantiv feminin","t":"Acțiunea de a hiberna și rezultatul ei; stare de amorțeală, de viață latentă (asemănătoare cu somnul), în care petrec unele animale iarna, când metabolismul este încetinit și temperatura corpului scăzută; hibernație. ♦ Hibernare artificială = hibernoterapie. - V. hiberna.","s":"DEX '96"},"hiberna":{"c":"verb","t":"Intranz. (Despre unele animale; adesea fig.) A petrece iarna în hibernare.","s":"DEX '96"},"hibă":{"c":"substantiv feminin","t":"(Reg.) Defect, cusur.","s":"DEX '96"},"hibrid":{"c":"substantiv masculin","t":"adj. 1. S. m., adj. (Organism) provenit din încrucișarea a doi indivizi de specii, de soiuri, de genuri sau de rase diferite. 2. Adj. Fig. (Despre realizări, idei, fapte) Alcătuit din elemente disparate; lipsit de armonie.","s":"DEX '96"},"hibridă":{"c":"substantiv masculin","t":"adj. 1. S. m., adj. (Organism) provenit din încrucișarea a doi indivizi de specii, de soiuri, de genuri sau de rase diferite. 2. Adj. Fig. (Despre realizări, idei, fapte) Alcătuit din elemente disparate; lipsit de armonie.","s":"DEX '96"},"hibrida":{"c":"verb","t":"Tranz. A obține un hibrid prin procesul de hibridare; a încrucișa prin hibridare două plante, două specii etc.; a hibridiza.","s":"DEX '96"},"hibernacul":{"c":"substantiv masculin","t":"(Bot.) Mugure metamorfozat și caduc, care constituie partea de rezistență în timpul iernii a unor plante acvatice.","s":"DEX '96"},"hibernal":{"c":"adjectiv","t":"(Rar) De iarnă.","s":"DEX '96"},"hibridat":{"c":"verb","t":"Tranz. A obține un hibrid prin procesul de hibridare; a încrucișa prin hibridare două plante, două specii etc.; a hibridiza.","s":"DEX '96"},"hibridație":{"c":"substantiv feminin","t":"(Rar) Hibridare.","s":"DEX '96"},"hibridiza":{"c":"verb","t":"Tranz. A hibrida.","s":"DEX '96"},"hibridizat":{"c":"verb","t":"Tranz. A hibrida.","s":"DEX '96"},"hibernoterapie":{"c":"substantiv feminin","t":"Stare de hibernare realizată pe cale artificială în scop terapeutic sau în unele intervenții chirurgicale.","s":"DEX '96"},"hibiscus":{"c":"substantiv masculin","t":"Arbore tropical din familia malvaceelor.","s":"DEX '96"},"hibernație":{"c":"substantiv feminin","t":"Hibernare.","s":"DEX '96"},"hibridare":{"c":"substantiv feminin","t":"Acțiunea de a hibrida și rezultatul ei; proces, spontan sau provocat artificial, de încrucișare sexuată sau vegetativă între doi indivizi de specii, de soiuri sau de rase diferite; hibridizare; hibridație. - V. hibrida.","s":"DEX '96"},"hibriditate":{"c":"substantiv feminin","t":"Însușirea de a fi hibrid, caracterul a tot ceea ce este hibrid.","s":"DEX '96"},"hibridizare":{"c":"substantiv feminin","t":"Acțiunea de a hibridiza și rezultatul ei; hibridare. - V. hibridiza. Cf. rus. ghibridizațiia.","s":"DEX '96"}},"F":{"hibernare":["hibernare","hiberna"],"hibernări":["hibernare"],"hibernarea":["hibernare"],"hibernării":["hibernare"],"hibernările":["hibernare"],"hibernărilor":["hibernare"],"hibe":["hibă"],"hiba":["hibă"],"hibei":["hibă"],"hibele":["hibă"],"hibelor":["hibă"],"hibridă":["hibridă","hibrid","hibrida"],"hibride":["hibrid","hibridă"],"hibrida":["hibrida","hibrid","hibridă"],"hibridei":["hibrid","hibridă"],"hibridele":["hibrid","hibridă"],"hibridelor":["hibrid","hibridă"],"hibernat":["hiberna"],"hibernaculi":["hibernacul"],"hibernaculul":["hibernacul"],"hibernaculului":["hibernacul"],"hibernaculii":["hibernacul"],"hibernaculilor":["hibernacul"],"hibernali":["hibernal"],"hibernalul":["hibernal"],"hibernalului":["hibernal"],"hibernalii":["hibernal"],"hibernalilor":["hibernal"],"hibernală":["hibernal"],"hibernale":["hibernal"],"hibernala":["hibernal"],"hibernalei":["hibernal"],"hibernalele":["hibernal"],"hibernalelor":["hibernal"],"hibridat":["hibridat","hibrida"],"hibridați":["hibrida","hibridat"],"hibridații":["hibridat","hibridație"],"hibridatu":["hibrida","hibridat"],"hibridizat":["hibridizat","hibridiza"],"hibridizați":["hibridiza","hibridizat"],"hibridizatu":["hibridiza","hibridizat"],"hibernează":["hib