{"L":{"lalea":{"c":"substantiv feminin","t":"Plantă erbacee din familia liliaceelor, cu bulb alungit, ascuțit la vârf, cu frunze lanceolate, groase și late, cu tulpina înaltă, care face o singură floare mare, de diverse culori; tulipă (Tulipa gesneriana)","s":"DEX '98"},"lălăi":{"c":"verb","t":"Tranz. (Fam.) A cânta (monoton, la nesfârșit) o melodie, înlocuind de obicei cuvintele cu silaba \"la\" (repetat).","s":"DEX '98"},"lălăire":{"c":"substantiv feminin","t":"(Fam.) Acțiunea de a lălăi și rezultatul ei. - V. lălăi.","s":"DEX '98"},"lălâu":{"c":"adjectiv","t":"Care are mișcări greoaie, leneșe, lipsite de grație; p. ext. care este neglijent, neîngrijit, rău (și murdar) îmbrăcat.","s":"DEX '98"},"lălăit":{"c":"substantiv neutru","t":"(Fam.) Faptul de a lălăi. - V. lălăi.","s":"DEX '98"}},"F":{"lalele":["lalea"],"laleaua":["lalea"],"lalelei":["lalea"],"lalelele":["lalea"],"lalelelor":["lalea"],"lălăire":["lălăire","lălăi"],"lălăiri":["lălăire"],"lălăirea":["lălăire"],"lălăirii":["lălăire"],"lălăirile":["lălăire"],"lălăirilor":["lălăire"],"lălâi":["lălâu"],"lălâul":["lălâu"],"lălâului":["lălâu"],"lălâii":["lălâu"],"lălâilor":["lălâu"],"lălâie":["lălâu"],"lălâia":["lălâu"],"lălâiei":["lălâu"],"lălâiele":["lălâu"],"lălâielor":["lălâu"],"lălăie":["lălăi"],"lălăit":["lălăit","lălăi"],"lălăind":["lălăi"],"lălăim":["lălăi"],"lălăiți":["lălăi"],"lălăiam":["lălăi"],"lălăiai":["lălăi"],"lălăia":["lălăi"],"lălăiați":["lălăi"],"lălăiau":["lălăi"],"lălăii":["lălăi"],"lălăiși":["lălăi"],"lălăirăm":["lălăi"],"lălăirăți":["lălăi"],"lălăiră":["lălăi"],"lălăisem":["lălăi"],"lălăiseși":["lălăi"],"lălăise":["lălăi"],"lălăiserăm":["lălăi"],"lălăiserăți":["lălăi"],"lălăiseți":["lălăi"],"lălăiseră":["lălăi"],"lălăitu":["lălăi","lălăit"],"lălăindu":["lălăi"],"lălăiește":["lălăi"],"lălăiesc":["lălăi"],"lălăiești":["lălăi"],"lălăiască":["lălăi"],"lălăitul":["lălăit"],"lălăitului":["lălăit"],"lălăituri":["lălăit"],"lălăiturile":["lălăit"],"lălăiturilor":["lălăit"]}}