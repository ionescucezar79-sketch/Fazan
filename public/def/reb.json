{"L":{"rebel":{"c":"adjectiv","t":"(Despre oameni; adesea substantivat) Care ia parte activă la o rebeliune, care îndeamnă la rebeliune; răzvrătit. ◊ Nesupus, recalcitrant. ◊ Care arată nesupunere, care exprimă revoltă. ◊ Fig. (Despre păr) Care nu se așază, nu stă pieptănat. ◊ Fig. (Despre boli) Care are aspect acut, care cedează greu la tratamentul medical, care se vindecă greu.","s":"DEX '98"},"rebandaja":{"c":"verb","t":"Tranz. A înlocui bandajele roților unui vehicul feroviar. - Re- + bandaja.","s":"DEX '98"},"rebandajare":{"c":"substantiv feminin","t":"Acțiunea de a rebandaja și rezultatul ei. - V. rebandaja.","s":"DEX '98"},"rebobina":{"c":"verb","t":"Tranz. A bobina din nou, a reface bobinajul unei mașini electrice.","s":"DEX '98"},"rebobinare":{"c":"substantiv feminin","t":"Acțiunea de a rebobina și rezultatul ei. - V. rebobina.","s":"DEX '98"},"reboteza":{"c":"verb","t":"Tranz. și refl. A (se) boteza încă o dată (într-o altă religie sau cu alt nume). - Re- + boteza (după fr. rebaptiser).","s":"DEX '98"},"rebotezare":{"c":"substantiv feminin","t":"Acțiunea de a (se) reboteza. - V. reboteza.","s":"DEX '98"},"rebuta":{"c":"verb","t":"Tranz. A da, a trece (ceva) la rebut; a respinge un produs ca necorespunzător.","s":"DEX '98"},"rebutare":{"c":"substantiv feminin","t":"Acțiunea de a rebuta și rezultatul ei; operație de stabilire a rebuturilor. - V. rebuta.","s":"DEX '98"},"rebatere":{"c":"substantiv feminin","t":"Acțiunea de a rebate. - V. rebate.","s":"DEX '98"},"rebate":{"c":"verb","t":"Tranz. și refl. A bate din nou la mașină un text corectat, amplificat etc. - Re- + bate.","s":"DEX '98"},"rebegi":{"c":"verb","t":"Intranz. A amorți, a îngheța de frig; a se zgribuli de frig. ◊ Refl. A slăbi, a arăta rău.","s":"DEX '98"},"rebab":{"c":"substantiv neutru","t":"Instrument muzical cu două coarde, asemănător viorii, folosit de algerieni, tunisieni și marocani.","s":"DEX '98"},"rebarbativ":{"c":"adjectiv","t":"Cu aspect respingător, aspru, urât. ♦ Cuvânt rebarbativ = cuvânt neintegrabil într-o limbă. ◊ Care se împotrivește la ceva; refractar.","s":"DEX '98"},"rebec":{"c":"substantiv neutru","t":"Vechi instrument muzical în formă de lăută cu trei coarde, folosit de menestrelii medievali și introdus în Europa de arabi.","s":"DEX '98"},"rebegit":{"c":"adjectiv","t":"1. Pătruns de frig, înghețat. 2. Stors de puteri, istovit, vlăguit. [Var.: (reg.) răbegit, -ă adj.] - V. rebegi.","s":"DEX '98"},"rebord":{"c":"substantiv neutru","t":"(Tehn.) Margine proeminentă, ieșită în afară.","s":"DEX '98"},"rebus":{"c":"substantiv neutru","t":"Joc în care un cuvânt sau o frază sunt reprezentate printr-o combinație de figuri, litere sau semne pe baza cărora urmează să găsești cuvântul sau fraza dată. ◊ Fig. Enigmă, șaradă.","s":"DEX '98"},"rebusistic":{"c":"adjectiv","t":"De rebus; (rar) rebusist (2). - Rebusist + suf. -ic.","s":"DEX '98"},"rebut":{"c":"substantiv neutru","t":"Produs care nu corespunde condițiilor calitative stabilite prin standarde, norme interne, contracte etc. și care nu poate fi utilizat direct în scopul pentru care a fost realizat, reprezentând o pierdere economică. ♦ Rebut recuperabil = rebut care, printr-o remaniere, poate fi adus la calitatea stabilită.","s":"DEX '98"},"rebandajat":{"c":"verb","t":"Tranz. A înlocui bandajele roților unui vehicul feroviar. - Re- + bandaja.","s":"DEX '98"},"rebătut":{"c":"adjectiv","t":"(Despre texte) Care a fost bătut la mașină din nou (pentru corecturi, adăugiri etc.). - V. rebate.","s":"DEX '98"},"rebobinat":{"c":"verb","t":"Tranz. A bobina din nou, a reface bobinajul unei mașini electrice.","s":"DEX '98"},"rebotezat":{"c":"adjectiv","t":"Care a fost botezat încă o dată (într-o altă religie sau cu alt nume). - V. reboteza.","s":"DEX '98"},"rebutat":{"c":"adjectiv","t":"Care este dat la rebut. - V. rebuta.","s":"DEX '98"},"rebegeală":{"c":"substantiv feminin","t":"Faptul de a (se) rebegi; starea celui rebegit. - Rebegi + suf. -eală.","s":"DEX '98"},"rebo":{"c":"substantiv neutru","t":"Joc asemănător monoverbelor ilustrate, dar în care se folosesc numai desene. [Acc. și: rebo]","s":"DEX '98"},"rebrusment":{"c":"substantiv neutru","t":"Schimbare a direcției și a sensului de mișcare a unui tren prin întoarcerea locomotivei și legarea ei la capătul opus al șirului de vagoane.","s":"DEX '98"},"rebusist":{"c":"substantiv masculin și feminin","t":"adj. 1. S. m. și f. Persoană care creează sau rezolvă probleme de rebus. 2. Adj. (Rar) Rebusistic. - Rebus + suf. -ist.","s":"DEX '98"},"rebusistă":{"c":"substantiv masculin și feminin","t":"adj. 1. S. m. și f. Persoană care creează sau rezolvă probleme de rebus. 2. Adj. (Rar) Rebusistic. - Rebus + suf. -ist.","s":"DEX '98"},"rebeliune":{"c":"substantiv feminin","t":"Act de violență sau de amenințare gravă săvârșit față de un organ de stat sau de un reprezentant al lui, în scopul de a împiedica îndeplinirea atribuțiilor sale; p. ext. răzvrătire, revoltă. [Pr.: -li-u-]","s":"DEX '98"}},"F":{"rebelii":["rebel"],"rebandajare":["rebandajare","rebandaja"],"rebandajări":["rebandajare"],"rebandajarea":["rebandajare"],"rebandajării":["rebandajare"],"rebandajările":["rebandajare"],"rebandajărilor":["rebandajare"],"rebobinare":["rebobinare","rebobina"],"rebobinări":["rebobinare"],"rebobinarea":["rebobinare"],"rebobinării":["rebobinare"],"rebobinările":["rebobinare"],"rebobinărilor":["rebobinare"],"rebotezare":["rebotezare","reboteza"],"rebotezări":["rebotezare"],"rebotezarea":["rebotezare"],"rebotezării":["rebotezare"],"rebotezările":["rebotezare"],"rebotezărilor":["rebotezare"],"rebutare":["rebutare","rebuta"],"rebutări":["rebutare"],"rebutarea":["rebutare"],"rebutării":["rebutare"],"rebutările":["rebutare"],"rebutărilor":["rebutare"],"rebatere":["rebatere","rebate"],"rebateri":["rebatere"],"rebaterea":["rebatere"],"rebaterii":["rebatere"],"rebaterile":["rebatere"],"rebaterilor":["rebatere"],"rebegire":["rebegi"],"rebegii":["rebegi"],"rebaburi":["rebab"],"rebabul":["rebab"],"rebabului":["rebab"],"rebaburile":["rebab"],"r