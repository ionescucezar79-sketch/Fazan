{"L":{"nefralgie":{"c":"substantiv feminin","t":"(Med.) Durere de rinichi.","s":"DEX '98"},"nefrografie":{"c":"substantiv feminin","t":"(Med.) Radiografie a rinichiului făcută cu ajutorul unei substanțe de contrast.","s":"DEX '98"},"nefrolitotomie":{"c":"substantiv feminin","t":"(Med.) Extragere chirurgicală a unui calcul renal.","s":"DEX '98"},"nefericire":{"c":"substantiv feminin","t":"Starea, situația celui nefericit; nenorocire; întâmplare, împrejurare care aduce cuiva suferință, necaz, nenorocire. ♦ Loc. adv. Din nefericire = din nenorocire, din păcate. - Ne- + fericire.","s":"DEX '98"},"neferici":{"c":"verb","t":"Tranz. (Rar) A aduce cuiva nefericire.","s":"DEX '98"},"nefroptoză":{"c":"substantiv feminin","t":"(Med.) Boală caracterizată prin deplasarea rinichiului.","s":"DEX '98"},"nefârtat":{"c":"substantiv masculin","t":"(Reg.) Dușman, neprieten. ◊ (Art.) Diavolul. - Ne- + fârtat.","s":"DEX '98"},"nefropat":{"c":"adjectiv","t":"s. m. și f. (Med.) (Bolnav) de rinichi.","s":"DEX '98"},"nefropată":{"c":"adjectiv","t":"s. m. și f. (Med.) (Bolnav) de rinichi.","s":"DEX '98"},"nefer":{"c":"substantiv masculin","t":"1. Soldat din vechea armată turcă. 2. Soldat pământean din corpul arnăuților; soldat care făcea parte dintr-o poteră, poteraș.","s":"DEX '98"},"nefericit":{"c":"adjectiv","t":"(Adesea substantivat) Care nu este fericit, care îndură suferințe (morale); cuprins de durere; nenorocit. ◊ Nefast. Zi nefericită. ◊ Care este într-o stare proastă, neprielnică, care provoacă neplăceri. Climă nefericită. - Ne- + fericit.","s":"DEX '98"},"neființă":{"c":"substantiv feminin","t":"1. (Poetic) Faptul de a nu exista, de a nu fi; inexistență; stare a ceea ce nu există; p. ext. neant. 2. (Înv.) Absență, lipsă dintr-un anumit loc (a unei persoane). - Ne- + ființă.","s":"DEX '98"},"nefretic":{"c":"adjectiv","t":"s. m. și f. 1. Adj. (Despre boli) Care este localizat la rinichi; renal. ◊ Care este folosit în bolile de rinichi. 2. S. m. și f., adj. (Persoană) care suferă de nefrită.","s":"DEX '98"},"nefretică":{"c":"adjectiv","t":"s. m. și f. 1. Adj. (Despre boli) Care este localizat la rinichi; renal. ◊ Care este folosit în bolile de rinichi. 2. S. m. și f., adj. (Persoană) care suferă de nefrită.","s":"DEX '98"},"nefăcut":{"c":"adjectiv","t":"Care nu a fost făcut, creat, săvârșit. - Ne- + făcut.","s":"DEX '98"},"nefrologie":{"c":"substantiv feminin","t":"Ramură a medicinei care se ocupă cu studiul rinichiului.","s":"DEX '98"},"nefalsificat":{"c":"adjectiv","t":"Care nu este falsificat. - Ne- + falsificat.","s":"DEX '98"},"nefamilist":{"c":"adjectiv","t":"Care nu este căsătorit, care nu și-a întemeiat o familie. - Ne- + familist.","s":"DEX '98"},"nefast":{"c":"adjectiv","t":"Care aduce nenorocire, necaz, supărare; dăunător, fatal.","s":"DEX '98"},"nefățărit":{"c":"adjectiv","t":"(Înv.) Lipsit de prefăcătorie; sincer, deschis; obiectiv, drept. - Ne- + fățărit.","s":"DEX '98"},"nefavorabil":{"c":"adjectiv","t":"Care nu este favorabil; care este în dezavantajul, în defavoarea cuiva sau a ceva; spec. (despre vreme) caracterizat prin condiții neprielnice (de temperatură, umiditate etc.). - Ne- + favorabil.","s":"DEX '98"},"neferos":{"c":"adjectiv","t":"Care nu conține fier. ◊ Care prelucrează materiale ce nu conțin fier. Industrie neferoasă. - Ne- + feros.","s":"DEX '98"},"nefertil":{"c":"adjectiv","t":"Lipsit de fertilitate. - Ne- + fertil.","s":"DEX '98"},"nefertilizat":{"c":"adjectiv","t":"(Agric.; despre sol) Căruia nu i s-a mărit fertilitatea (prin îngrășăminte, irigații etc.). - Ne- + fertilizat.","s":"DEX '98"},"nefidel":{"c":"adjectiv","t":"1. (Despre oameni) Care nu este fidel; nestatornic, necredincios în sentimente, în angajamente; infidel (1); (despre soți) care întreține relații extraconjugale; infidel (1). 2. Care nu exprimă sau nu respectă adevărul, realitatea; inexact, infidel (2). - Ne- + fidel.","s":"DEX '98"},"nefiert":{"c":"adjectiv","t":"Care nu este (destul de) fiert; încă crud. - Ne- + fiert.","s":"DEX '98"},"nefiresc":{"c":"adjectiv","t":"(Adesea adverbial) Care nu e în firea lucrurilor, care nu e normal, natural; anormal. - Ne- + firesc.","s":"DEX '98"},"nefolosit":{"c":"adjectiv","t":"Care nu este folosit, întrebuințat; care nu este degradat, deteriorat (prin folosire îndelungată); neîntrebuințat, neuzat. - Ne- + folosit.","s":"DEX '98"},"nefolositor":{"c":"adjectiv","t":"Care nu este folositor, care nu folosește la nimic; inutil. - Ne- + folositor.","s":"DEX '98"},"nefondat":{"c":"adjectiv","t":"Care nu este bazat, întemeiat pe ceva. [Var.: nefondat, -ă adj.] - Ne- + fundat.","s":"DEX '98"},"nefrologic":{"c":"adjectiv","t":"(Med.) De nefrologie.","s":"DEX '98"},"nefrosclerotic":{"c":"adjectiv","t":"(Med.) Care se referă la nefroscleroză.","s":"DEX '98"},"nefrotic":{"c":"adjectiv","t":"(Med.) De natura nefrozei.","s":"DEX '98"},"nefructuos":{"c":"adjectiv","t":"Care nu dă rezultatele așteptate, care nu dă roade; zadarnic, inutil, infructuos. [Pr.: -tu-os] - Ne- + fructuos.","s":"DEX '98"},"nefundat":{"c":"adjectiv","t":"Care nu este bazat, întemeiat pe ceva. [Var.: nefondat, -ă adj.] - Ne- + fundat.","s":"DEX '98"},"nefalism":{"c":"substantiv neutru","t":"(Livr.) Abstinență totală de la orice băutură alcoolică.","s":"DEX '98"},"nefalist":{"c":"adjectiv","t":"s. m. și f. (Livr.) (Adept) al nefalismului.","s":"DEX '98"},"nefalistă":{"c":"adjectiv","t":"s. m. și f. (Livr.) (Adept) al nefalismului.","s":"DEX '98"},"nefelomanție":{"c":"substantiv feminin","t":"(Livr.) Ghicitul viitorului prin observarea norilor.","s":"DEX '98"},"neflexibilitate":{"c":"substantiv feminin","t":"Însușirea a ceea ce este neflexibil; inflexibilitate. ◊ Fig. Fermitate, tărie, intransigență. - Ne- + flexibilitate.","s":"DEX '98"},"nefron":{"c":"substantiv neutru","t":"(Med.) Unitate morfologică și funcțională a rinichiului.","s":"DEX '98"},"nefinalizat":{"c":"adjectiv","t":"Care nu este realizat până la sfârșit; neterminat. - Ne- + finalizat.","s":"DEX '98"},"nefelometrie":{"c":"substantiv feminin","t":"