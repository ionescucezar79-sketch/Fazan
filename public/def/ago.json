{"L":{"agonie":{"c":"substantiv feminin","t":"Stare a organismului care precede moartea. ♦ Loc. adj. În agonie = pe moarte; muribund. ◊ Fig. Neliniște puternică, zbucium, zbatere.","s":"DEX '98"},"agonisire":{"c":"substantiv feminin","t":"Acțiunea de a agonisi. - V. agonisi.","s":"DEX '98"},"agonisi":{"c":"verb","t":"Tranz. A dobândi, a câștiga prin muncă. ◊ A strânge, a pune deoparte; a economisi.","s":"DEX '98"},"agora":{"c":"substantiv feminin","t":"Piață publică în orașele Greciei antice, unde se aflau principalele instituții și unde se țineau adunările publice; p. ext. adunare a poporului care se ținea în această piață.","s":"DEX '98"},"agoniseală":{"c":"substantiv feminin","t":"(Pop.) Ceea ce agonisește cineva; economii, agonisită. ◊ Câștig (dobândit prin muncă). - Agonisi + suf. -eală.","s":"DEX '98"},"agonal":{"c":"adjectiv","t":"Referitor la agonale.","s":"DEX '98"},"agonale":{"c":"substantiv feminin","t":"pl. Întreceri atletice la vechii greci. ◊ (La romani) Serbări în cinstea zeului Ianus.","s":"DEX '98"},"agonisită":{"c":"substantiv feminin","t":"(Pop.) Agoniseală. - V. agonisi.","s":"DEX '98"},"agonic":{"c":"adjectiv","t":"Referitor la agonie; care este în agonie.","s":"DEX '98"},"agonizant":{"c":"adjectiv","t":"Care agonizează; muribund.","s":"DEX '98"},"agost":{"c":"substantiv masculin","t":"invar. A opta lună a anului; gustar.","s":"DEX '98"},"agoniza":{"c":"verb","t":"Intranz. A fi în stare de agonie.","s":"DEX '98"},"agogică":{"c":"substantiv feminin","t":"Teorie care se ocupă cu schimbările mișcării ritmice, determinate de expresivitate, în timpul executării unei piese muzicale.","s":"DEX '98"},"agonă":{"c":"substantiv feminin","t":"Linie de pe suprafața pământului ale cărei puncte nu prezintă declinație magnetică.","s":"DEX '98"},"agorafobie":{"c":"substantiv feminin","t":"Teamă patologică, obsesivă și nemotivată de spațiile largi, de locurile deschise, de piețe etc.","s":"DEX '98"}},"F":{"agonii":["agonie"],"agonia":["agonie"],"agoniei":["agonie