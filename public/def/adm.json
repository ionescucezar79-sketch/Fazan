{"L":{"administrare":{"c":"substantiv feminin","t":"Acțiunea de a administra. - V. administra.","s":"DEX '98"},"administra":{"c":"verb","t":"Tranz. 1. A conduce, a cârmui; a gospodări o întreprindere, o instituție etc. 2. A da unui bolnav un anumit medicament. ◊ (Ir.) A trage o bătaie. 3. (Jur.; în sintagma) A administra o probă = a folosi un mijloc de probă într-un proces.","s":"DEX '98"},"admira":{"c":"verb","t":"Tranz. A privi ceva sau pe cineva cu un sentiment de încântare, de stimă etc.","s":"DEX '98"},"admirare":{"c":"substantiv feminin","t":"(Înv.) Admirație. - V. admira.","s":"DEX '98"},"admonestare":{"c":"substantiv feminin","t":"Acțiunea de a admonesta și rezultatul ei; (concr.) act, adresă oficială care conține o mustrare etc. adresată cuiva; admonestație, admonițiune (2). - V. admonesta.","s":"DEX '98"},"admonesta":{"c":"verb","t":"Tranz. A mustra cu severitate (în calitate oficială); a dojeni aspru (pe un subaltern).","s":"DEX '98"},"administrațiune":{"c":"substantiv feminin","t":"1. Totalitatea organelor administrative ale unui stat; secție a unei instituții însărcinată cu administrarea acelei instituții. ♦ Administrație de stat = a) formă de activitate (executivă și de dispoziție) a statului pentru realizarea funcțiilor sale; b) totalitatea organelor de stat prin care se desfășoară această activitate. …","s":"DEX '98"},"admirațiune":{"c":"substantiv feminin","t":"Sentiment de încântare, de stimă, de apreciere etc. față de cineva sau de ceva; admirare.","s":"DEX '98"},"admitere":{"c":"substantiv feminin","t":"Acțiunea de a admite. ♦ Examen de admitere = examen de acceptare a unui candidat într-o instituție de învățământ. - V. admite.","s":"DEX '98"},"admite":{"c":"verb","t":"Tranz. A primi ca bun, a considera ca adevărat; a fi (provizoriu) de acord cu ceva; a îngădui, a permite. ◊ A da curs favorabil unei cereri. ◊ A primi pe un solicitator, a accepta un candidat.","s":"DEX '98"},"admitanță":{"c":"substantiv feminin","t":"Nume dat fenomenului invers impedanței și definit ca mărime caracteristică unui circuit de curent electric alternativ, egală cu câtul dintre valoarea efectivă a curentului electric absorbit și valoarea efectivă a tensiunii de alimentare.","s":"DEX '98"},"admirabil":{"c":"adjectiv","t":"Vrednic de a fi admirat; minunat, încântător, excelent.","s":"DEX '98"},"admirativ":{"c":"adjectiv","t":"(Adesea adverbial) Care exprimă, care arată admirație.","s":"DEX '98"},"admisibil":{"c":"adjectiv","t":"Care poate fi admis; acceptabil.","s":"DEX '98"},"admonitiv":{"c":"adjectiv","t":"Care admonestează, care cenzurează.","s":"DEX '98"},"admonestație":{"c":"substantiv feminin","t":"(Rar) Admonestare.","s":"DEX '98"},"administrat":{"c":"substantiv masculin și feminin","t":"(Rar) Persoană care se află sub conducerea cuiva. - V. administra.","s":"DEX '98"},"administrație":{"c":"substantiv feminin","t":"1. Totalitatea organelor administrative ale unui stat; secție a unei instituții însărcinată cu administrarea acelei instituții. ♦ Administrație de stat = a) formă de activitate (executivă și de dispoziție) a statului pentru realizarea funcțiilor sale; b) totalitatea organelor de stat prin care se desfășoară această activitate. …","s":"DEX '98"},"administrată":{"c":"substantiv masculin și feminin","t":"(Rar) Persoană care se află sub conducerea cuiva. - V. administra.","s":"DEX '98"},"administrativ":{"c":"adjectiv","t":"Care aparține administrației, privitor la administrație. ◊ Care emană de la un organ de administrație. ♦ Pe cale administrativă = prin organele administrației de stat.","s":"DEX '98"},"administrator":{"c":"substantiv masculin și feminin","t":"Persoană care administrează, care conduce o administrație sau un serviciu de administrație. ◊ Persoană care conduce un serviciu în administrația statului.","s":"DEX '98"},"administratoare":{"c":"substantiv masculin și feminin","t":"Persoană care administrează, care conduce o administrație sau un serviciu de administrație. ◊ Persoană care conduce un serviciu în administrația statului.","s":"DEX '98"},"admiratoare":{"c":"substantiv masculin și feminin","t":"Persoană care admiră pe cineva sau ceva.","s":"DEX '98"},"admisiune":{"c":"substantiv feminin","t":"1. Intrare dirijată a unui fluid într-o mașină care transformă o formă de energie în altă formă de energie. 2. Fază a ciclului de funcționare a unor mașini, efectuată în timpul intrării agentului motor în mașină. [Pr.: -si-u-. - Var.: admisie s. f.]","s":"DEX '98"},"admirație":{"c":"substantiv feminin","t":"Sentiment de încântare, de stimă, de apreciere etc. față de cineva sau de ceva; admirare.","s":"DEX '98"},"admirator":{"c":"substantiv masculin și feminin","t":"Persoană care admiră pe cineva sau ceva.","s":"DEX '98"},"admisibilitate":{"c":"substantiv feminin","t":"(Rar) Posibilitatea de a fi admis, calitatea a ceea ce este admisibil.","s":"DEX '98"},"admisie":{"c":"substantiv feminin","t":"1. Intrare dirijată a unui fluid într-o mașină care transformă o formă de energie în altă formă de energie. 2. Fază a ciclului de funcționare a unor mașini, efectuată în timpul intrării agentului motor în mașină. [Pr.: -si-u-. - Var.: admisie s. f.]","s":"DEX '98"},"admonițiune":{"c":"substantiv feminin","t":"1. Cercetare făcută de judecător. 2. (Rar) Admonestare. [Pr.: -ți-u-]","s":"DEX '98"}},"F":{"administrare":["administrare","administra"],"administrări":["administrare"],"administrarea":["administrare"],"administrării":["administrare"],"administrările":["administrare"],"administrărilor":["administrare"],"admirare":["admirare","admira"],"admirări":["admirare"],"admirarea":["admirare"],"admirării":["admirare"],"admirările":["admirare"],"admirărilor":["admirare"],"admonestare":["admonestare","admonesta"],"admonestări":["admonestare"],"admonestarea":["admonestare"],"admonestării":["admonestare"],"admonestările":["admonestare"],"admonestărilor":["admonestare"],"administrațiuni":["administrațiune"],"administrațiunea":["administrațiune"],"administrațiunii":["administrațiune"],"administra