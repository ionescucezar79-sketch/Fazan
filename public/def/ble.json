{"L":{"blestema":{"c":"verb","t":"Tranz. A invoca urgia divinității împotriva cuiva. ◊ Intranz. A înjura, a ocărî, a huli.[Prez. ind. acc. și: blestem]","s":"DEX '98"},"blegi":{"c":"verb","t":"Refl. 1. (Despre urechi) A se face bleg (1). 2. (Despre oameni) A deveni bleg (2); a se bleojdi.","s":"DEX '98"},"blești":{"c":"verb","t":"Intranz. (Reg.) 1. A răsufla (greu), a-și trage (cu greu) răsuflarea. 2. A îngăima, a vorbi (greu). ◊ Tranz. și refl. A (se) moleși, a (se) înmuia, a slăbi; a (se) pleoști. 3. A vorbi mult; a flecări, a trăncăni.","s":"DEX '98"},"bleahă":{"c":"adjectiv","t":"1. (Despre animale) Cu urechi care atârnă în jos; clăpăug; (despre urechile animalelor) care atârnă în jos; (despre oameni) cu urechile îndepărtate de cap; (despre urechile oamenilor) îndepărtate de cap (și atârnând în jos). 2. Lipsit de energie, de voință (și prost).","s":"DEX '98"},"bleah":{"c":"substantiv neutru","t":"(Reg.) Tablă de fier care îmbracă osia carului. [Var.: bleah, bleav s. n.]","s":"DEX '98"},"bleav":{"c":"substantiv neutru","t":"(Reg.) Tablă de fier care îmbracă osia carului. [Var.: bleah, bleav s. n.]","s":"DEX '98"},"blestem":{"c":"substantiv neutru","t":"Invocare a urgiei divinității împotriva cuiva; nenorocire a cuiva pusă pe seama furiei divine. [Acc. și: blestem]","s":"DEX '98"},"blejdi":{"c":"verb","t":"Tranz. și refl. (Reg. și fam.) A(-și) holba (ochii), a (se) zgâi.","s":"DEX '98"},"blejdit":{"c":"adjectiv","t":"(Reg. și fam.; despre ochi) Holbat, zgâit. - V. bleojdi.","s":"DEX '98"},"bleotocări":{"c":"verb","t":"Intranz. (Reg.) 1. A se bălăci. 2. A flecări.","s":"DEX '98"},"blenoragie":{"c":"substantiv feminin","t":"Boală venerică infecțioasă, manifestată prin mâncărime, senzație de usturime, scurgeri purulente etc.; gonoree.","s":"DEX '98"},"bleojdi":{"c":"verb","t":"Tranz. și refl. (Reg. și fam.) A(-și) holba (ochii), a (se) zgâi.","s":"DEX '98"},"bleojdire":{"c":"substantiv feminin","t":"(Reg. și fam.) Faptul de a (se) bleojdi. - V. bleojdi.","s":"DEX '98"},"bleojdit":{"c":"adjectiv","t":"(Reg. și fam.; despre ochi) Holbat, zgâit. - V. bleojdi.","s":"DEX '98"},"bleotocăreală":{"c":"substantiv feminin","t":"(Reg.) Faptul de a bleotocări. - Bleotocări + suf. -eală.","s":"DEX '98"},"bleu":{"c":"adjectiv","t":"invar., s. n. Albastru-deschis; azuriu. [Pr.: blö]","s":"DEX '98"},"bleumarin":{"c":"adjectiv","t":"invar., s. n. Albastru-închis. [Pr.: blö-]","s":"DEX '98"},"blestemat":{"c":"adjectiv","t":"1. Lovit, ajuns de blestem. ◊ Rău, neprielnic, dușmănos. 2. (Adesea substantivat) Cu purtări rele; depravat, rău, ticălos. - V. blestema.","s":"DEX '98"},"bleau":{"t":"BLEAU subst. (Reg.; în expr.) A nu zice nici bleau = a tăcea din gură, a nu (mai) scoate o vorbă.","s":"DEX '98"},"bleg":{"c":"adjectiv","t":"1. (Despre animale) Cu urechi care atârnă în jos; clăpăug; (despre urechile animalelor) care atârnă în jos; (despre oameni) cu urechile îndepărtate de cap; (despre urechile oamenilor) îndepărtate de cap (și atârnând în jos). 2. Lipsit de energie, de voință (și prost).","s":"DEX '98"},"bleandă":{"c":"substantiv feminin","t":"(Pop.) Sperietoare de păsări. ◊ Epitet pentru o persoană fără energie, molâie, bleagă.","s":"DEX '98"},"blendă":{"c":"substantiv feminin","t":"1. Rocă lucioasă, de culoare gălbuie, brună sau neagră, reprezentând sulfura naturală de zinc. 2. (Cin.) Suprafață metalizată folosită pentru reflectarea și difuziunea luminii.","s":"DEX '98"},"bleancă":{"c":"substantiv feminin","t":"(Pop.) Sperietoare de păsări. ◊ Epitet pentru o persoană fără energie, molâie, bleagă.","s":"DEX '98"},"bleașcă":{"c":"adjectiv","t":"invar. (Reg.) Leoarcă.","s":"DEX '98"},"blefarită":{"c":"substantiv feminin","t":"Inflamație a pleoapelor.","s":"DEX '98"},"blegit":{"c":"adjectiv","t":"Bleg (1). - V. blegi.","s":"DEX '98"},"blenoragic":{"c":"adjectiv","t":"Care ține de blenoragie, privitor la blenoragie.","s":"DEX '98"},"bleot":{"c":"adjectiv","t":"(Reg.; adesea substantivat) Prost, nătâng.","s":"DEX '98"},"blestemăție":{"c":"substa