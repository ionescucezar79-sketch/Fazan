{"L":{"zurbă":{"c":"substantiv feminin","t":"(Înv.) Revoltă, răscoală. ◊ Gălăgie, zarvă; ceartă, bătaie. [Var.: zurbă, zurbală s. f.]","s":"DEX '98"},"zurba":{"c":"substantiv feminin","t":"(Înv.) Revoltă, răscoală. ◊ Gălăgie, zarvă; ceartă, bătaie. [Var.: zurbă, zurbală s. f.]","s":"DEX '98"},"zurbală":{"c":"substantiv feminin","t":"(Înv.) Revoltă, răscoală. ◊ Gălăgie, zarvă; ceartă, bătaie. [Var.: zurbă, zurbală s. f.]","s":"DEX '98"},"zurui":{"c":"verb","t":"Intranz. și tranz. A zornăi. [Prez. ind. și: zurui. - Var.: zurăi vb. IV] - Zur + suf. -ui.","s":"DEX '98"},"zuruire":{"c":"substantiv feminin","t":"Acțiunea de a zurui și rezultatul ei; zornăit. - V. zurui.","s":"DEX '98"},"zurbavă":{"c":"substantiv feminin","t":"(înv.) Ceartă, gâlceavă, scandal. - Contaminare între zurba și gâlceavă.","s":"DEX '98"},"zuralie":{"c":"substantiv feminin","t":"art. v. zoralia.","s":"DEX '98"},"zurăire":{"c":"substantiv feminin","t":"Acțiunea de a zurui și rezultatul ei; zornăit. - V. zurui.","s":"DEX '98"},"zurăi":{"c":"verb","t":"Intranz. și tranz. A zornăi. [Prez. ind. și: zurui. - Var.: zurăi vb. IV] - Zur + suf. -ui.","s":"DEX '98"},"zur":{"c":"interjecție","t":"(Adesea cu \"r\" prelungit) Cuvânt care redă zornăitul metalelor sau zgomotul produs de ciocnirea sau rostogolirea unor obiecte mici. [Var.: zor interj.]","s":"DEX '98"},"zurăit":{"c":"verb","t":"Intranz. și tranz. A zornăi. [Prez. ind. și: zurui. - Var.: zurăi vb. IV] - Zur + suf. -ui.","s":"DEX '98"},"zurbalâc":{"c":"substantiv neutru","t":"(Pop.) Luptă, harță. ◊ Revoltă, răscoală.","s":"DEX '98"},"zurliu":{"c":"adjectiv","t":"(Fam.) Zvăpăiat, nebunatic; smintit.","s":"DEX '98"},"zuruit":{"c":"substantiv neutru","t":"Zornăit. - V. zurui.","s":"DEX '98"},"zurgalău":{"c":"substantiv masculin","t":"(Mai ales la pl.) Glob metalic cu una sau mai multe găurele și cu o bilă în interior, care sună la cea mai ușoară mișcare sau atingere; clopoțel.","s":"DEX '98"},"zuruitor":{"c":"adjectiv","t":"Care zuruie; zornăitor. [Pr.: