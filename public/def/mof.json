{"L":{"mofetă":{"c":"substantiv feminin","t":"Produs gazos, constituit în cea mai mare parte din bioxid de carbon, degajat prin crăpăturile scoarței terestre în fazele finale ale activității vulcanice.","s":"DEX '98"},"mofluzi":{"c":"verb","t":"Intranz. (Înv.) A da faliment; p. ext. a se ruina; a sărăci.","s":"DEX '98"},"mofluz":{"c":"substantiv masculin și feminin","t":"adj. 1. (Înv.) (Om) falit; (om) sărăcit, ruinat; (om) sărac. ♦ Expr. A ieși (sau a rămâne) mofluz = a da faliment. 2. (Om) înșelat, păgubit; p. ext. (om) nemulțumit, dezamăgit, blazat. [Pl. și: mofluzi. - Var.: mufluz, -ă s. m. și f., adj.]","s":"DEX '98"},"moftologie":{"c":"substantiv feminin","t":"(Fam.) Șmecherie, tertip.","s":"DEX '98"},"moftolog":{"c":"substantiv masculin","t":"(Fam.) Moftangiu.","s":"DEX '98"},"moft":{"c":"substantiv neutru","t":"(Fam.) 1. Lucru, problemă fără valoare, fără însemnătate; fleac, nimic, bagatelă. ♦ Expr. A umbla cu mofturi = a invoca motive lipsite de temei. ◊ (Rar) Șmecherie, tertip. 2. (La pl.) Capricii, fandoseli, nazuri, fasoane.","s":"DEX '98"},"mofetic":{"c":"adjectiv","t":"Care aparține mofetei, privitor la mofetă.","s":"DEX '98"},"moftologic":{"c":"adjectiv","t":"(Fam.) Lipsit de seriozitate. - Moftolog + suf. -ic.","s":"DEX '98"},"mofluză":{"c":"substantiv masculin și feminin","t":"adj. 1. (Înv.) (Om) falit; (om) sărăcit, ruinat; (om) sărac. ♦ Expr. A ieși (sau a rămâne) mofluz = a da faliment. 2. (Om) înșelat, păgubit; p. ext. (om) nemulțumit, dezamăgit, blazat. [Pl. și: mofluzi. - Var.: mufluz, -ă s. m. și f., adj.]","s":"DEX '98"},"mofluzită":{"c":"substantiv masculin și feminin","t":"(Înv.) Om falit; p. ext. om ruinat, sărăcit. - V. mofluzi.","s":"DEX '98"},"mofluzit":{"c":"substantiv masculin și feminin","t":"(Înv.) Om falit; p. ext. om ruinat, sărăcit. - V. mofluzi.","s":"DEX '98"},"moftangiu":{"c":"substantiv masculin","t":"(Fam.) Om neserios pe care nu se poate conta, flecar (și șmecher); moftolog. - Moft + suf. -angiu.","s":"DEX '98"},"mofturos"