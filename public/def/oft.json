{"L":{"oftalmometrie":{"c":"substantiv feminin","t":"(Med.) Determinare a viciilor de curbură ale corneei cu ajutorul oftalmometrului.","s":"DEX '98"},"oftalmopatie":{"c":"substantiv feminin","t":"(Med.) Denumire generică pentru bolile de ochi.","s":"DEX '98"},"oftalmoplegie":{"c":"substantiv feminin","t":"(Med.) Paralizie a mușchilor motori ai ochiului.","s":"DEX '98"},"oftalmoragie":{"c":"substantiv feminin","t":"(Med.) Hemoragie oculară.","s":"DEX '98"},"oftare":{"c":"substantiv feminin","t":"Faptul de a ofta; oftat, suspin. - V. ofta.","s":"DEX '98"},"ofta":{"c":"verb","t":"Intranz. A scoate un oftat (în semn de dor, de supărare, de regret etc.); a suspina. ♦ Expr. A ofta după cineva (sau ceva) = a regreta mult pierderea cuiva (sau a ceva); a dori din tot sufletul pe cineva (sau ceva), a tânji după cineva (sau ceva).","s":"DEX '98"},"oftica":{"c":"verb","t":"1. Refl. (Pop.) A se îmbolnăvi de tuberculoză pulmonară. 2. Tranz. și refl. Fig. A (se) chinui, a(-și) învenina viața, a (se) supăra, a (se) amărî tare.","s":"DEX '98"},"ofticare":{"c":"substantiv feminin","t":"(Pop.) Faptul de a (se) oftica. - V. oftica.","s":"DEX '98"},"oftici":{"c":"verb","t":"1. Refl. (Pop.) A se îmbolnăvi de tuberculoză pulmonară. 2. Tranz. și refl. Fig. A (se) chinui, a(-și) învenina viața, a (se) supăra, a (se) amărî tare.","s":"DEX '98"},"oftică":{"c":"substantiv feminin","t":"(Pop.) Tuberculoză pulmonară; ftizie. ♦ Expr. (Fam.) A avea oftică (pe cineva) = a-i fi necaz (pe cineva), a nu-l putea suferi. A-i face (cuiva) oftică = a-i face (cuiva) în necaz, a supăra (pe cineva). [Var.: oftigă s. f.]","s":"DEX '98"},"oftigi":{"c":"verb","t":"1. Refl. (Pop.) A se îmbolnăvi de tuberculoză pulmonară. 2. Tranz. și refl. Fig. A (se) chinui, a(-și) învenina viața, a (se) supăra, a (se) amărî tare.","s":"DEX '98"},"oftigă":{"c":"substantiv feminin","t":"(Pop.) Tuberculoză pulmonară; ftizie. ♦ Expr. (Fam.) A avea oftică (pe cineva) = a-i fi necaz (pe cineva), a nu-l putea suferi. A-i face (cuiva) oftică = a-i face (cuiva) în necaz, a supăra (pe cineva). [Var.: oftigă s. f.]","s":"DEX '98"},"oftalmologă":{"c":"substantiv masculin și feminin","t":"Medic specializat în oftalmologie; oculist.","s":"DEX '98"},"oft":{"c":"substantiv neutru","t":"(Înv. și reg.) Oftat, suspin; p. ext. amărăciune, regret, durere, suferință, deznădejde.","s":"DEX '98"},"oftalmic":{"c":"adjectiv","t":"Care aparține ochiului sau bolilor ochiului, privitor la ochi sau la bolile ochiului.","s":"DEX '98"},"oftalmologic":{"c":"adjectiv","t":"Care aparține oftalmologiei, privitor la oftalmologie.","s":"DEX '98"},"oftalmometric":{"c":"adjectiv","t":"(Med.) Referitor la oftalmometrie, de oftalmometrie.","s":"DEX '98"},"oftat":{"c":"substantiv neutru","t":"Respirație puternică, profundă și prelungă, însoțită în expirație de un zgomot caracteristic care întrerupe ritmul respirator normal, pricinuită de o durere morală (sau fizică); suspin, oftătură, aht, oft, oftare. - V. ofta.","s":"DEX '98"},"ofticat":{"c":"adjectiv","t":"(Pop.) Tuberculos. Fig. Amărât, chinuit. - V. oftica.","s":"DEX '98"},"oftalmie":{"c":"substantiv feminin","t":"1. Conjunctivită gravă, adesea purulentă. 2. Termen generic pentru afecțiunile inflamatorii grave ale structurilor profunde ale globului ocular.","s":"DEX '98"},"oftalmolog":{"c":"substantiv masculin și feminin","t":"Medic specializat în oftalmologie; oculist.","s":"DEX '98"},"oftalmologie":{"c":"substantiv feminin","t":"Ramură a medicinii care se ocupă cu fiziologia și cu patologia ochilor și a anexelor acestora.","s":"DEX '98"},"oftigit":{"c":"adjectiv","t":"(Pop.) Tuberculos. Fig. Amărât, chinuit. - V. oftica.","s":"DEX '98"},"oftigos":{"c":"adjectiv","t":"1. (Adesea substantivat) Tuberculos, ftizic, atacat. ♦ Fig. Fără putere; slab, pipernicit, anemic. 2. (Fam.) Invidios. [Var.: oftigos, -oasă adj.] - Oftică + suf. -os.","s":"DEX '98"},"ofticos":{"c":"adjectiv","t":"1. (Adesea substantivat) Tuberculos, ftizic, atacat. ♦ Fig. Fără putere; slab, pipernicit, anemic. 2. (Fam.) Invidios. [Var.: oftigos, -oasă adj.] - Oftică + suf. -os.","s":"DEX '98"},"oftoic":{"c":"substantiv neutru","t":"Carte bisericească destinată cultului ortodox în care sunt cuprinse cântările din fiecare zi a săptămânii (cântate succesiv pe opt glasuri); fiecare dintre cântările cuprinse în această carte. [Acc. și: octoih. - Var.: ohtoic s. n.]","s":"DEX '98"},"oftătură":{"c":"substantiv feminin","t":"(Rar) Oftat. - Ofta + suf. -ătură.","s":"DEX '98"},"oftalmografie":{"c":"substantiv feminin","t":"Descriere anatomică a ochiului.","s":"DEX '98"},"oftalmometru":{"c":"substantiv neutru","t":"1. Instrument care servește la măsurarea razelor de curbură a corneei în diferite direcții, folosit în special pentru determinarea astigmatismului. 2. Instrument folosit pentru determinarea distanței vizibilității distincte a ochiului.","s":"DEX '98"},"oftalmoscop":{"c":"substantiv neutru","t":"Instrument folosit pentru examinarea interiorului globului ocular și a fundului de ochi. [Pl. și: oftalmoscopuri]","s":"DEX '98"},"oftalmoscopie":{"c":"substantiv feminin","t":"Examinare a interiorului globului ocular cu ajutorul oftalmoscopului.","s":"DEX '98"},"oftalmotomie":{"c":"substantiv feminin","t":"Extirpare a unui glob ocular bolnav.","s":"DEX '98"},"oftalmoscopic":{"c":"adjectiv","t":"Referitor la oftalmoscopie, care aparține oftalmoscopiei.","s":"DEX '98"}},"F":{"oftalmometrii":["oftalmometrie"],"oftalmometria":["oftalmometrie"],"oftalmometriei":["oftalmometrie"],"oftalmometriile":["oftalmometrie"],"oftalmometriilor":["oftalmometrie"],"oftalmopatii":["oftalmopatie"],"oftalmopatia":["oftalmopatie"],"oftalmopatiei":["oftalmopatie"],"oftalmopatiile":["oftalmopatie"],"oftalmopatiilor":["oftalmopatie"],"oftalmoplegii":["oftalmoplegie"],"oftalmoplegia":["oftalmoplegie"],"oftalmoplegiei":["oftalmoplegie"],"oftalmoplegiile":["oftalmoplegie"],"oftalmoplegiilor":["oftalmoplegie"],"oftalmoragii":["oftalmoragie"],"oftalmoragia":["oftalmoragie"],"oftalmoragiei":["oftalmoragie"],