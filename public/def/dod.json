{"L":{"dodie":{"c":"substantiv feminin","t":"pl. (Pop. și fam.; în expr.) A vorbi sau a grăi (cam) în dodii = a vorbi fără șir; a aiura. A lăsa (pe cineva) în dodiile lui = a lăsa (pe cineva) să-și facă nestingherit toanele, capriciile. A umbla sau a merge (ca) în dodii = a umbla sau a merge în neștire, năuc.","s":"DEX '98"},"dodecafonic":{"c":"adjectiv","t":"Care aparține dodecafonismului, privitor la dodecafonism; dodecafonist.","s":"DEX '98"},"dodecagonal":{"c":"adjectiv","t":"De dodecagon, privitor la dodecagon, care formează un dodecagon.","s":"DEX '98"},"dodecar":{"c":"substantiv masculin","t":"Veche monedă turcească de aur, care a circulat și în țările românești.","s":"DEX '98"},"dodecafonism":{"c":"substantiv neutru","t":"(Muz.) Tehnică de compoziție bazată pe folosirea tuturor celor douăsprezece sunete ale gamei cromatice, considerate ca având aceeași importanță și ducând la desființarea legăturilor tonale normale.","s":"DEX '98"},"dodecafonist":{"c":"adjectiv","t":"s. m. și f. 1. Adj. Care aparține dodecafonismului, privitor la dodecafonism; dodecafonic. 2. S. m. și f. Compozitor care folosește dodecafonismul.","s":"DEX '98"},"dodecafonistă":{"c":"adjectiv","t":"s. m. și f. 1. Adj. Care aparține dodecafonismului, privitor la dodecafonism; dodecafonic. 2. S. m. și f. Compozitor care folosește dodecafonismul.","s":"DEX '98"},"dodecaedru":{"c":"substantiv neutru","t":"Poliedru cu douăsprezece fețe. ◊ Cristal care are aspectul unui astfel de poliedru.","s":"DEX '98"},"dodecagon":{"c":"substantiv neutru","t":"Poligon cu douăsprezece laturi și douăsprezece unghiuri.","s":"DEX '98"},"dodecasilab":{"c":"substantiv neutru","t":"adj. (Vers) care are douăsprezece silabe.","s":"DEX '98"},"dodecaedric":{"c":"adjectiv","t":"De dodecaedru, privitor la dodecaedru, care formează un dodecaedru.","s":"DEX '98"},"dodecasilabic":{"c":"adjectiv","t":"(Despre versuri) Care are douăsprezece silabe.","s":"DEX '98"}},"F":{"dodii":["dodie"],"dodia":["dodie"],"dodiei":["dodie"],"dodi