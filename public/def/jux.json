{"L":{"juxtapunere":{"c":"substantiv feminin","t":"Acțiunea de a juxtapune și rezultatul ei; alăturare, juxtapoziție. ◊ (Gram.) Mijloc de exprimare a raporturilor sintactice de coordonare sau de subordonare dintre elementele alcătuitoare ale unei propoziții sau fraze, care constă în simpla lor alăturare, fără ajutorul vreunui cuvânt de legătură; parataxă. - V. juxtapune.","s":"DEX '98"},"juxtapune":{"c":"verb","t":"Tranz. A pune mai multe obiecte alături, unul lângă altul; a alătura. ♦ Refl. și tranz. (Gram.) A (se) îmbina prin juxtapunere.","s":"DEX '98"},"juxtă":{"c":"substantiv feminin","t":"Traducere juxtalineară a textelor grecești și latinești. [Var.: iuxtă s. f.]","s":"DEX '98"},"juxtapus":{"c":"adjectiv","t":"Pus alături unul de altul; alăturat. ◊ (Gram.) Legat prin juxtapunere; paratactic. - V. juxtapune.","s":"DEX '98"},"juxtalinear":{"c":"adjectiv","t":"f. (În sintagma) Traducere juxtalineară = traducere literală a unui text, cu reproducerea paralelă a textului original. [Pr.: -ne-a-. - Var.: juxtaliniară adj. f.]","s":"DEX '98"},"juxtaliniar":{"c":"adjectiv","t":"f. (În sintagma) Traducere juxtalineară = traducere literală a unui text, cu reproducerea paralelă a textului original. [Pr.: -ne-a-. - Var.: juxtaliniară adj. f.]","s":"DEX '98"},"juxtapoziție":{"c":"substantiv feminin","t":"(Rar) Juxtapunere.","s":"DEX '98"}},"F":{"juxtapunere":["juxtapunere","juxtapune"],"juxtapuneri":["juxtapunere"],"juxtapunerea":["juxtapunere"],"juxtapunerii":["juxtapunere"],"juxtapunerile":["juxtapunere"],"juxtapunerilor":["juxtapunere"],"juxte":["juxtă"],"juxta":["juxtă"],"juxtei":["juxtă"],"juxtele":["juxtă"],"juxtelor":["juxtă"],"juxtapus":["juxtapus","juxtapune"],"juxtapuși":["juxtapus"],"juxtapusul":["juxtapus"],"juxtapusului":["juxtapus"],"juxtapușii":["juxtapus"],"juxtapușilor":["juxtapus"],"juxtapusă":["juxtapus"],"juxtapuse":["juxtapune","juxtapus"],"juxtapusa":["juxtapus"],"juxtapusei":["juxtapune","juxtapus"],"juxtapusele":["juxtapus"],"juxtapuselor":["juxtapus