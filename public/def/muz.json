{"L":{"muzicaliza":{"c":"verb","t":"Tranz. (Livr.) A face să fie muzical.","s":"DEX '98"},"muzicalizare":{"c":"substantiv feminin","t":"(Livr.) Acțiunea de a muzicaliza. - V. muzicaliza.","s":"DEX '98"},"muză":{"c":"substantiv feminin","t":"1. (Mitol.) Fiecare dintre cele nouă divinități alegorice ocrotitoare și inspiratoare ale artelor și ale științelor; spec. zeiță a poeziei, care inspiră pe poeți. 2. Inspirație poetică. 3. (Livr.) Poezie, literatură.","s":"DEX '98"},"muze":{"c":"substantiv neutru","t":"Instituție care se ocupă cu strângerea, păstrarea și expunerea obiectelor care prezintă interes istoric, științific, artistic etc.; clădire în care sunt păstrate și expuse astfel de obiecte. ♦ Loc. adj. De muzeu = a) rar, prețios; b) (ir.) învechit.","s":"DEX '98"},"muzicuță":{"c":"substantiv feminin","t":"Mic instrument muzical de suflat; armonică de gură. ◊ (Arg.) Gură (considerată ca organ al vorbirii); p. ext. scandal, ceartă. - Muzică + suf. -uță.","s":"DEX '98"},"muzicotecă":{"c":"substantiv feminin","t":"Colecție de piese muzicale; p. ext. mobilă în care se păstrează astfel de colecții; încăpere special dotată pentru audierea muzicii.","s":"DEX '98"},"muzeistic":{"c":"adjectiv","t":"s. f. (Livr.) 1. Adj. Care aparține muzeologiei, referitor la muzeologie. 2. S. f. Muzeologie. - Muzeu + suf. -istic.","s":"DEX '98"},"muzeistică":{"c":"adjectiv","t":"s. f. (Livr.) 1. Adj. Care aparține muzeologiei, referitor la muzeologie. 2. S. f. Muzeologie. - Muzeu + suf. -istic.","s":"DEX '98"},"muzicografic":{"c":"adjectiv","t":"De muzicografie.","s":"DEX '98"},"muzicologic":{"c":"adjectiv","t":"Referitor la muzicologie, care aparține muzicologiei. - Muzicologie + suf. -ic.","s":"DEX '98"},"muzicalizat":{"c":"adjectiv","t":"(Livr.) Care a devenit muzical. - V. muzicaliza.","s":"DEX '98"},"muzeu":{"c":"substantiv neutru","t":"Instituție care se ocupă cu strângerea, păstrarea și expunerea obiectelor care prezintă interes istoric, științific, artistic etc.; clădire în care sunt păstrate și expuse astfel de obiecte. ♦ Loc. adj. De muzeu = a) rar, prețios; b) (ir.) învechit.","s":"DEX '98"},"muzicalitate":{"c":"substantiv feminin","t":"Caracter muzical; însușirea de a fi muzical; armonie, sonoritate armonioasă.","s":"DEX '98"},"muzicant":{"c":"substantiv masculin și feminin","t":"1. Persoană care cântă la un instrument muzical. 2. (Înv.) Persoană care cunoaște, se ocupă cu muzica, are aptitudini pentru muzică; p. ext. compozitor.","s":"DEX '98"},"muzicantă":{"c":"substantiv masculin și feminin","t":"1. Persoană care cântă la un instrument muzical. 2. (Înv.) Persoană care cunoaște, se ocupă cu muzica, are aptitudini pentru muzică; p. ext. compozitor.","s":"DEX '98"},"muzicolog":{"c":"substantiv masculin și feminin","t":"Specialist în muzicologie.","s":"DEX '98"},"muzicologie":{"c":"substantiv feminin","t":"Știință care studiază muzica în toate domeniile și manifestările ei.","s":"DEX '98"},"muzicologă":{"c":"substantiv masculin și feminin","t":"Specialist în muzicologie.","s":"DEX '98"},"muzicalism":{"c":"substantiv neutru","t":"Tendință în arta modernă după care muzica poate fi tradusă în pictură prin culori, arabescuri etc.","s":"DEX '98"},"muzeotehnică":{"c":"substantiv feminin","t":"Ramură a muzeologiei consacrată metodelor și mijloacelor folosite aplicativ în cadrul unui muzeu. [Pr.: -ze-o-] - Muzeu + tehnică.","s":"DEX '98"},"muzicograf":{"c":"substantiv masculin și feminin","t":"Specialist în muzicografie.","s":"DEX '98"},"muzicografie":{"c":"substantiv feminin","t":"Totalitatea studiilor consacrate muzicii.","s":"DEX '98"},"muzicoman":{"c":"substantiv masculin și feminin","t":"Persoană pasionată de muzică; meloman.","s":"DEX '98"},"muzicomanie":{"c":"substantiv feminin","t":"Pasiune (exagerată) pentru muzică.","s":"DEX '98"},"muzicomană":{"c":"substantiv masculin și feminin","t":"Persoană pasionată de muzică; meloman.","s":"DEX '98"},"muzical":{"c":"adjectiv","t":"1. Care aparține muzicii (1), privitor la muzică, de sau pentru muzică. ◊ În care se execută piese, compoziții muzicale. ◊ Înzestrat cu simț, cu talent pentru muzică. 2. (Despre sunete, voce etc.; adesea adverbial) Armonios, melodios.","s":"DEX '98"},"muzică":{"c":"substantiv feminin","t":"1. Arta de a exprima sentimente și idei cu ajutorul sunetelor combinate într-o manieră specifică. 2. Știință a sunetelor considerate sub raportul melodiei, al ritmului și al armoniei. 3. (Adesea fig.) Creație componistică, melodie, cântec; p. ext. executare sau audiere a unei compoziții muzicale. ♦ Expr. (Fam.) A-i face (cuiva) muzică = a-i face (cuiva) gălăgie, scandal. 4. Orchestră. ♦ Muzică militară = fanfară. …","s":"DEX '98"},"muzeografie":{"c":"substantiv feminin","t":"Disciplină care se ocupă cu istoria, clasarea, conservarea, prezentarea și popularizarea obiectelor dintr-un muzeu. [Pr.: -ze-o-]","s":"DEX '98"},"muzeograf":{"c":"substantiv masculin și feminin","t":"Specialist în muzeografie. [Pr.: -ze-o-]","s":"DEX '98"},"muzeologie":{"c":"substantiv feminin","t":"Știință care are ca obiect studiul organizării muzeelor, al păstrării și prezentării exponatelor dintr-un muzeu; muzeistică. [Pr.: -ze-o-]","s":"DEX '98"},"muzeolog":{"c":"substantiv masculin și feminin","t":"Specialist în muzeologie. [Pr.: -ze-o-]","s":"DEX '98"},"muzicoterapie":{"c":"substantiv feminin","t":"Tratament al unor boli nervoase cu ajutorul audițiilor muzicale.","s":"DEX '98"},"muzician":{"c":"substantiv masculin și feminin","t":"Persoană care compune sau execută compoziții muzicale. ◊ Persoană care cunoaște arta muzicii (1). [Pr.: -ci-an]","s":"DEX '98"},"muziciană":{"c":"substantiv masculin și feminin","t":"Persoană care compune sau execută compoziții muzicale. ◊ Persoană care cunoaște arta muzicii (1). [Pr.: -ci-an]","s":"DEX '98"},"muzeal":{"c":"adjectiv","t":"Care aparține unui muzeu, care se referă la un muzeu, de muzeu. [Pr.: -ze-al] - Muzeu + suf. -al. Cf. germ. museal.","s":"DEX '98"},"muzeografă":{"c":"substantiv masculin și feminin","t":"Specialist în muzeografie. [Pr.: -ze-o-]","s":"DEX '98"},"muzeografic":{"c":"adjectiv","t":"Care aparține muzeografiei, privitor la muzeografie, de muzeografie. [Pr.: -ze-o-]","s":"DEX '98"},"muzeologă":{"c":"substantiv masculin și feminin","t":"Specialist în muzeologie. [Pr.: -ze-o-]","s":"DEX '98"},"muzeoloagă":{"c":"substantiv masculin și feminin","t":"Specialist în muzeologie. [Pr.: -ze-o-]","s":"DEX '98"}},"F":{"muzicalizare":["muzicalizare","muzicaliza"],"muzicalizări":["muzicalizare"],"muzicalizarea":["muzicalizare"],"muzicalizării":["muzicalizare"],"muzicalizările":["muzicalizare"],"muzicalizărilor":["muzicalizare"],"muze":["muze","muză"],"muza":["muză"],"muzei":["muză"],"muzele":["muză"],"muzelor":["muză"],"muzicuțe":["muzicuță"],"muzicuța":["muzicuță"],"muzicuței":["muzicuță"],"muzicuțele":["muzicuță"],"muzicuțelor":["muzicuță"],"muzicoteci":["muzicotecă"],"muzicoteca":["muzicotecă"],"muzicotecii":["muzicotecă"],"muzicotecile":["muzicotecă"],"muzicotecilor":["muzicotecă"],"muzeistici":["muzeistic","muzeistică"],"muzeisticul":["muzeistic"],"muzeisticului":["muzeistic"],"muzeisticii":["muzeistic","muzeistică"],"muzeisticilor":["muzeistic"],"muzeistică":["muzeistică","muzeistic"],"muzeistice":["muzeistic"],"muzeistica":["muzeistic","muzeistică"],"muzeisticei":["muzeistic"],"muzeisticele":["muzeistic"],"muzeisticelor":["muzeistic"],"muzicografici":["muzicografic"],"muzicograficul":["muzicografic"],"muzicograficului":["muzicografic"],"muzicograficii":["muzicografic"],"muzicograficilor":["muzicografic"],"muzicografică":["muzicografic"],"muzicografice":["muzicografic"],"muzicografica":["muzicografic"],"muzicograficei":["muzicografic"],"muzicograficele":["muzicografic"],"muzicograficelor":["muzicografic"],"muzicologici":["muzicologic"],"muzicologicul":["muzicologic"],"muzicologicului":["muzicologic"],"muzicologicii":["muzicologic"],"muzicologicilor":["muzicologic"],"muzicologică":["muzicologic"],"muzicologice":["muzicologic"],"muzicologica":["muzicologic"],"muzicologicei":["muzicolo