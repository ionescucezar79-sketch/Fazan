{"L":{"odontocie":{"c":"substantiv feminin","t":"Proces de decalcifiere a dinților, care provoacă carierea lor.","s":"DEX '98"},"odontogenie":{"c":"substantiv feminin","t":"(Med.) Procesul de dezvoltare a dinților.","s":"DEX '98"},"odor":{"c":"substantiv neutru","t":"1. Obiect lucrat dintr-un metal prețios (împodobit cu pietre scumpe); obiect de (mare) preț; giuvaier. (La pl.) Veșminte scumpe și alte obiecte prețioase folosite la serviciile religioase. 2. Fig. Ființă iubită, prețuită; spec. copil.","s":"DEX '98"},"odoare":{"c":"substantiv neutru","t":"(Înv.) Miros, mireasmă, parfum. [Var.: odoare s. f.]","s":"DEX '98"},"odorizare":{"c":"substantiv feminin","t":"Acțiunea de a odoriza și rezultatul ei. - V. odoriza.","s":"DEX '98"},"odoriza":{"c":"verb","t":"Tranz. A face ca un gaz combustibil inodor să exale un miros prin amestecarea lui cu un odorizant.","s":"DEX '98"},"odoleană":{"c":"substantiv masculin","t":"Nume dat mai multor specii de plante erbacee cu flori mari, trandafirii sau albe (Valeriana), dintre care una servește la prepararea unor produse farmaceutice cu proprietăți sedative; valeriană (Valeriana officinalis). [Var.: odoleană s. f., hodolean s. m.]","s":"DEX '96"},"odogaci":{"c":"substantiv masculin","t":"1. Plantă erbacee cu flori trandafirii, mai rar albe, ale cărei rădăcini se utilizează la scoaterea petelor de pe stofe; ciuin, săpunariță (Saponaria officinalis). 2. Numele a doi arbuști exotici, cu ramuri brune și păroase, cu frunze ovale, a căror scoarță aromatică se întrebuințează în medicină (Croton). ◊ Scoarța acestor arbuști, care răspândește (prin ardere) un miros plăcut; p. ext. …","s":"DEX '98"},"odometric":{"c":"adjectiv","t":"De odometrie.","s":"DEX '98"},"odonat":{"c":"substantiv neutru","t":"(La pl.) Ordin de insecte din care face parte libelula; (și la sg.) insectă din acest ordin.","s":"DEX '98"},"odontolit":{"c":"substantiv neutru","t":"Tartru dentar.","s":"DEX '98"},"odontologic":{"c":"adjectiv","t":"Care aparține odontologiei, referitor la odontologie.","s":"DEX '98"},"odorant":{"c":"adjectiv","t":"Care răspândește un miros plăcut; parfumat, mirositor, odorifer, odoriferant. ◊ (Tehn.; despre unele substanțe) Care conține odorizanți.","s":"DEX '98"},"odoriferant":{"c":"adjectiv","t":"(Înv.) Odorant.","s":"DEX '98"},"odorific":{"c":"adjectiv","t":"Mirositor.","s":"DEX '98"},"odorizant":{"c":"substantiv masculin","t":"Compus chimic cu miros puternic, folosit pentru a da miros gazelor combustibile (inodore) în scopul detectării pierderilor accidentale de gaze din conducte, din recipiente etc.","s":"DEX '98"},"odorob":{"c":"substantiv neutru","t":"(Reg.) Coș de nuiele în forma unui trunchi de con, fără fund, care servește la pescuit.","s":"DEX '98"},"odorogit":{"c":"adjectiv","t":"1. (Despre obiecte) Care funcționează prost; uzat, stricat, hârbuit. 2. Fig. (Despre persoane) Șubrezit, ramolit de boală sau de bătrânețe. ◊ (Despre voce) Răgușit. [Var.: odorogit, -ă adj.] - V. hodorogi.","s":"DEX '96"},"odorizat":{"c":"verb","t":"Tranz. A face ca un gaz combustibil inodor să exale un miros prin amestecarea lui cu un odorizant.","s":"DEX '98"},"odolean":{"c":"substantiv masculin","t":"Nume dat mai multor specii de plante erbacee cu flori mari, trandafirii sau albe (Valeriana), dintre care una servește la prepararea unor produse farmaceutice cu proprietăți sedative; valeriană (Valeriana officinalis). [Var.: odoleană s. f., hodolean s. m.]","s":"DEX '96"},"odoraș":{"c":"substantiv neutru","t":"Diminutiv al lui odor (2); termen de alintare întrebuințat de părinți pentru copiii mici. - Odor + suf. -aș.","s":"DEX '98"},"odos":{"c":"substantiv masculin","t":"(Reg.) Numele a două specii de plante erbacee din familia gramineelor, asemănătoare cu ovăzul, răspândite în culturi ca buruiană (Avena fatua și stigosa).","s":"DEX '98"},"odometrie":{"c":"substantiv feminin","t":"Tehnică a măsurării distanțelor parcurse (pe jos).","s":"DEX '98"},"odontolog":{"c":"substantiv masculin și feminin","t":"Specialist în odontologie.","s":"DEX '98"},"odontologie":{"c":"substantiv feminin","t":"Parte a anatomiei care se ocupă cu studiul dinților.","s":"DEX '98"},"odontologă":{"c":"substantiv masculin și feminin","t":"Specialist în odontologie.","s":"DEX '98"},"odontotehnică":{"c":"substantiv feminin","t":"Operație de conservare și de întreținere a sănătății dinților prin plombarea, înlocuirea, controlarea lor.","s":"DEX '98"},"odorat":{"c":"substantiv neutru","t":"(Înv.) Miros.","s":"DEX '98"},"odorologie":{"c":"substantiv feminin","t":"(În sintagma) Odorologie judiciară = domeniu al criminalisticii care elaborează metodologia de căutare, descoperire și examinare a urmei de miros lăsate de infractor.","s":"DEX '98"},"odograf":{"c":"substantiv neutru","t":"Traseu al unui drum.","s":"DEX '98"},"odografie":{"c":"substantiv feminin","t":"Descriere a drumurilor dintr-o anumită regiune.","s":"DEX '98"},"odometru":{"c":"substantiv neutru","t":"Podometru.","s":"DEX '98"},"odontalgie":{"c":"substantiv feminin","t":"Durere de dinți.","s":"DEX '98"},"odontoblast":{"c":"substantiv neutru","t":"Fiecare dintre celulele conjunctive dispuse într-unul sau în mai multe rânduri la limita dintre pulpa dentară și dentină, având rol important în formarea dentinei.","s":"DEX '98"},"odontoragie":{"c":"substantiv feminin","t":"Scurgere de sânge din alveolele dinților.","s":"DEX '98"},"odorifer":{"c":"adjectiv","t":"(Rar) Odorant.","s":"DEX '98"},"odontalgic":{"c":"adjectiv","t":"Referitor la durerile de dinți.","s":"DEX '98"},"odontometru":{"c":"substantiv neutru","t":"Mic instrument din metal, celuloid, material plastic sau carton, care servește la măsurarea dantelurii unei mărci poștale.","s":"DEX '98"}},"F":{"odontocii":["odontocie"],"odontocia":["odontocie"],"odontociei":["odontocie"],"odontociile":["odontocie"],"odontociilor":["odontocie"],"odontogenii":["odontogenie"],"odontogenia":["odontogenie"],"odontogeniei":["odontogenie"],"odontogeniile":["odontogenie"],"odontogeniilor":["odontogenie"],"odoare":["odoa