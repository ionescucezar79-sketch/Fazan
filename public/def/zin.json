{"L":{"zinca":{"c":"verb","t":"Tranz. A zincui.","s":"DEX '98"},"zincare":{"c":"substantiv feminin","t":"Acțiunea de a zinca și rezultatul ei; operație de acoperire cu un strat subțire de zinc a pieselor de oțel sau de fontă, precum și a unor piese nemetalice, pentru a le proteja împotriva coroziunii sau pentru a le da un aspect decorativ. - V. zinca.","s":"DEX '98"},"zincografia":{"c":"verb","t":"Tranz. A reproduce imagini, desene etc. prin procedee zincografice. [Pr.: -fi-a]","s":"DEX '98"},"zincui":{"c":"verb","t":"Tranz. A acoperi un obiect de oțel, de fontă sau nemetalic cu un strat subțire de zinc pentru a-l feri de coroziune sau pentru a-i da un aspect decorativ; a zinca. - Zinc + suf. -ui.","s":"DEX '98"},"zincuire":{"c":"substantiv feminin","t":"Acțiunea de a zincui și rezultatul ei; zincare. - V. zincui.","s":"DEX '98"},"zini":{"c":"verb","t":"Intranz. 1. A se deplasa înspre persoana care vorbește sau despre care se vorbește; a se apropia de un loc, de o așezare; p. ext. a merge, a trece pe lângă sau printr-un anumit loc. ♦ Expr. Du-te-vino subst. = mișcare, circulație intensă, neîntreruptă și în ambele sensuri. Vino-ncoace subst. = a) farmec, drăgălășenie, atracție irezistibilă; b) (rar) ademenire, ispită, păcat. …","s":"DEX '98"},"zingheni":{"c":"verb","t":"Intranz. (despre metale, clopote, sticlă; la pers. 3) A produce prin izbire sau prin lovire un sunet metalic specific; a zornăi, a zdrăngăni. ♦ Tranz. Își zăngănesc armele. [Var.: zingăni, zingheni, zângăni vb. IV] - Zâng + suf. -ăni.","s":"DEX '98"},"zinghenire":{"c":"substantiv feminin","t":"Acțiunea de a zăngăni și rezultatul ei; zăngănit. [Var.: zingănire, zinghenire, zângănire s. f.] - V. zăngăni.","s":"DEX '98"},"zingăni":{"c":"verb","t":"Intranz. (despre metale, clopote, sticlă; la pers. 3) A produce prin izbire sau prin lovire un sunet metalic specific; a zornăi, a zdrăngăni. ♦ Tranz. Își zăngănesc armele. [Var.: zingăni, zingheni, zângăni vb. IV] - Zâng + suf. -ăni.","s":"DEX '98"},"zingănire":{"c":"substantiv feminin","t":"Acțiunea de a zăngăni și rezultatul ei; zăngănit. [Var.: zingănire, zinghenire, zângănire s. f.] - V. zăngăni.","s":"DEX '98"},"zină":{"c":"substantiv feminin","t":"1. Personaj feminin, fantastic, din basme, închipuit ca o femeie frumoasă și de obicei foarte bună, cu puteri supranaturale și cu darul nemuririi; fee. 2. (Rar) Zeiță.","s":"DEX '98"},"zingirliu":{"c":"adjectiv","t":"f. (Înv.; în sintagma) Cafea gingirlie = cafea turcească cu caimac.","s":"DEX '96"},"zingănit":{"c":"substantiv neutru","t":"Zgomot metalic specific, produs de unele obiecte prin lovire sau prin izbire; zăngănire, zăngăt. [Var.: zingănit, zângănit s. n.] - V. zăngăni.","s":"DEX '98"},"zingăt":{"c":"substantiv neutru","t":"Zăngănit. [Var.: zângăt, zânghet, zingăt, zinghet s. n.] - Zâng + suf. -ăt.","s":"DEX '98"},"zinghenitor":{"c":"adjectiv","t":"Care zăngănește; zornăitor. [Var.: zinghenitor, -oare, zângănitor, -oare adj.] - Zăngăni + suf. -tor.","s":"DEX '98"},"zinghet":{"c":"substantiv neutru","t":"Zăngănit. [Var.: zângăt, zânghet, zingăt, zinghet s. n.] - Zâng + suf. -ăt.","s":"DEX '98"},"zincat":{"c":"adjectiv","t":"Acoperit cu zinc. - V. zinca.","s":"DEX '98"},"zincografiat":{"c":"verb","t":"Tranz. A reproduce imagini, desene etc. prin procedee zincografice. [Pr.: -fi-a]","s":"DEX '98"},"zinatic":{"c":"adjectiv","t":"(Reg.; despre frați, surori) Născut în aceeași zi a anului, dar în ani diferiți. [Pr.: zi-ua-] - Ziuă + suf. -atic.","s":"DEX '98"},"zincografic":{"c":"adjectiv","t":"Care se întrebuințează în zincografie, de zincografie.","s":"DEX '98"},"zincograf":{"c":"substantiv masculin și feminin","t":"Lucrător tipograf calificat care execută clișee în zinc.","s":"DEX '98"},"zincografie":{"c":"substantiv feminin","t":"1. Procedeu de tipar pentru ilustrații în care se folosesc clișee obținute prin fotografiere și gravare pe plăci de zinc (uneori și de cupru, alamă, oțel etc.). 2. Atelier în care se execută clișee prin zincografie (1). 3. Reproducere, ilustrație executată prin zincografie (1).","s":"DEX '98"},"zincografă":{"c":"substantiv masculin și feminin","t":"Lucrător tipograf calificat care execută clișee în zinc.","s":"DEX '98"},"zincogravură":{"c":"substantiv feminin","t":"1. Tehnică a realizării clișeelor de zinc impermeabile prin gravare manuală sau mecanizată. 2. Clișeu executat prin zincogravură (1).","s":"DEX '98"},"zinnwaldit":{"c":"substantiv neutru","t":"(Min.) Minereu de litiu. [Pr.: ținvaldit]","s":"DEX '98"},"zinc":{"c":"substantiv neutru","t":"Element chimic, metal de culoare albă-albăstruie, întrebuințat în industrie atât singur, cât și sub formă de aliaje.","s":"DEX '98"}},"F":{"zincare":["zincare","zinca"],"zincări":["zincare"],"zincarea":["zincare"],"zincării":["zincare"],"zincările":["zincare"],"zincărilor":["zincare"],"zincografiere":["zincografia"],"zincuire":["zincuire","zincui"],"zincuiri":["zincuire"],"zincuirea":["zincuire"],"zincuirii":["zincuire"],"zincuirile":["zincuire"],"zincuirilor":["zincuire"],"zinire":["zini"],"zinghenire":["zinghenire","zingheni"],"zingheniri":["zinghenire"],"zinghenirea":["zinghenire"],"zinghenirii":["zinghenire"],"zinghenirile":["zinghenire"],"zinghenirilor":["zinghenire"],"zingănire":["zingănire","zingăni"],"zingăniri":["zingănire"],"zingănirea":["zingănire"],"zingănirii":["zingănire"],"zingănirile":["zingănire"],"zingănirilor":["zingănire"],"zină":["zină","zini"],"zine":["zini","zină"],"zina":["zină"],"zinei":["zină"],"zinele":["zină"],"zinelor":["zină"],"zingănit":["zingănit","zingăni"],"zingănituri":["zingănit"],"zingănitul":["zingănit"],"zingănitului":["zingănit"],"zingăniturile":["zingănit"],"zingăniturilor":["zingănit"],"zingănitu":["zingăni","zingănit"],"zingăte":["zingăt"],"zingătul":["zingăt"],"zingătului":["zingăt"],"zingătele":["zingăt"],"zingătelor":["zingăt"],"zinghenitori":["zinghenitor"],"zinghenitorul":["zinghenitor"],"zinghenitorului":["zinghenitor"],"zinghenitorii":["zinghenitor"],"zinghenitorilor":["zinghenitor"],"zinghenitoare":["zing