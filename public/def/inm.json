{"L":{"înmia":{"c":"verb","t":"Tranz. și refl. A (se) mări de o mie de ori; p. ext. a (se) înmulți, a spori (ceva) foarte mult. - În + mie.","s":"DEX '98"},"înmii":{"c":"verb","t":"Tranz. și refl. A (se) mări de o mie de ori; p. ext. a (se) înmulți, a spori (ceva) foarte mult. - În + mie.","s":"DEX '98"},"înmănușat":{"c":"adjectiv","t":"Care poartă mănuși; cu mănuși. - În + mănușă (după fr. ganté).","s":"DEX '98"},"înmărmuritor":{"c":"adjectiv","t":"(Rar) Care te lasă înmărmurit. - Înmărmuri + suf. -tor.","s":"DEX '98"},"înmugurit":{"c":"adjectiv","t":"Care a făcut muguri; mugurit, încăpușat. - V. înmuguri.","s":"DEX '98"},"înmuguri":{"c":"verb","t":"Intranz. A face muguri; a muguri, a încăpuși. ◊ Fig. (Despre idei, soluții etc.) A lua naștere, a prinde contur în mintea cuiva. - În + mugur.","s":"DEX '98"},"înmuietor":{"c":"substantiv neutru","t":"Vas în care se înmoaie cerealele înainte de a fi puse la încolțit. - Înmuia + suf. -ător.","s":"DEX '98"},"înmulțitor":{"c":"substantiv masculin","t":"Număr cu care se înmulțește alt număr; factor al operației de înmulțire aritmetică. - Înmulți + suf. -tor.","s":"DEX '98"},"înmurgi":{"c":"verb","t":"Intranz. și refl. impers. (Rar) A (se) însera. ♦ Loc. adv. Pe înmurgite = în amurg.","s":"DEX '98"},"înmurgit":{"c":"substantiv neutru","t":"(Rar) Amurg. - V. înmurgi.","s":"DEX '98"},"înmagazina":{"c":"verb","t":"Tranz. A pune, a așeza mărfuri, produse etc. într-o magazie (pentru a le păstra); a depozita. ◊ P. gener. (Adesea fig.) A aduna, a acumula (cunoștințe, învățătură, energie etc.).","s":"DEX '98"},"înmagazinare":{"c":"substantiv feminin","t":"Acțiunea de a înmagazina și rezultatul ei. - V. înmagazina.","s":"DEX '98"},"înmâna":{"c":"verb","t":"Tranz. A da, a remite, a preda în mână ceva cuiva. - În + mână.","s":"DEX '98"},"înmânat":{"c":"verb","t":"Tranz. A da, a remite, a preda în mână ceva cuiva. - În + mână.","s":"DEX '98"},"înmânare":{"c":"substantiv feminin","t":"Acțiunea de a înmâna; remitere, predare. - V. înmâna.","s":"DEX '98"},"înmănunchea":{"c":"verb","t":"1. Tranz. A strânge, a lega în mănunchi. 2. Refl. Fig. A se aduna la un loc. - În + mănunchi.","s":"DEX '98"},"înmănunchere":{"c":"substantiv feminin","t":"Faptul de a (se) înmănunchea. - V. înmănunchea.","s":"DEX '98"},"înmărmurit":{"c":"adjectiv","t":"Care a rămas nemișcat de frică, de groază, de uimire; înlemnit, încremenit. ◊ (În basme) Care a fost transformat în piatră. - V. înmărmuri.","s":"DEX '98"},"înmărmuri":{"c":"verb","t":"Intranz. și tranz. A rămâne sau a face să rămână încremenit de frică, de groază, de uimire; a înlemni, a încremeni, a împietri. ◊ (În basme) A (se) transforma în piatră. - În + marmură.","s":"DEX '98"},"înmărmurire":{"c":"substantiv feminin","t":"Faptul de a înmărmuri; încremenire, înlemnire, împietrire. - V. înmărmuri.","s":"DEX '98"},"înmatricula":{"c":"verb","t":"Tranz. și refl. A (se) înscrie, a (se) trece într-o matricolă; a matricula.","s":"DEX '98"},"înmiit":{"c":"adjectiv","t":"(Adesea adverbial) De o mie de ori mai mare sau mai mult; p. ext. foarte mare, foarte mult. - V. înmii.","s":"DEX '98"},"înmiire":{"c":"substantiv feminin","t":"(Rar) Acțiunea de a înmii și rezultatul ei. - V. înmii.","s":"DEX '98"},"înmiresma":{"c":"verb","t":"Tranz. A parfuma, a îmbălsăma, a miresma. - În + mireasmă.","s":"DEX '98"},"înmiresmat":{"c":"adjectiv","t":"Care produce sau conține o mireasmă; parfumat, frumos mirositor. - V. înmiresma.","s":"DEX '98"},"înmiresmare":{"c":"substantiv feminin","t":"(Rar) Miros plăcut, parfum. - V. înmiresma.","s":"DEX '98"},"înmlădia":{"c":"verb","t":"Refl. și tranz. A (se) mlădia. [Pr.: -di-a] - În + mlădia.","s":"DEX '98"},"înmlădiat":{"c":"verb","t":"Refl. și tranz. A (se) mlădia. [Pr.: -di-a] - În + mlădia.","s":"DEX '98"},"înmoina":{"c":"verb","t":"refl. impers. (Rar) A se mai încălzi vremea, a se face moină, a se moina. - În + moină.","s":"DEX '98"},"înmoinare":{"c":"verb","t":"refl. impers. (Rar) A se mai încălzi vremea, a se face moină, a se moina. - În + moină.","s":"DEX '98"},"înmormânta":{"c":"verb","t":"1. Tranz. A așeza un mort în mormânt; a îngropa, a înhuma, a astruca, a mormânta. 2. Tranz. și refl. Fig. A (se) îngropa (II 2). ◊ Tranz. A da ceva uitării. - În + mormânt.","s":"DEX '98"},"înmormântare":{"c":"substantiv feminin","t":"Ceremonia, ritualul așezării în mormânt; îngropare, înhumare, îngropăciune, mormântare. - V. înmormânta.","s":"DEX '98"},"înmugurire":{"c":"substantiv feminin","t":"Faptul de a înmuguri; mugurire. - V. înmuguri.","s":"DEX '98"},"înmuia":{"c":"verb","t":"1. Tranz. A băga, a introduce într-un lichid, a muia. ♦ Refl. Rufele s-au înmuiat. ◊ A uda, a umezi. ◊ Fig. (Rar) A împodobi cu cusături, cu broderii de mătase, de fir (aurit) etc. 2. Tranz. și refl. A face să devină sau a deveni mai moale, prin încălzire sau prin subțiere cu un lichid. ♦ Expr. A (i se) înmuia (cuiva) inima = a (se) înduioșa. ◊ Fig. A (se) potoli, a (se) calma; a (se) liniști. ◊ Refl. …","s":"DEX '98"},"înmuiere":{"c":"substantiv feminin","t":"Acțiunea de a (se) înmuia și rezultatul ei. - V. înmuia.","s":"DEX '98"},"înmulți":{"c":"verb","t":"Refl. și tranz. 1. A spori, a (se) mări în număr sau cantitativ. ◊ Tranz. A face operația înmulțirii; a multiplica. 2. A (se) mări prin reproducere numărul indivizilor din aceeași specie. - În + mult.","s":"DEX '98"},"înmulțire":{"c":"substantiv feminin","t":"Acțiunea de a (se) înmulți și rezultatul ei. ◊ Operație aritmetică fundamentală care constă din mărirea unui număr (deînmulțit) de atâtea ori cât alt număr (înmulțitorul), pentru obținerea unui rezultat numit produs; multiplicare. ♦ Tabla înmulțirii = tablou care conține produsele înmulțirii între ele a primelor zece numere. - V. înmulți.","s":"DEX '98"},"înmurgire":{"c":"verb","t":"Intranz. și refl. impers. (Rar) A (se) însera. ♦ Loc. adv. Pe înmurgite = în amurg.","s":"DEX '98"},"înmuiat":{"c":"adjectiv","t":"1. Introdus în apă sau în alt lichid; umezit, îmbibat cu un lichid. ◊ (Despre ochi) Înlăcrimat. 2. Devenit moale (prin încălzire sau prin adaos de lichid). ◊ Fig. Fără vlagă, fără putere. 3. Fig. (Despre oameni și stările lor sufletești) Potolit, calmat, liniștit; p. ext. îmblânzit. ◊ Înduioșat, mișcat. - V. înmuia.","s":"DEX '98"},"înmulțit":{"c":"adjectiv","t":"Sporit, mărit (numeric sau cantitativ). - V. înmulți.","s":"DEX '98"},"înmatriculare":{"c":"substantiv feminin","t":"Acțiunea de a (se) înmatricula; înscriere într-o matricolă. - V. înmatricula.","s":"DEX '98"},"înmlădiere":{"c":"substantiv feminin","t":"Acțiunea de a (se) înmlădia; mlădiere. [Pr.: -di-e-] - V. înmlădia.","s":"DEX '98"},"înmlădios":{"c":"adjectiv","t":"(Rar) Mlădios. [Pr.: -di-os] - În + mlădios.","s":"DEX '98"}},"F":{"înmiat":["înmia"],"înmiați":["înmia","înmii"],"înmiere":["înmia"],"înmănușați":["înmănușat"],"înmănușatul":["înmănușat"],"înmănușatului":["înmănușat"],"înmănușații":["înmănușat"],"înmănușaților":["înmănușat"],"înmănușată":["înmănușat"],"înmănușate":["înmănușat"],"înmănușata":["înmănușat"],"înmănușatei":["înmănușat"],"înmănușatele":["înmănușat"],"înmănușatelor":["înmănușat"],"înmănușatu":["înmănușat"],"înmărmuritori":["înmărmuritor"],"înmărmuritorul":["înmărmuritor"],"înmărmuritorului":["înmărmuritor"],"înmărmuritorii":["înmărmuritor"],"înmărmuritorilor":["înmărmuritor"],"înmărmuritoare":["înmărmuritor"],"înmărmuritoarea":["înmărmuritor"],"înmărmuritoarei":["înmărmuritor"],"înmărmuritoarele":["înmărmuritor"],"înmărmuritoarelor":["înmărmuritor"],"înmugurit":["înmugurit","înmuguri"],"înmuguriți":["înmugurit"],"înmuguritul":["înmugurit"],"înmuguritului":["înmugurit"],"înmuguriții":["înmugurit"],"înmuguriților":["înmugurit"],"înmugurită":["înmugurit"],"înmugurite":["înmugurit"],"înmugurita":["înmugurit"],"înmuguritei":["înmugurit"],"înmuguritele":["înmugurit"],"înmuguritelor":["înmugurit"],"înmuguritu":["înmuguri","înmugurit"],"înmuietoare":["înmuietor"],"înmuietorul":["înmuietor"],"înmuietorului":["înmuietor"],"înmuietoarele":["înmuietor"],"înmuietoarelor":["înmuietor"],"înmulțitori":["înmulțit