{"L":{"cimentare":{"c":"substantiv feminin","t":"Acțiunea de a (se) cimenta. - V. cimenta.","s":"DEX '98"},"cimenta":{"c":"verb","t":"Tranz. 1. A trata termochimic oțelurile moi sau aliate, introducând carbon, crom, azot etc. în stratul lor superficial, pentru a obține un strat dur cu mare rezistentă la uzură. 2. (Med.) A obtura canalul unui dinte cu cement. 3. (Med.) A fixa cu cement protezele pe dinți.","s":"DEX '98"},"cimili":{"c":"verb","t":"Intranz. (Reg.) A spune, a face sau a interpreta cimilituri.","s":"DEX '98"},"cimază":{"c":"substantiv feminin","t":"(Arh.) Chenar ornamental de-a lungul unei fațade.","s":"DEX '98"},"cimă":{"c":"substantiv feminin","t":"Tip de inflorescență în care axul principal poartă în vârf o singură floare.","s":"DEX '98"},"cimel":{"c":"interjecție","t":"(Adesea repetat) Formulă cu care încep unele ghicitori.","s":"DEX '98"},"cimbistră":{"c":"substantiv feminin","t":"(Rar) Pensetă (pentru smuls părul).","s":"DEX '98"},"cimpoaie":{"c":"substantiv neutru","t":"Instrument muzical popular, alcătuit dintr-un burduf de piele și din mai multe tuburi sonore prin care trece aerul din burduf.","s":"DEX '98"},"cimpoi":{"c":"substantiv neutru","t":"Instrument muzical popular, alcătuit dintr-un burduf de piele și din mai multe tuburi sonore prin care trece aerul din burduf.","s":"DEX '98"},"cim":{"c":"substantiv neutru","t":"(Înv. și reg.) Luntre mică (pescărească).","s":"DEX '98"},"cimbal":{"c":"substantiv neutru","t":"Chimval.","s":"DEX '98"},"cimișir":{"c":"substantiv masculin","t":"Arbust decorativ cu frunze ovale și persistente, cu flori galbene-verzui (Buxus sempervirens).","s":"DEX '98"},"cimitir":{"c":"substantiv neutru","t":"Teren (îngrădit) unde se îngroapă morții; țintirim","s":"DEX '98"},"cimpanzeu":{"c":"substantiv masculin","t":"Specie de maimuță mare, antropomorfă, cu membrele anterioare lungi, cu blana și pielea neagră (Pan troglodytes)","s":"DEX '98"},"cimilitură":{"c":"substantiv feminin","t":"(Pop.) Ghicitoare. - Cimili + suf. -tură.","s":"DEX '98"},"cimpoiaș":{"c":"substantiv masculin","t":"Cimpoier. [Pr.: -po-iaș] - Cimpoi + suf. -aș.","s":"DEX '98"},"cimpoier":{"c":"substantiv masculin","t":"Persoană care cântă din cimpoi; cimpoiaș. [Pr.: -po-ier] - Cimpoi + suf. -ar.","s":"DEX '98"},"cimbalist":{"c":"substantiv masculin și feminin","t":"Persoană care acompaniază la cimbal.","s":"DEX '98"},"cimbalistă":{"c":"substantiv masculin și feminin","t":"Persoană care acompaniază la cimbal.","s":"DEX '98"},"cimen":{"c":"substantiv neutru","t":"Lichid cu miros aromatic, care se găsește în uleiurile eterice izolate din diferite plante, din rășina coniferelor și din unele petroluri.","s":"DEX '98"},"cimentist":{"c":"substantiv masculin și feminin","t":"Muncitor într-o fabrică de ciment. - Ciment + suf. -ist.","s":"DEX '98"},"cimentistă":{"c":"substantiv masculin și feminin","t":"Muncitor într-o fabrică de ciment. - Ciment + suf. -ist.","s":"DEX '98"},"cimentometru":{"c":"substantiv neutru","t":"Aparat pentru determinarea modului de distribuire a cimentului în spațiul dintre coloana unei sonde și teren. - Ciment + metru (după apometru, gazometru etc.).","s":"DEX '98"},"cimerian":{"c":"substantiv masculin","t":"pl. Populație de origine tracă, migrată în antichitate din nordul Mării Negre în Asia Mică. [Pr.: -ri-eni]","s":"DEX '98"},"cimotie":{"c":"substantiv feminin","t":"(Reg.) Rudă, neam.","s":"DEX '98"},"ciment":{"c":"substantiv neutru","t":"Material de construcție în formă de pulbere fină, obținut prin măcinarea clincherului și care, în contact cu apa, face priză și se întărește. [Acc. și ciment]","s":"DEX '98"},"cimbru":{"c":"substantiv masculin","t":"Plantă erbacee cu flori liliachii sau albe punctate cu roșu, cu frunze înguste și ascuțite, aromate, folosite drept condiment (Satureja hortensis).","s":"DEX '98"},"cimbrișor":{"c":"substantiv masculin","t":"Plantă erbacee cu flori roșii-purpurii sau albe și cu frunze aromate, folosite în medicină pentru infuzie (Thymus vulgaris). - Cimbru + suf. -iș