{"L":{"nedeie":{"c":"substantiv feminin","t":"1. Petrecere câmpenească populară de origine pastorală organizată de obicei cu prilejul unei sărbători sau al unui hram. 2. Loc (plan) pe vârful unui munte. [Pl. și: nedeie]","s":"DEX '98"},"nedeterminare":{"c":"substantiv feminin","t":"1. (Mat.) Imposibilitate de a putea afla în mod unic valorile necunoscutelor care intră într-o problemă. 2. Lipsă de determinare; indeterminare. ◊ Situație incertă, neclară. - Ne- + determinare.","s":"DEX '98"},"nedelicateță":{"c":"substantiv feminin","t":"Lipsă de delicatețe; gest, atitudine sau vorbă lipsită de delicatețe; impolitețe, indelicatețe. - Ne- + delicatețe (după fr. indélicatesse).","s":"DEX '98"},"nedelicatețe":{"c":"substantiv feminin","t":"Lipsă de delicatețe; gest, atitudine sau vorbă lipsită de delicatețe; impolitețe, indelicatețe. - Ne- + delicatețe (după fr. indélicatesse).","s":"DEX '98"},"nedesăvârșire":{"c":"substantiv feminin","t":"(Rar) Imperfecțiune, scădere, lipsă, cusur. - Ne- + desăvârșire.","s":"DEX '98"},"nedreptăți":{"c":"verb","t":"Tranz. A trata pe cineva în chip nedrept, a(-i) face cuiva o nedreptate.","s":"DEX '98"},"nedumeri":{"c":"verb","t":"Tranz. A face să fie nedumerit, să nu înțeleagă ceva, a pune pe cineva în încurcătură; a mira. [Var.: nedumiri vb. IV]","s":"DEX '98"},"nedumerire":{"c":"substantiv feminin","t":"Starea celui nedumerit; mirare; încurcătură. - Ne- + dumerire.","s":"DEX '98"},"nedumirire":{"c":"verb","t":"IV v. nedumeri.","s":"DEX '98"},"nedumiri":{"c":"verb","t":"Tranz. A face să fie nedumerit, să nu înțeleagă ceva, a pune pe cineva în încurcătură; a mira. [Var.: nedumiri vb. IV]","s":"DEX '98"},"nedecapotabil":{"c":"adjectiv","t":"(Despre automobile) La care capota nu se poate strânge sau ridica după necesitate. - Ne- + decapotabil.","s":"DEX '98"},"nedecolorat":{"c":"adjectiv","t":"1. Care nu și-a pierdut total sau parțial culoarea. 2. Care și-a păstrat culoarea inițială. - Ne- + decolorat.","s":"DEX '98"},"nedefinibil":{"c":"adjectiv","t":"Care nu poate fi definit, care nu se poate explica; nedeterminat, neprecis, nelămurit, indefinibil. - Ne- + definibil.","s":"DEX '98"},"nedefinit":{"c":"adjectiv","t":"1. Care nu este definit; lipsit de contur sau de precizie; vag. 2. (Gram.; despre articole, adjective, pronume, numerale) Nehotărât. 3. ♦ (Mat.; în sintagma) Integrală nedefinită (a unei funcții) = funcție a cărei derivată este funcția dată. - Ne- + definit (după fr. indéfini).","s":"DEX '98"},"nedeformabil":{"c":"adjectiv","t":"(Despre corpuri) Care nu se poate deforma; (rar) indeformabil. - Ne- + deformabil.","s":"DEX '98"},"nedefrișabil":{"c":"adjectiv","t":"(Rar) Indefrișabil. - Ne- + defrișabil.","s":"DEX '98"},"nedelicat":{"c":"adjectiv","t":"Lipsit de delicatețe; (rar) indelicat. - Ne- + delicat.","s":"DEX '98"},"nedemn":{"c":"adjectiv","t":"Care nu este demn, nu este la înălțimea așteptată; nevrednic. - Ne- + demn (după fr. indigne).","s":"DEX '98"},"nedemonstrabil":{"c":"adjectiv","t":"Care nu poate fi demonstrat, dovedit; (rar) indemonstrabil. - Ne- + demonstrabil.","s":"DEX '98"},"nedemontabil":{"c":"adjectiv","t":"Care nu poate fi demontat; care nu este făcut pentru a fi demontat. - Ne- + demontabil.","s":"DEX '98"},"nedepănușat":{"c":"adjectiv","t":"(Despre știuleți de porumb) Care nu este desfăcut de pănuși. - Ne- + depănușat.","s":"DEX '98"},"nedescifrabil":{"c":"adjectiv","t":"(Despre un text sau despre scrisul cuiva) Care nu se poate descifra; de neînțeles, indescifrabil, neciteț, ilizibil. - Ne- + descifrabil.","s":"DEX '98"},"nedeșirabil":{"c":"adjectiv","t":"(Despre țesături, tricotaje etc.) Care nu se poate deșira (ușor); indeșirabil (1). - Ne- + deșirabil.","s":"DEX '98"},"nedeslușit":{"c":"adjectiv","t":"Care nu este deslușit, clar, care nu se poate distinge (precis); lipsit de claritate, greu de înțeles; nelămurit, confuz. ◊ (Adverbial ) în mod neclar, cu contururi vagi. - Ne- + deslușit.","s":"DEX '98"},"nedespărțit":{"c":"adjectiv","t":"Care nu este despărțit sau fragmentat, care nu poate fi despărțit, indivizibil; care sau de care nu se desparte, nu se îndepărtează niciodată, inseparabil. - Ne- + despărțit.","s":"DEX '98"},"nedeterminabil":{"c":"adjectiv","t":"Care nu poate fi determinat; indeterminabil. - Ne- + determinabil.","s":"DEX '98"},"nedeterminat":{"c":"adjectiv","t":"Care nu este precizat, stabilit; care nu este definit sau cunoscut cu precizie. - Ne- + determinat.","s":"DEX '98"},"nedezinfectat":{"c":"adjectiv","t":"Care nu a fost dezinfectat. - Ne- + dezinfectat.","s":"DEX '98"},"nedezlegat":{"c":"adjectiv","t":"1. Care nu a fost desfăcut din legături. 2. Fig. A cărui rezolvare, explicație nu este găsită. - Ne- + dezlegat.","s":"DEX '98"},"nedezlipit":{"c":"adjectiv","t":"Care nu este sau nu poate fi dezlipit sau despărțit; care este nelipsit (de undeva). - Ne- + dezlipit.","s":"DEX '98"},"nedezmințit":{"c":"adjectiv","t":"Care nu se dezminte (niciodată); consecvent. - Ne- + dezmințit.","s":"DEX '98"},"nedisciplinat":{"c":"adjectiv","t":"Care nu se supune ordinii și disciplinei, care manifestă spirit de indisciplină; indisciplinat, nesupus. - Ne- + disciplinat.","s":"DEX '98"},"nedisimulat":{"c":"adjectiv","t":"Care nu este disimulat; lipsit de ipocrizie. - Ne- + disimulat.","s":"DEX '98"},"nedispus":{"c":"adjectiv","t":"Care nu este bine dispus, care este supărat, mâhnit. - Ne- + dispus.","s":"DEX '98"},"nedistribuit":{"c":"adjectiv","t":"Care nu este distribuit. [Pr.: -bu-it] - Ne- + distribuit.","s":"DEX '98"},"nedivizat":{"c":"adjectiv","t":"Care nu este divizat, împărțit. - Ne- + divizat.","s":"DEX '98"},"nedivizibil":{"c":"adjectiv","t":"Care nu este divizibil, care nu poate fi divizat, împărțit; indivizibil. - Ne- + divizibil.","s":"DEX '98"},"nedizolvat":{"c":"adjectiv","t":"(Despre substanțe) Care nu este dizolvat. - Ne- + dizolvat.","s":"DEX '98"},"nedomolit":{"c":"adjectiv","t":"Care nu este sau nu poate fi domolit; nepotolit; neastâmpărat. - Ne- + domolit.","s":"DEX '98"},"nedorit":{"c":"adjectiv","t":"Care nu este dorit; indezirabil. - Ne- + dorit.","s":"DEX '98"},"nedormit":{"c":"adjectiv","t":"(Despre oameni) Care nu a dormit (destul sau deloc). ◊ (Despre timpul destinat somnului) Petrecut fără somn. - Ne- + dormit.","s":"DEX '98"},"nedospit":{"c":"adjectiv","t":"(Despre aluat) Care nu a dospit (1). ◊ (Despre alimente și despre unele materii organice) Care nu a fermentat. - Ne- + dospit.","s":"DEX '98"},"nedureros":{"c":"adjectiv","t":"Care nu provoacă sau exprimă durere (fizică ori morală). ◊ (Adverbial) Fără durere. - Ne- + dureros.","s":"DEX '98"},"nedreptățit":{"c":"adjectiv","t":"Căruia i s-a făcut o nedreptate. - V. nedreptăți.","s":"DEX '98"},"nedumirit":{"c":"adjectiv","t":"Care nu este dumerit, lămurit; care este mirat, încurcat în fața unui fapt, a unui lucru etc.; neașteptat, neclar. [Var.: nedumirit, -ă adj. ] - Ne- + dumerit.","s":"DEX '98"},"nedumerit":{"c":"adjectiv","t":"Care nu este dumerit, lămurit; care este mirat, încurcat în fața unui fapt, a unui lucru etc.; neașteptat, neclar. [Var.: nedumirit, -ă adj. ] - Ne- + dumerit.","s":"DEX '98"},"neder":{"c":"substantiv masculin","t":"(Reg.) Om nătâng; om zăpăcit, nebun.","s":"DEX '98"},"nediseminare":{"c":"substantiv feminin","t":"Nerăspândire, nepropagare. - Ne- + diseminare.","s":"DEX '98"},"nedeclinabil":{"c":"adjectiv","t":"(Gram.) Care nu se declină (1); indeclinabil. - Ne- + declinabil.","s":"DEX '98"},"nediferențiat":{"c":"adjectiv","t":"Care nu se deosebește, nu se distinge cu nimic (de altceva sau de altcineva). [Pr.: -ți-at] - Ne- + diferențiat.","s":"DEX '98"},"nedrept":{"c":"adjectiv","t":"1. (Adesea adverbial) Care nu este drept, obiectiv cu cei din jur; care nu este conform cu dreptatea, cu normele stabilite; incorect, ilegal; abuziv. ♦ Loc. adv. Pe nedrept sau (substantivat) pe nedreptul = în mod silnic, samavolnic; în mod neîntemeiat, fără temei. 2. (Înv.; gram.; despre complemente sau propoziții completive) Indirect. - Ne- + drept.","s":"DEX '98"},"nedreptate":{"c":"substantiv