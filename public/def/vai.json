{"L":{"văicăra":{"c":"verb","t":"Refl. (Pop. și fam.) A se tângui, a se văita, a se căina. ◊ (Peior.) A manifesta o falsă desperare. [Var.: (reg.) văicăra vb. I]","s":"DEX '98"},"văicărare":{"c":"verb","t":"I v. văicări.","s":"DEX '98"},"văicărire":{"c":"verb","t":"Refl. (Pop. și fam.) A se tângui, a se văita, a se căina. ◊ (Peior.) A manifesta o falsă desperare. [Var.: (reg.) văicăra vb. I]","s":"DEX '98"},"văicări":{"c":"verb","t":"Refl. (Pop. și fam.) A se tângui, a se văita, a se căina. ◊ (Peior.) A manifesta o falsă desperare. [Var.: (reg.) văicăra vb. I]","s":"DEX '98"},"văioagă":{"c":"substantiv feminin","t":"(Reg.) Vale mică, îngustă și puțin adâncă. [Pr.: vă-iu-] - Vale + suf. -ugă.","s":"DEX '98"},"văicăreală":{"c":"substantiv feminin","t":"(Pop. și fam.) Faptul de a se văicări; zgomot făcut de cel care se văicărește; tânguire, lamentare, plânset. - Văicări + suf. -eală.","s":"DEX '98"},"văiera":{"c":"verb","t":"Refl. (Reg.) A se văita. [Pr.: vă-ie-]","s":"DEX '98"},"văierare":{"c":"substantiv feminin","t":"(Reg.) Faptul de a se văiera; vaiet. [Pr.: vă-ie-] - V. văiera.","s":"DEX '98"},"văișoară":{"c":"substantiv feminin","t":"Vălicică. [Var.: văișoară s. f.] - Vale + suf. -ișoară.","s":"DEX '98"},"văieta":{"c":"verb","t":"Refl. A scoate vaiete, a geme de durere, de jale; a se tângui, a se lamenta, a se văiera. ◊ (Despre animale) A scoate sunete sinistre, lugubre. ◊ Tranz. A plânge, a compătimi pe cineva. ◊ Refl. A-și exprima (în cuvinte) necazul, nemulțumirea, durerea. [Var.: văieta vb. I]","s":"DEX '98"},"văietare":{"c":"substantiv feminin","t":"Faptul de a (se) văita; strigăt de suferință; lamentare; vaiet, văitătură. [Var.: văietare s. f.] - V. văita.","s":"DEX '98"},"văiugă":{"c":"substantiv feminin","t":"(Reg.) Vale mică, îngustă și puțin adâncă. [Pr.: vă-iu-] - Vale + suf. -ugă.","s":"DEX '98"},"vaicăr":{"c":"substantiv neutru","t":"(Reg.) Faptul de a se văicări; strigăt intens de durere; tânguire.","s":"DEX '98"},"văicăreț":{"c":"adjectiv","t":"(Po