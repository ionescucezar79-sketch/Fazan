{"L":{"hirotonie":{"c":"substantiv feminin","t":"Hirotonisire.","s":"DEX '96"},"hirotoni":{"c":"verb","t":"Tranz. A hirotonisi.","s":"DEX '96"},"hirudinizare":{"c":"substantiv feminin","t":"Aplicare de lipitori pe corp în scop terapeutic.","s":"DEX '96"},"hiritisire":{"c":"verb","t":"IV V. hiritisi.","s":"DEX '96"},"hiritisi":{"c":"verb","t":"IV V. hiritisi.","s":"DEX '96"},"hirotonire":{"c":"substantiv feminin","t":"Acțiunea de a hirotoni și rezultatul ei; hirotonisire, hirotonie. - V. hirotoni.","s":"DEX '96"},"hirotonisire":{"c":"substantiv feminin","t":"Acțiunea de a hirotonisi și rezultatul ei; hirotonie, hirotonire. - V. hirotonisi.","s":"DEX '96"},"hirotonisi":{"c":"verb","t":"Tranz. A ridica un diacon la rangul de preot; p. ext. a face pe cineva diacon, arhiereu etc. după canoanele bisericii creștine; a hirotoni. [Var.: hirotonosi vb. IV.]","s":"DEX '96"},"hirotonosi":{"c":"verb","t":"Tranz. A ridica un diacon la rangul de preot; p. ext. a face pe cineva diacon, arhiereu etc. după canoanele bisericii creștine; a hirotoni. [Var.: hirotonosi vb. IV.]","s":"DEX '96"},"hirotonosire":{"c":"verb","t":"IV V. hirotonisi.","s":"DEX '96"},"hirtă":{"c":"substantiv feminin","t":"(Reg.) Unitate de măsură pentru suprafețe, egală cu un sfert de pogon.","s":"DEX '96"},"hirsut":{"c":"adjectiv","t":"1. Cu părul și cu barba neîngrijite. 2. Aspru, grosolan. ◊ Posac, ursuz, taciturn. 3. (Bot.; despre un organ) Prevăzut cu peri lungi, rigizi; hispid.","s":"DEX '96"},"hiritiseală":{"c":"substantiv feminin","t":"(Înv.) Felicitare adresată cuiva; p. ext. petrecere la care se aduc cuiva felicitări. [Var.: firitiseală s. f.] - Hiritisi + suf. -eală.","s":"DEX '96"},"hirurgie":{"c":"substantiv feminin","t":"Ramură a medicinei care tratează bolile cu ajutorul operațiilor. ♦ Mică chirurgie = parte a chirurgiei consacrată intervențiilor chirurgicale mai ușoare, care nu impun spitalizare. Chirurgie genetică = transplant de gene. [Var.: (înv.) hirurgie s. f.]","s":"DEX '96"},"hirurg":{"c":"