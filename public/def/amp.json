{"L":{"ampelidacee":{"c":"substantiv feminin","t":"Familie de plante dicotiledonate având ca tip vița de vie.","s":"DEX '98"},"ampolozitate":{"c":"substantiv feminin","t":"(Italienism) Emfază.","s":"DEX '98"},"amplasare":{"c":"substantiv feminin","t":"Faptul de a amplasa. - V. amplasa.","s":"DEX '98"},"amplasa":{"c":"verb","t":"Tranz. A așeza, a fixa o mașină, o instalație etc. pe un anumit loc.","s":"DEX '98"},"amplifica":{"c":"verb","t":"Tranz. și refl. A da sau a căpăta amploare, a (se) mări, a (se) lărgi, a (se) dezvolta (din punct de vedere cantitativ, intensiv etc.)","s":"DEX '98"},"amplificare":{"c":"substantiv feminin","t":"Acțiunea de a (se) amplifica; mărire, dezvoltare. - V. amplifica.","s":"DEX '98"},"amputa":{"c":"verb","t":"Tranz. A tăia pe cale chirurgicală (sau a pierde accidental) un membru al corpului sau un segment de membru. ◊ Fig. A elimina o parte dintr-o operă, dintr-un discurs etc.","s":"DEX '98"},"amputare":{"c":"substantiv feminin","t":"Acțiunea de a amputa; amputație. - V. amputa.","s":"DEX '98"},"amperspiră":{"c":"substantiv feminin","t":"Unitate de măsură pentru tensiunea magnetomotoare și pentru solenație. - Amper + spiră.","s":"DEX '98"},"amprentă":{"c":"substantiv feminin","t":"Imagine a unui obiect întipărită prin presare pe o suprafață (plastică). ♦ Amprente digitale = urme lăsate de degete pe o suprafață și care servesc la identificarea autorului unei infracțiuni. Amprentă vocală = ansamblu al particularităților vocale specifice unui individ. ◊ Fig. Urmă lasată de o idee, de o stare psihică etc.","s":"DEX '98"},"ampriză":{"c":"substantiv feminin","t":"Lățime a fâșiei de teren pe care urmează să se construiască o șosea, o cale ferată, un dig etc.","s":"DEX '98"},"ampulă":{"c":"substantiv feminin","t":"1. Organ de mers al echinodermelor. 2. Fiolă, flacon. 3. (Rar) Globul de sticlă al unui bec.","s":"DEX '98"},"amplexicaul":{"c":"adjectiv","t":"(Bot.; despre frunze) Care îmbrățișează tulpina.","s":"DEX '98"},"ampelografic":{"c":"adjec