{"L":{"migală":{"c":"substantiv feminin","t":"Minuțiozitate și scrupulozitate în efectuarea unei munci; muncă făcută cu multă răbdare și meticulozitate; migăleală.","s":"DEX '98"},"migăire":{"c":"substantiv feminin","t":"Acțiunea de a migăli. - V. migăli.","s":"DEX '98"},"migăi":{"c":"verb","t":"Tranz. și intranz. A lucra cu răbdare și cu minuțiozitate; a bunghini. ◊ A lucra fără spor. [Var.: migăi vb. IV]","s":"DEX '98"},"migălire":{"c":"substantiv feminin","t":"Acțiunea de a migăli. - V. migăli.","s":"DEX '98"},"migăli":{"c":"verb","t":"Tranz. și intranz. A lucra cu răbdare și cu minuțiozitate; a bunghini. ◊ A lucra fără spor. [Var.: migăi vb. IV]","s":"DEX '98"},"miglisi":{"c":"verb","t":"Tranz. (Reg.) A înșela pe cineva (cu promisiuni, lingușeli etc.); a măguli, a linguși.","s":"DEX '98"},"migdală":{"c":"substantiv feminin","t":"Fruct al migdalului, de formă alungită, al cărui sâmbure, cu gust dulce sau amar, este comestibil; p. restr. sâmburele acestui fruct. - Migdal + suf. -ă.","s":"DEX '98"},"migmatită":{"c":"substantiv neutru","t":"Rocă metamorfică provenită prin pătrunderea magmei granitice în rocile sedimentare. [Var.: migmatită s. f.]","s":"DEX '98"},"migmatit":{"c":"substantiv neutru","t":"Rocă metamorfică provenită prin pătrunderea magmei granitice în rocile sedimentare. [Var.: migmatită s. f.]","s":"DEX '98"},"migmă":{"c":"substantiv feminin","t":"(Înv.) Amestec de liant, agregat mărunt și apă, asemănător mortarului, în care se pune cărămidă pisată și care este folosit în zidărie.","s":"DEX '98"},"migăleală":{"c":"substantiv feminin","t":"Migală. - Migăli + suf. -eală.","s":"DEX '98"},"migălos":{"c":"adjectiv","t":"1. Care lucrează cu migală. 2. Care cere migală, făcut cu migală. - Migală + suf. -os.","s":"DEX '98"},"migdal":{"c":"substantiv masculin","t":"Pom fructifer mediteranean, din familia rozaceelor, cu frunze lanceolate sau îngust-ovale, cu flori albe sau trandafirii și cu fructe comestibile (Amygdalus communis).","s":"DEX '98"},"migdalat":{"c":"adjectiv","t":"(Despre ochi) Ca migdala, de forma migdalei; alungit, codat. - Migdală + suf. -at.","s":"DEX '98"},"migra":{"c":"verb","t":"Intranz. 1. (Despre populații) A se deplasa în masă dintr-o regiune în alta, dintr-o țară în alta. ◊ (Despre animale, mai ales despre păsări și pești) A se muta în masă din unele ținuturi în altele, în anumite epoci ale anului, în vederea reproducerii, în căutarea unor condiții mai bune de trai etc. 2. P. anal. …","s":"DEX '98"},"migrație":{"c":"substantiv feminin","t":"1. Deplasare în masă a unor triburi sau a unor populații de pe un teritoriu pe altul, determinată de factori economici, sociali, politici sau naturali; migrare. 2. Deplasare în masă a unor animale dintr-o regiune într-alta, în vederea reproducerii, a căutării de hrană etc.; migrare. 3. …","s":"DEX '98"},"migăit":{"c":"adjectiv","t":"Lucrat cu migală. - V. migăli.","s":"DEX '98"},"migălit":{"c":"adjectiv","t":"Lucrat cu migală. - V. migăli.","s":"DEX '98"},"migălitură":{"c":"substantiv feminin","t":"Lucru executat cu migală. - Migăli + suf. -tură.","s":"DEX '98"},"migrator":{"c":"adjectiv","t":"Care migrează; călător.","s":"DEX '98"},"mignon":{"c":"adjectiv","t":"(Franțuzism; adesea substantivat) Micuț; drăguț, delicat. [Pr.: -nion]","s":"DEX '98"},"migrare":{"c":"substantiv feminin","t":"Acțiunea de a migra și rezultatul ei; migrațiune. - V. migra.","s":"DEX '98"},"migrațiune":{"c":"substantiv feminin","t":"1. Deplasare în masă a unor triburi sau a unor populații de pe un teritoriu pe altul, determinată de factori economici, sociali, politici sau naturali; migrare. 2. Deplasare în masă a unor animale dintr-o regiune într-alta, în vederea reproducerii, a căutării de hrană etc.; migrare. 3. …","s":"DEX '98"},"migrenă":{"c":"substantiv feminin","t":"Durere de cap intensă, de obicei pe o singură parte, însoțită de greață, de vărsături etc.","s":"DEX '98"}},"F":{"migala":["migală"],"migale":["migală"],"migalei":["migală"],"migalele":["migală"],"migalelor":["migală"]