{"L":{"zăvorî":{"c":"verb","t":"1. Tranz. și refl. A (se) încuia cu zăvorul. ◊ Tranz. A bloca intenționat, cu ajutorul unui zăvor, deplasarea unui obiect sau a unei piese dintr-un ansamblu față de un alt obiect sau față de o altă piesă. ◊ Tranz. A închide, a întemnița pe cineva. 2. Tranz. (Pop.) A lega pe cineva în cătușe, în fiare [Var.: zăvori vb. IV]","s":"DEX '98"},"zăvorâre":{"c":"substantiv feminin","t":"Acțiunea de a (se) zăvorî și rezultatul ei; închidere (cu zăvorul). - V. zăvorî.","s":"DEX '98"},"zaveră":{"c":"substantiv feminin","t":"(Înv. și reg.) Nume dat răscoalei organizate de greci în 1821 împotriva stăpânirii turcești (cu ramificație și în țările românești); p. gener. revoltă, răscoală, răzvrătire.","s":"DEX '98"},"zăvăcustă":{"c":"substantiv feminin","t":"Plantă erbacee cu flori galbene dispuse în spice (Astragalus dasyanthus).","s":"DEX '98"},"zăvelcuță":{"c":"substantiv feminin","t":"Diminutiv al lui zăvelcă. - Zăvelcă + suf. -uță.","s":"DEX '98"},"zăvelcă":{"c":"substantiv feminin","t":"Fiecare dintre cele două fote dreptunghiulare, cu dungi sau brodate cu flori, care se poartă una în față și alta în spate, ca fustă. [Var.: zavelcă, zevelcă, zivelcă, zovelcă, zuvelcă s. f.]","s":"DEX '98"},"zavelcă":{"c":"substantiv feminin","t":"Fiecare dintre cele două fote dreptunghiulare, cu dungi sau brodate cu flori, care se poartă una în față și alta în spate, ca fustă. [Var.: zavelcă, zevelcă, zivelcă, zovelcă, zuvelcă s. f.]","s":"DEX '98"},"zaverisi":{"c":"verb","t":"Refl. (Înv.) A se răzvrăti. - Zavergiu + suf. -isi.","s":"DEX '98"},"zaverisire":{"c":"verb","t":"Refl. (Înv.) A se răzvrăti. - Zavergiu + suf. -isi.","s":"DEX '98"},"zavescă":{"c":"substantiv feminin","t":"(Înv.) Taxă specială plătită vistieriei în evul mediu, în Moldova, pentru redeschiderea unui proces.","s":"DEX '98"},"zaveză":{"c":"substantiv feminin","t":"(Înv.) 1. Perdea. 2. Covor care se pune pe perete; scoarță.","s":"DEX '98"},"zăvadă":{"c":"substantiv feminin","t":"(Înv.) 1. Perdea. 2. Covor care se pune pe perete; scoarță.","s":"DEX '98"},"zăvează":{"c":"substantiv feminin","t":"(Înv.) 1. Perdea. 2. Covor care se pune pe perete; scoarță.","s":"DEX '98"},"zavistiire":{"c":"verb","t":"Tranz. (Înv.) A invidia, a pizmui. ◊ Intranz. A face sau a băga intrigi. [Var.: zavistii vb. IV]","s":"DEX '98"},"zavistii":{"c":"verb","t":"Tranz. (Înv.) A invidia, a pizmui. ◊ Intranz. A face sau a băga intrigi. [Var.: zavistii vb. IV]","s":"DEX '98"},"zăvorire":{"c":"verb","t":"IV v. zăvorî.","s":"DEX '98"},"zăvori":{"c":"verb","t":"1. Tranz. și refl. A (se) încuia cu zăvorul. ◊ Tranz. A bloca intenționat, cu ajutorul unui zăvor, deplasarea unui obiect sau a unei piese dintr-un ansamblu față de un alt obiect sau față de o altă piesă. ◊ Tranz. A închide, a întemnița pe cineva. 2. Tranz. (Pop.) A lega pe cineva în cătușe, în fiare [Var.: zăvori vb. IV]","s":"DEX '98"},"zăvod":{"c":"substantiv neutru","t":"(Reg.) Așezare temporară de pescari, organizată în vederea pescuitului; totalitatea instalațiilor și a uneltelor acestei așezări.","s":"DEX '98"},"zăveasă":{"c":"substantiv feminin","t":"(Înv.) 1. Perdea. 2. Covor care se pune pe perete; scoarță.","s":"DEX '98"},"zavistuire":{"c":"verb","t":"Tranz. (Înv.) A invidia, a pizmui. ◊ Intranz. A face sau a băga intrigi. [Var.: zavistii vb. IV]","s":"DEX '98"},"zavistui":{"c":"verb","t":"Tranz. (Înv.) A invidia, a pizmui. ◊ Intranz. A face sau a băga intrigi. [Var.: zavistii vb. IV]","s":"DEX '98"},"zavisti":{"c":"verb","t":"Tranz. (Înv.) A invidia, a pizmui. ◊ Intranz. A face sau a băga intrigi. [Var.: zavistii vb. IV]","s":"DEX '98"},"zavergisi":{"c":"verb","t":"Refl. (Înv.) A se răzvrăti. - Zavergiu + suf. -isi.","s":"DEX '98"},"zaveasă":{"c":"substantiv feminin","t":"(Înv.) 1. Perdea. 2. Covor care se pune pe perete; scoarță.","s":"DEX '98"},"zavod":{"c":"substantiv masculin","t":"Câine mare (ciobănesc); dulău.","s":"DEX '98"},"zavergiu":{"c":"substantiv masculin","t":"Revoluționar grec din 1821: p. gener. răsculat, răzvrătit. - Zaveră + suf. -giu.","s":"DEX '98"},"zavistic":{"c":"adjectiv","t":"(Înv.) Invidios, pizmaș, intrigant, zavistuitor. [Var.: zavistic, -ă adj.]","s":"DEX '98"},"zăvoi":{"c":"substantiv neutru","t":"Pădurice pe malul unei ape; luncă.","s":"DEX '98"},"zăvor":{"c":"substantiv neutru","t":"1. Încuietoare la uși, uneori și la ferestre, constând dintr-o mică bară mobilă care intră într-o ureche fixată în toc; ivăr. 2. Dispozitiv folosit pentru blocarea mecanică, comandată sau automată, a unuia dintre organele mobile principale ale unui aparat, ale unei mașini etc. 3. (Pop.; la pl.) Cătușe, fiare. 4. (Reg.) Despicătură lungă din trunchiul unui copac; leaț întrebuințat la facerea gardurilor; răzlog.","s":"DEX '98"},"zăvoraș":{"c":"substantiv neutru","t":"Diminutiv al lui zăvor (1). - Zăvor + suf. -aș.","s":"DEX '98"},"zavistiit":{"c":"verb","t":"Tranz. (Înv.) A invidia, a pizmui. ◊ Intranz. A face sau a băga intrigi. [Var.: zavistii vb. IV]","s":"DEX '98"},"zavistuit":{"c":"verb","t":"Tranz. (Înv.) A invidia, a pizmui. ◊ Intranz. A face sau a băga intrigi. [Var.: zavistii vb. IV]","s":"DEX '98"},"zăvorit":{"c":"verb","t":"IV v. zăvorî.","s":"DEX '98"},"zavist":{"c":"substantiv feminin","t":"(Înv.) Invidie, pizmă, gelozie; ură, dușmănie, zavistnicie. ♦ Intrigă, pâră. ♦ Discordie, gâlceavă, ceartă.","s":"DEX '98"},"zavistliv":{"c":"adjectiv","t":"(Înv.) Invidios, pizmaș, intrigant, zavistuitor. [Var.: zavistic, -ă adj.]","s":"DEX '98"},"zavisliv":{"c":"adjectiv","t":"(Înv.) Invidios, pizmaș, intrigant, zavistuitor. [Var.: zavistic, -ă adj.]","s":"DEX '98"},"zăvăcust":{"c":"substantiv feminin","t":"Plantă erbacee cu flori galbene dispuse în spice (Astragalus dasyanthus).","s":"DEX '98"},"zăvon":{"c":"substantiv neutru","t":"(Pop.) 1. Văl purtat de femei ca podoabă; spec. văl de mireasă. ◊ Pânză albă care se pune mirilor pe cap, la cununie. 2. Pânză cu care se acoperă trupul mortului; giulgiu. 3. (La pl.) Veșminte, podoabe de prisos; zorzoane. [Var.: zovon s. n.]","s":"DEX '98"},"zavistie":{"c":"substantiv feminin","t":"(Înv.) Invidie, pizmă, gelozie; ură, dușmănie, zavistnicie. ♦ Intrigă, pâră. ♦ Discordie, gâlceavă, ceartă.","s":"DEX '98"},"zăvolniță":{"c":"substantiv feminin","t":"(Reg.) Curelușă care ține suflecate mânecile cămășii.","s":"DEX '98"},"zavistios":{"c":"adjectiv","t":"(Înv.) Invidios, pizmaș, intrigant. [Pr.: -ti-os] - Zavistie + suf. -os.","s":"DEX '98"},"zavistnic":{"c":"adjectiv","t":"(Înv.) Invidios, pizmaș, intrigant, zavistuitor. [Var.: zavistic, -ă adj.]","s":"DEX '98"},"zavrac":{"c":"substantiv neutru","t":"(Înv.) 1. Mustrare aspră; ocară. 2. Încercare grea; primejdie.","s":"DEX '98"},"zavistnicie":{"c":"substantiv feminin","t":"(Înv.) Zavistie. - Zavistnic + suf. -ie.","s":"DEX '98"},"zavistuitor":{"c":"adjectiv","t":"(Înv.) Invidios, pizmaș, intrigant. [Pr.: -tu-i-] - Zavistui + suf. -tor.","s":"DEX '98"},"zavragioaică":{"c":"substantiv feminin","t":"1. Țigancă din grupul țiganilor nomazi (ursari sau căldărari), soție de zavragiu (1). 2. Femeie gâlcevitoare, scandalagioaică, certăreață. - Zavragiu + suf. -oaică.","s":"DEX '98"},"zavragiu":{"c":"substantiv masculin","t":"1. Țigan nomad (ursar sau căldărar). 2. Scandalagiu.","s":"DEX '98"}},"F":{"zăvorâre":["zăvorâre","zăvorî"],"zăvorâri":["zăvorâre"],"zăvorârea":["zăvorâre"],"zăvorârii":["zăvorâre"],"zăvorârile":["zăvorâre"],"zăvorârilor":["zăvorâre"],"zavere":["zaveră"],"zavera":["zaveră"],"zaverei":["zaveră"],"zaverele":["zaveră"],"zaverelor":["zaveră"],"zăvăcuste":["zăvăcustă"],"zăvăcusta":["zăvăcustă"],"zăvăcustei":["zăvăcustă"],"zăvăcustele":["zăvăcustă"],"zăvăcustelor":["zăvăcustă"],"zăvelcuțe":["zăvelcuță"],"zăvelcuța":["zăvelcuță"],"zăvelcuței":["zăvelcuță"],"zăvelcuțele":["zăvelcuță"],"zăvelcuțelor":["zăvelcuță"],"zăvelci":["zăvelcă"],"zăvelca":["zăvelcă"],"zăvelcii":["zăvelcă"],"zăvelcile":["zăvelcă"],"zăvelcilor":["zăvelcă"],"zavelci":["zavelcă"],"zavelca":["zavelcă"],"zavelcii":["zavelcă"],"zavelcile":["zavelcă"],"zavelcilor":["zavelcă