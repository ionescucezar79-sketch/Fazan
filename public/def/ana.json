:{"c":"substantiv masculin","t":"Arbust tropical din al cărui fruct comestibil se extrage o substanță folosită la lustruirea mobilelor. [Pr.: -di-er]","s":"DEX '98"},"anaciclic":{"c":"adjectiv","t":"(Despre versuri) Care prezintă totdeauna un sens, fie că le citim de la început, fie că le citim de la sfârșit.","s":"DEX '98"},"anaclorhidrie":{"c":"substantiv feminin","t":"Absență a acidului clorhidric din sucul gastric, întâlnită în unele forme de anemie, în cancerul gastric etc.","s":"DEX '98"},"anacreontic":{"c":"adjectiv","t":"1. Care e compus în maniera poeziei erotice de curte a poetului grec antic Anacreon. 2. (În sintagma) Vers anacreontic = vers cu structură metrică des întâlnită în poeziile atribuite lui Anacreon. [Pr.: -cre-on-]","s":"DEX '98"},"anacronic":{"c":"adjectiv","t":"Care conține un anacronism; anacronistic.","s":"DEX '98"},"anacronism":{"c":"substantiv neutru","t":"Nepotrivire sau confuzie între fapte, evenimente etc. și epoca în care sunt plasate; introducere în prezentarea unei epoci a unor trăsături din altă epocă. ◊ Fapt, obicei sau opinie perimată.","s":"DEX '98"},"anacronistic":{"c":"adjectiv","t":"(Rar) Anacronic. - Anacron[ic] + suf. -istic (după caracteristic).","s":"DEX '98"},"anacruză":{"c":"substantiv feminin","t":"1. Notă sau grup de note care formează o măsură incompletă la începutul unei compoziții muzicale. 2. Prima silabă neaccentuată a unui vers.","s":"DEX '98"},"anadiploză":{"c":"substantiv feminin","t":"Figură retorică prin care se începe o frază cu cuvântul sau cu cuvintele de la sfârșitul frazei precedente; repetiție.","s":"DEX '98"},"anaerob":{"c":"adjectiv","t":"(Despre organisme) Care este capabil să trăiască într-un mediu lipsit de oxigen; anaerobiotic. [Pr.: -na-e-] - După fr. anaérobie.","s":"DEX '98"},"anaerobiotic":{"c":"adjectiv","t":"Anaerob. [Pr.: -bi-o-]","s":"DEX '98"},"anaerobioză":{"c":"substantiv feminin","t":"Formă de viață a unor microorganisme anaerobe; anoxibioză. [Pr.: -bi-o-]","s":"DEX '98"},"anafrodiziacă":{"c":"adjectiv","t":"subst. 1. Adj., s. n. (Substanță) care face să înceteze dorințele sexuale. 2. Adj., s. m. și f. (Persoană) care nu are dorințe sexuale, ale cărei organe sexuale sunt atinse de atonie. [Pr.: -zi-ac]","s":"DEX '98"},"anafrodiziac":{"c":"adjectiv","t":"subst. 1. Adj., s. n. (Substanță) care face să înceteze dorințele sexuale. 2. Adj., s. m. și f. (Persoană) care nu are dorințe sexuale, ale cărei organe sexuale sunt atinse de atonie. [Pr.: -zi-ac]","s":"DEX '98"},"anafrodizie":{"c":"substantiv feminin","t":"Lipsă a dorințelor sexuale.","s":"DEX '98"},"anagliptic":{"c":"adjectiv","t":"Imprimat în relief pentru a putea fi urmărit cu degetele de către orbi.","s":"DEX '98"},"anagnost":{"c":"substantiv masculin","t":"Sclav însărcinat să facă lectură în timpul mesei sau al băii stăpânilor, să copieze manuscrise etc. în Roma antică.","s":"DEX '98"},"anagramă":{"c":"substantiv feminin","t":"Schimbare a ordinii literelor unui cuvânt sau a unei fraze pentru a obține un alt cuvânt sau o altă frază. ◊ Cuvânt obținut prin această schimbare. ◊ Joc distractiv care folosește acest procedeu.","s":"DEX '98"},"anagramatic":{"c":"adjectiv","t":"Care formează o anagramă.","s":"DEX '98"},"analfabetă":{"c":"substantiv masculin și feminin","t":"adj. (Persoană) care nu știe să scrie și să citească; neștiutor de carte. ◊ Fig. Ignorant; incult.","s":"DEX '98"},"analfabet":{"c":"substantiv masculin și feminin","t":"adj. (Persoană) care nu știe să scrie și să citească; neștiutor de carte. ◊ Fig. Ignorant; incult.","s":"DEX '98"},"analfabetism":{"c":"substantiv neutru","t":"Situația aceluia sau a acelora care nu știu să scrie și să citească; neștiință de carte.","s":"DEX '98"},"analgezic":{"c":"adjectiv","t":"s. n. (Medicament) care calmează sau înlătură temporar durerea.","s":"DEX '98"},"analgezie":{"c":"substantiv feminin","t":"Pierdere a sensibilității la durere, provocată prin introducerea în organism a unei substanțe analgezice.","s":"DEX '98"},"analgezină":{"c":"substantiv feminin","t":"(Farm.) Medicament care înlătură (temporar) durerea.","s":"DEX '98"},"anamniotă":{"c":"substantiv feminin","t":"pl. Vertebrate al căror embrion nu are amnios și alantoidă. [Pr.: -ni-o-]","s":"DEX '98"},"ananghie":{"c":"substantiv feminin","t":"Situație dificilă, grea, în care se află cineva.","s":"DEX '98"},"anaplastic":{"c":"adjectiv","t":"Care este în legătură cu anaplastia.","s":"DEX '98"},"anaplastie":{"c":"substantiv feminin","t":"Operație chirurgicală făcută cu scopul de a reda forma normală unei părți mutilate a corpului.","s":"DEX '98"},"anartrie":{"c":"substantiv feminin","t":"Incapacitate patologică de a articula cuvintele.","s":"DEX '98"},"anastaltic":{"c":"adjectiv","t":"s. n. (Medicament) cu acțiune astringentă puternică.","s":"DEX '98"},"anastatic":{"c":"adjectiv","t":"Care reproduce o tipăritură prin imprimare sau gravare cu ajutorul anumitor procedee chimice.","s":"DEX '98"},"anastigmat":{"c":"adjectiv","t":"Anastigmatic.","s":"DEX '98"},"anastigmatic":{"c":"adjectiv","t":"(Despre un sistem de lentile) Care are proprietatea de a corecta astigmatismul; anastigmat.","s":"DEX '98"},"anastigmatism":{"c":"substantiv neutru","t":"Proprietate a unui sistem optic de a fi lipsit de astigmatism.","s":"DEX '98"},"anastomotic":{"c":"adjectiv","t":"Care ține de anastomoză.","s":"DEX '98"},"anastomoză":{"c":"substantiv feminin","t":"Comunicație naturală sau artificială (chirurgicală) între două vase sanguine, între două organe cavitare etc.; p. ext. trecerea fibrelor nervoase de la un nerv la altul.","s":"DEX '98"}},"F":{"anaconda":["anaconda","anacondă"],"anaconde":["anaconda","anacondă"],"anacondei":["anaconda","anacondă"],"anacondele":["anaconda","anacondă"],"anacondelor":["anaconda","anacondă"],"anafora":["anafora","anaforă"],"anaforale":["anafora"],"anaforaua":["anafora"],"anaforalei":["anafora"],"anaforalele":["anafora"],"anaforalelor":["anafora"],"anacuzii":["anacuzie"],"anacuzia":["anacuzie"],"anacuziei":["anacuzie"],"anacuziile":["anac