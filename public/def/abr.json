{"L":{"abreviațiune":{"c":"substantiv feminin","t":"Abreviere. [Pr.: -vi-a-. - Var.: abreviațiune s. f.]","s":"DEX '98"},"abrutizat":{"c":"adjectiv","t":"(Care a devenit) insensibil, care și-a pierdut însușirile morale, specific umane; insensibil, brutal. - V. abrutiza.","s":"DEX '98"},"abrutiza":{"c":"verb","t":"Tranz. și refl. A face să-și piardă sau a-și pierde însușirile morale, specific umane; a deveni sau a face să devină insensibil, asemănător cu un animal, cu o brută; a (se) îndobitoci, a (se) dezumaniza.","s":"DEX '98"},"abraziv":{"c":"adjectiv","t":"s. n. (Corp, material dur) care are proprietatea de a roade prin frecare.","s":"DEX '98"},"abreviare":{"c":"substantiv feminin","t":"Acțiunea de a abrevia și rezultatul ei; (concr.) cuvânt, titlu etc. prescurtat; prescurtare, abreviație. [Pr.: -vi-e-] - V. abrevia.","s":"DEX '98"},"abreviere":{"c":"substantiv feminin","t":"Acțiunea de a abrevia și rezultatul ei; (concr.) cuvânt, titlu etc. prescurtat; prescurtare, abreviație. [Pr.: -vi-e-] - V. abrevia.","s":"DEX '98"},"abreviat":{"c":"adjectiv","t":"(Despre cuvinte, titluri etc.) Care a fost prescurtat. [Pr.: -vi-at] - V. abrevia.","s":"DEX '98"},"abrevia":{"c":"verb","t":"Tranz. A prescurta (în scris sau în vorbire) un cuvânt, un titlu etc.; a nota ceva printr-un simbol, printr-o siglă. [Pr.: -vi-a]","s":"DEX '98"},"abreviație":{"c":"substantiv feminin","t":"Abreviere. [Pr.: -vi-a-. - Var.: abreviațiune s. f.]","s":"DEX '98"},"abroga":{"c":"verb","t":"Tranz. A anula o lege, o dispoziție oficială.","s":"DEX '98"},"abrogat":{"c":"adjectiv","t":"(Despre acte, dispoziții etc.) Anulat. - V. abroga.","s":"DEX '98"},"abrogație":{"c":"substantiv feminin","t":"Anulare, suprimare a unei legi, a unui act normativ etc.","s":"DEX '98"},"abrazare":{"c":"substantiv feminin","t":"(Rar) Abraziune (2).","s":"DEX '98"},"abracadabra":{"c":"interjecție","t":"Cuvânt cabalistic căruia obscurantiștii îi atribuiau puterea magică de a realiza un lucru supranatural.","s":"DEX '98"},"abracadabrant":{"c":"adjectiv","t":"(Rar) Cu totul neobișnuit; ciudat, bizar; încâlcit.","s":"DEX '98"},"abraș":{"c":"adjectiv","t":"1. (Reg.; despre cai) Nărăvaș; (despre oameni) rău, violent. 2. (Despre acțiunile omului) fără nici un rezultat; neizbutit, nereușit. ♦ Expr. A ieși abraș = a nu izbuti. [Var.: iabraș, -ă]","s":"DEX '98"},"abraziune":{"c":"substantiv feminin","t":"1. Proces de eroziune a țărmurilor din cauza valurilor mării. 2. Roadere a unui corp ca urmare a frecării lui de alt corp abraziv sau mai dur; abrazare. [Pr.: -zi-u-]","s":"DEX '98"},"abrazor":{"c":"substantiv neutru","t":"Unealtă alcătuită dintr-un material abraziv (natural sau artificial), folosită la prelucrarea prin așchiere.","s":"DEX '98"},"abreviativ":{"c":"adjectiv","t":"Care indică o prescurtare, care abreviază. [Pr.: -vi-a-]","s":"DEX '98"},"abreviator":{"c":"substantiv masculin","t":"1. Funcționar al cancelariei papale. 2. Persoană care prelucrează restrângând sau care rezumă scrierile unui autor. [Pr.: -vi-a-]","s":"DEX '98"},"abrogare":{"c":"substantiv feminin","t":"Acțiunea de a abroga. - V. abroga.","s":"DEX '98"},"abrudeancă":{"c":"substantiv feminin","t":"art. Numele unui dans popular ardelenesc cu mișcare moderată; melodia după care se execută acest dans. - Abrud (n. pr.) + suf. -eancă.","s":"DEX '98"},"abrupt":{"c":"adjectiv","t":"1. (Despre povârnișuri, prăpăstii etc.) Cu pantă repede, greu accesibil; accidentat, prăpăstios. 2. Fig. (Despre stil) Fără legătură, inegal. 3. (Despre un organ) Târâtor, repent.","s":"DEX '98"},"abrutizare":{"c":"substantiv feminin","t":"Acțiunea de a (se) abrutiza. - V. abrutiza.","s":"DEX '98"},"abrutizant":{"c":"adjectiv","t":"Care abrutizează.","s":"DEX '98"}},"F":{"abreviațiuni":["abreviațiune"],"abreviațiunea":["abreviațiune"],"abreviațiunii":["abreviațiune"],"abreviațiunile":["abreviațiune"],"abreviațiunilor":["abreviațiune"],"abrutizat":["abrutizat","abrutiza"],"abrutizați":["abrutiza","abrutizat"],"abrutizatul":["abrutizat"],"abrutizatulu