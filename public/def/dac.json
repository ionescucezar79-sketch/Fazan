{"L":{"dactilomegalie":{"c":"substantiv feminin","t":"(Med.) Hipertrofie a degetelor.","s":"DEX '98"},"dactil":{"c":"substantiv masculin","t":"(În metrică modernă) Picior de vers format dintr-o silabă accentuată urmată de două silabe neaccentuate; (în metrica greco-latină) picior compus din trei silabe, prima lungă și celelalte două scurte. [Pl. și: (n.) dactile]","s":"DEX '98"},"dacoromân":{"c":"adjectiv","t":"s. m. 1. Adj. (Despre dialecte, graiuri, cuvinte) Care aparține românilor sau privitor la românii din nordul Dunării. ◊ (Substantivat, f.) Dialect vorbit de dacoromâni, cel mai răspândit și mai dezvoltat dintre dialectele limbii române. 2. S. m. (De obicei la pl.) Român din nordul Dunării. - Dac + român.","s":"DEX '98"},"dacic":{"c":"adjectiv","t":"Dac (1).","s":"DEX '98"},"dacism":{"c":"substantiv neutru","t":"1. (Livr.) Caracter specific dacilor. 2. Element lexical din limba dacilor. - Dac + suf. -ism.","s":"DEX '98"},"dactilic":{"c":"adjectiv","t":"(Despre versuri) Alcătuit din dactili.","s":"DEX '98"},"dactilologic":{"c":"adjectiv","t":"Referitor la dactilologie.","s":"DEX '98"},"dactiloscopie":{"c":"substantiv feminin","t":"Procedeu de identificare a persoanelor pe baza amprentelor digitale, folosit în antropologie și în medicina judiciară.","s":"DEX '98"},"dac":{"c":"adjectiv","t":"s. m. și f. 1. Adj. Care se referă la Dacia sau la populația ei, privitor la Dacia sau la populația ei; dacic. 2. S. m. și f. Persoană care făcea parte din populația de bază a Daciei.","s":"DEX '98"},"dacă":{"c":"adjectiv","t":"s. m. și f. 1. Adj. Care se referă la Dacia sau la populația ei, privitor la Dacia sau la populația ei; dacic. 2. S. m. și f. Persoană care făcea parte din populația de bază a Daciei.","s":"DEX '98"},"daca":{"c":"conjuncție","t":"1. (Introduce o propoziție condițională) În cazul că..., presupunând că..., de... Doar dacă. Numai dacă. 2. (Introduce o propoziție optativă) Numai de... Dacă nu m-ar vedea cineva. 3. (Introduce o propoziție temporală, având uneori și o nuanță condițională sau cauzală) Când, în (sau din) momentul când, de îndată ce, după ce. 4. (Introduce o propoziție cauzală) Fiindcă, pentru că, deoarece. …","s":"DEX '98"},"dacită":{"c":"substantiv feminin","t":"Exploziv din grupul dinamitelor, folosit în minele de cărbuni negrizutoase sau în cariere.","s":"DEX '98"},"dacit":{"c":"substantiv neutru","t":"Rocă vulcanică alcătuită din cuarț, andezin, biotit, hornblendă, feldspat etc., de obicei cenușie, folosită ca piatră de construcție.","s":"DEX '98"},"dacnomanie":{"c":"substantiv feminin","t":"Tendință patologică de a mușca.","s":"DEX '98"},"dactiliotecă":{"c":"substantiv feminin","t":"Colecție de inele sau de pietre prețioase. ◊ Casetă, sipet pentru păstrarea inelelor sau a pietrelor prețioase. [Pr.: -li-o-]","s":"DEX '98"},"dactilofazie":{"c":"substantiv feminin","t":"(Psih.) Dactilologie.","s":"DEX '98"},"dactilografă":{"c":"substantiv masculin și feminin","t":"Persoană care are ca ocupație de bază dactilografia.","s":"DEX '98"},"dactilograf":{"c":"substantiv masculin și feminin","t":"Persoană care are ca ocupație de bază dactilografia.","s":"DEX '98"},"dactilografia":{"c":"verb","t":"Tranz. A scrie la mașina de scris. [Pr.: -fi-a]","s":"DEX '98"},"dactilografie":{"c":"substantiv feminin","t":"Tehnica sau meseria de a scrie la mașina de scris.","s":"DEX '98"},"dactilografiere":{"c":"substantiv feminin","t":"Acțiunea de a dactilografia și rezultatul ei. [Pr.: -fi-e-] - V. dactilografia.","s":"DEX '98"},"dactilografiat":{"c":"substantiv neutru","t":"Faptul de a dactilografia; dactilografiere. [Pr.: -fi-at] - V. dactilografia.","s":"DEX '98"},"dactilografic":{"c":"adjectiv","t":"Care se referă la dactilografie; care se obține prin dactilografiere.","s":"DEX '98"},"dactilogramă":{"c":"substantiv feminin","t":"Urmă lăsată de deget, folosită ca mijloc de identificare în antropometrie.","s":"DEX '98"},"dactilologie":{"c":"substantiv feminin","t":"Mijloc de comunicare între surdomuți prin semne convenționale făcute cu degetele; dactilofazie.","s":"DEX '98"},"dactiloscopic":{"c":"adjectiv","t":"Privitor la dactiloscopie.","s":"DEX '98"},"dacrioree":{"c":"substantiv feminin","t":"Lăcrimare abundentă. [Pr.: -cri-o-re-e]","s":"DEX '98"},"dacron":{"c":"substantiv neutru","t":"Fibră sintetică de proveniență americană. - Cuv. engl.","s":"DEX '98"},"dacian":{"c":"substantiv neutru","t":"adj. 1. S. n. Al treilea etaj al pliocenului din sud-estul Europei, caracterizat prin anumite specii de lamelibranhiate, gasteropode și mamifere, precum și printr-un complex de nisipuri, argile, gresii etc., conținând zăcăminte bogate de petrol și de lignit. 2. Adj. Care aparține dacianului (1), privitor la dacian. [Pr.: -ci-an]","s":"DEX '98"},"dacriocistită":{"c":"substantiv feminin","t":"Inflamație a canalului și a sacului lacrimal. [Pr.: -cri-o-]","s":"DEX '98"}},"F":{"dactilomegalii":["dactilomegalie"],"dactilomegalia":["dactilomegalie"],"dactilomegaliei":["dactilomegalie"],"dactilomegaliile":["dactilomegalie"],"dactilomegaliilor":["dactilomegalie"],"dactili":["dactil"],"dacoromână":["dacoromân"],"dacoromâne":["dacoromân"],"dacoromâna":["dacoromân"],"dacoromânei":["dacoromân"],"dacoromânele":["dacoromân"],"dacoromânelor":["dacoromân"],"dacici":["dacic"],"dacicul":["dacic"],"dacicului":["dacic"],"dacicii":["dacic"],"dacicilor":["dacic"],"dacică":["dacic"],"dacice":["dacic"],"dacica":["dacic"],"dacicei":["dacic"],"dacicele":["dacic"],"dacicelor":["dacic"],"dacisme":["dacism"],"dacismul":["dacism"],"dacismului":["dacism"],"dacismele":["dacism"],"dacismelor":["dacism"],"dactilici":["dactilic"],"dactilicul":["dactilic"],"dactilicului":["dactilic"],"dactilicii":["dactilic"],"dactilicilor":["dactilic"],"dactilică":["dactilic"],"dactilice":["dactilic"],"dactilica":["dactilic"],"dactilicei":["dactilic"],"dactilicele":["dactilic"],"dactilicelor":["dactilic"],"dactilologici":["dactilologic"],"dactilologicul":["dactilologic"],"dactilologicului":["dactilologic"],"dactilologicii":["dactilologic"],"dact