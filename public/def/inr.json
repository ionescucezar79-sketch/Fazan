{"L":{"înrudit":{"c":"adjectiv","t":"1. Care este sau a devenit rudă cu cineva. 2. Fig. Care prezintă caractere (esențiale) comune cu cineva sau cu ceva; care are afinitate cu cineva sau cu ceva. - V. înrudi.","s":"DEX '98"},"înrudi":{"c":"verb","t":"Refl. recipr. 1. A fi sau a deveni rudă cu cineva; a se înnemuri. 2. Fig. A avea caractere (esențiale) comune cu cineva sau cu ceva. - În + rudă.","s":"DEX '98"},"înrădăcina":{"c":"verb","t":"Refl. A se fixa în pământ prin rădăcini; a prinde rădăcini. ◊ Fig. A pătrunde adânc (în conștiință, în obișnuință etc.). - În + rădăcină.","s":"DEX '98"},"înrădăcinat":{"c":"adjectiv","t":"Fixat în pământ prin rădăcini. ◊ Fig. Pătruns adânc (în conștiință, în obișnuință etc.). - V. înrădăcina.","s":"DEX '98"},"înregistrator":{"c":"adjectiv","t":"s. n. (Aparat, dispozitiv) care înregistrează. - Înregistra + suf. -tor.","s":"DEX '98"},"înrobitor":{"c":"adjectiv","t":"s. m. și f. (Persoană) care înrobește pe cineva. - Înrobi + suf. -tor.","s":"DEX '98"},"înrobitoare":{"c":"adjectiv","t":"s. m. și f. (Persoană) care înrobește pe cineva. - Înrobi + suf. -tor.","s":"DEX '98"},"înroura":{"c":"verb","t":"Refl. A se acoperi cu rouă. [Pr.: -ro-u-] - În + roura.","s":"DEX '98"},"înrourat":{"c":"adjectiv","t":"Acoperit, plin de rouă. [Pr.: -ro-u-] - V. înroura.","s":"DEX '98"},"înrădăcinare":{"c":"substantiv feminin","t":"Acțiunea de a se înrădăcina. - V. înrădăcina.","s":"DEX '98"},"înrăi":{"c":"verb","t":"Refl. și tranz. A deveni sau a face să devină (mai) rău, (mai) răutăcios. - În + rău.","s":"DEX '98"},"înrăit":{"c":"adjectiv","t":"Care a devenit rău, care s-a învechit în răutate, în viciu. - V. înrăi.","s":"DEX '98"},"înrăire":{"c":"substantiv feminin","t":"Faptul de a (se) înrăi. - V. înrăi.","s":"DEX '98"},"înrăma":{"c":"verb","t":"Tranz. A pune un obiect în ramă; a încadra. - În + ramă.","s":"DEX '98"},"înrâuri":{"c":"verb","t":"Tranz. și intranz. A exercita o influență asupra cuiva sau a ceva; a influența.","s":"DEX '98"},"înrâurit":{"c":"verb","t":"Tranz. și intranz. A exercita o influență asupra cuiva sau a ceva; a influența.","s":"DEX '98"},"înrăutățit":{"c":"adjectiv","t":"Care a devenit (mai) rău; care s-a agravat. [Pr.: -ră-u-] - V. înrăutăți.","s":"DEX '98"},"înrăutăți":{"c":"verb","t":"Tranz. și refl. A (se) face (mai) rău, a (se) agrava. [Pr.: -ră-u-] - În + răutate.","s":"DEX '98"},"înregimentat":{"c":"verb","t":"Refl. și tranz. A intra sau a face să intre într-o grupare, într-un partid etc.; a (se) înrola.","s":"DEX '98"},"înregimenta":{"c":"verb","t":"Refl. și tranz. A intra sau a face să intre într-o grupare, într-un partid etc.; a (se) înrola.","s":"DEX '98"},"înregimentare":{"c":"substantiv feminin","t":"Acțiunea de a (se) înregimenta și rezultatul ei. - V. înregimenta.","s":"DEX '98"},"înregistra":{"c":"verb","t":"Tranz. 1. A înscrie într-un registru. 2. A reține prin scris un fapt, un eveniment; a imprima (cu mijloace tehnice) sunetele, fenomenele luminoase etc. ◊ Fig. A întipări în minte, a memora. 3. A înscrie în activul său ca rezultat, ca realizare etc.; a obține. A înregistra un succes important.","s":"DEX '98"},"înregistrat":{"c":"verb","t":"Tranz. 1. A înscrie într-un registru. 2. A reține prin scris un fapt, un eveniment; a imprima (cu mijloace tehnice) sunetele, fenomenele luminoase etc. ◊ Fig. A întipări în minte, a memora. 3. A înscrie în activul său ca rezultat, ca realizare etc.; a obține. A înregistra un succes important.","s":"DEX '98"},"înregistrare":{"c":"substantiv feminin","t":"Acțiunea de a (se) înregistra și rezultatul ei; (concr.) ceea ce a fost înregistrat. - V. înregistra.","s":"DEX '98"},"înrobi":{"c":"verb","t":"Tranz. A supune, a robi, a subjuga, a aservi. - În + rob.","s":"DEX '98"},"înrobit":{"c":"adjectiv","t":"Subjugat, aservit. - V. înrobi.","s":"DEX '98"},"înrobire":{"c":"substantiv feminin","t":"Acțiunea de a înrobi și rezultatul ei. - V. înrobi.","s":"DEX '98"},"înrola":{"c":"verb","t":"Refl. și tranz. A (se) înscrie în rândurile armatei; p. ext. a (se) înscrie într-o organizație, într-un partid; a (se) înregimenta.","s":"DEX '98"},"înrolat":{"c":"verb","t":"Refl. și tranz. A (se) înscrie în rândurile armatei; p. ext. a (se) înscrie într-o organizație, într-un partid; a (se) înregimenta.","s":"DEX '98"},"înrolare":{"c":"substantiv feminin","t":"Acțiunea de a (se) înrola și rezultatul ei. - V. înrola.","s":"DEX '98"},"înroși":{"c":"verb","t":"1. Refl. și tranz. A face să capete sau a căpăta culoarea roșie; a (se) face roșu; a (se) îmbujora, a (se) înflăcăra, a (se) împurpura. ◊ A (se) încinge în foc. 2. Tranz. (Rar) A colora, a vopsi în roșu; a roși. 3. Refl. (Despre fructe) A se coace. - În + roșu sau roși.","s":"DEX '98"},"înroșit":{"c":"adjectiv","t":"Colorat în roșu; devenit roșu; roșit. - V. înroși.","s":"DEX '98"},"înroșire":{"c":"substantiv feminin","t":"Faptul de a (se) înroși. - V. înroși.","s":"DEX '98"},"înrourare":{"c":"verb","t":"Refl. A se acoperi cu rouă. [Pr.: -ro-u-] - În + roura.","s":"DEX '98"},"înrudire":{"c":"substantiv feminin","t":"Faptul de a se înrudi; rudire. - V. înrudi.","s":"DEX '98"},"înrodi":{"c":"verb","t":"Intranz. A produce roade.","s":"DEX '98"},"înrăutățire":{"c":"substantiv feminin","t":"Faptul de a (se) înrăutăți; agravare. [Pr.: -ră-u-] - V. înrăutăți.","s":"DEX '98"},"înrâurire":{"c":"substantiv feminin","t":"Acțiunea de a înrâuri și rezultatul ei; influență. - V. înrâuri.","s":"DEX '98"}},"F":{"înrudit":["înrudit","înrudi"],"înrudiți":["înrudi","înrudit"],"înruditul":["înrudit"],"înruditului":["înrudit"],"înrudiții":["înrudit"],"înrudiților":["înrudit"],"înrudită":["înrudit"],"înrudite":["înrudit"],"înrudita":["înrudit"],"înruditei":["înrudit"],"înruditele":["înrudit"],"înruditelor":["înrudit"],"înruditu":["înrudi","înrudit"],"înrădăcinat":["înrădăcinat","înrădăcina"],"înrădăcinați":["înrădăcina","înrădăcinat"],"înrădăcinatul":["înrădăcinat"],"înrădăcinatului":["înrădăcinat"],"înrădăcinații":["înrădăcinat"],"înrădăcinaților":["înrădăcinat"],"înrădăcinată":["înrădăc