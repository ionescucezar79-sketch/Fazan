{"L":{"afina":{"c":"verb","t":"Tranz. 1. A separa de impurități o masă metalică. 2. A subția firele de lână, de bumbac etc.","s":"DEX '98"},"afinare":{"c":"substantiv feminin","t":"Acțiunea de a afina; afinaj. 1. Proces de îndepărtare a impurităților dintr-un metal sau dintr-un aliaj. ◊ Perioadă din procesul de elaborare a oțelului, în care se produce oxidarea elementelor însoțitoare și se îndepărtează oxizii rezultați. 2. Operație de purificare a zahărului brut, premergătoare decolorării și rafinării. 3. …","s":"DEX '98"},"afirmare":{"c":"substantiv feminin","t":"Acțiunea de a (se) afirma și rezultatul ei. - V. afirma.","s":"DEX '98"},"afirma":{"c":"verb","t":"1. Tranz. A susține (cu tărie), a declara (în mod ferm). 2. Refl. A se remarca, a se manifesta în chip deosebit.","s":"DEX '98"},"afierosi":{"c":"verb","t":"(Înv.) 1. Tranz. A risipi o avere, un bun etc. 2. Refl. A se dedica, a se consacra. [Pr.: -fi-e-]","s":"DEX '98"},"afirmațiune":{"c":"substantiv feminin","t":"Declarație, susținere a unei păreri (exprimată cu tărie). ◊ (La pl.) Vorbe care exprimă o afirmare.","s":"DEX '98"},"afinată":{"c":"substantiv feminin","t":"Băutură alcoolică preparată din afine. - Afină + suf. -ată (după vișinată).","s":"DEX '98"},"afișare":{"c":"substantiv feminin","t":"Acțiunea de a (se) afișa. - V. afișa.","s":"DEX '98"},"afină":{"c":"substantiv feminin","t":"Fructul comestibil al afinului, o bacă în formă de bobiță neagră-albăstruie, brumată, cu gust acrișor. - Forma feminină a lui afin.","s":"DEX '98"},"afiliat":{"c":"adjectiv","t":"(Adesea substantivat) Alăturat, subordonat unei organizații, unei instituții, unei societăți. [Pr.: -li-at] - V. afilia.","s":"DEX '98"},"afilia":{"c":"verb","t":"Refl. (Despre organizații, instituții etc.) A se alătura altei organizații, instituții etc., stabilind raporturi de subordonare sau de colaborare. [Pr.: -li-a-]","s":"DEX '98"},"afiliație":{"c":"substantiv feminin","t":"Afiliere. [Pr.: -li-a-]","s":"DEX '98"},"afinaj":{"c":"substantiv neutru","t":"Afinare.","s":"DEX '98"},"afinant":{"c":"substantiv masculin","t":"Substanță care se adaugă materiilor prime din care se fabrică sticla pentru a se realiza afinarea (3). - Afina + suf. -ant.","s":"DEX '98"},"afinet":{"c":"substantiv neutru","t":"Afiniș. - Afin + suf. -et.","s":"DEX '98"},"afiniș":{"c":"substantiv neutru","t":"Loc pe care cresc afini; afinet. - Afin + suf. -iș.","s":"DEX '98"},"afișaj":{"c":"substantiv neutru","t":"1. Faptul de a afișa; lipire de afișe. 2. Afișaj optic = afișor (2).","s":"DEX '98"},"afix":{"c":"substantiv neutru","t":"(Gram.) Nume generic pentru prefixe, sufixe și infixe.","s":"DEX '98"},"afixal":{"c":"adjectiv","t":"(Gram.) Cu afix.","s":"DEX '96"},"afirmație":{"c":"substantiv feminin","t":"Declarație, susținere a unei păreri (exprimată cu tărie). ◊ (La pl.) Vorbe care exprimă o afirmare.","s":"DEX '98"},"afif":{"c":"adjectiv","t":"invar. (Reg.) Care nu are nici un ban, lefter","s":"DEX '98"},"afin":{"c":"substantiv masculin și feminin","t":"(Jur.) Rudă prin alianță.","s":"DEX '98"},"afinor":{"c":"substantiv masculin","t":"Muncitor care lucrează la afinare.","s":"DEX '98"},"afiș":{"c":"substantiv neutru","t":"Înștiințare, de obicei imprimată, expusă public, prin care se anunță ceva, prin care se dau informații în legătură cu viața politică și culturală; afipt. ◊ Gen de artă grafică, cu funcție mobilizatoare, de informare, de reclamă, de instructaj etc.","s":"DEX '98"},"afișor":{"c":"substantiv masculin și feminin","t":"s. n. 1. S. m. și f. Persoană care se ocupă cu lipirea afișelor. 2. S. n. (Electron.) Dispozitiv pe a cărui suprafață apar caractere alfanumerice comandate electric; afișaj optic.","s":"DEX '98"},"afișoare":{"c":"substantiv masculin și feminin","t":"s. n. 1. S. m. și f. Persoană care se ocupă cu lipirea afișelor. 2. S. n. (Electron.) Dispozitiv pe a cărui suprafață apar caractere alfanumerice comandate electric; afișaj optic.","s":"DEX '98"},"afion":{"c":"substantiv neutru","t":"1. Suc cu proprietăți narcotice, extras de obicei din macul de grădină. 2. Plantă din care se extrage acest suc. [Pr.: -fi-on]","s":"DEX '98"},"afid":{"c":"substantiv neutru","t":"(La pl.) Subordin de insecte homoptere, cuprinzând păduchii de plante mici, cu forme aripate și nearipate (Aphidinea); (și la sg.) insectă care face parte din acest subordin.","s":"DEX '98"},"afidă":{"c":"substantiv neutru","t":"(La pl.) Subordin de insecte homoptere, cuprinzând păduchii de plante mici, cu forme aripate și nearipate (Aphidinea); (și la sg.) insectă care face parte din acest subordin.","s":"DEX '98"},"afipt":{"c":"substantiv neutru","t":"(Înv.) Afiș.","s":"DEX '98"},"afiliare":{"c":"substantiv feminin","t":"Acțiunea de a se afilia; afiliație. [Pr.: -li-e-] - V. afilia.","s":"DEX '98"},"afiliere":{"c":"substantiv feminin","t":"Acțiunea de a se afilia; afiliație. [Pr.: -li-e-] - V. afilia.","s":"DEX '98"}},"F":{"afinare":["afinare","afina"],"afinări":["afinare"],"afinarea":["afinare"],"afinării":["afinare"],"afinările":["afinare"],"afinărilor":["afinare"],"afirmare":["afirmare","afirma"],"afirmări":["afirmare"],"afirmarea":["afirmare"],"afirmării":["afirmare"],"afirmările":["afirmare"],"afirmărilor":["afirmare"],"afierosire":["afierosi"],"afirmațiuni":["afirmațiune"],"afirmațiunea":["afirmațiune"],"afirmațiunii":["afirmațiune"],"afirmațiunile":["afirmațiune"],"afirmațiunilor":["afirmațiune"],"afinate":["afinată"],"afinata":["afinată"],"afinatei":["afinată"],"afinatele":["afinată"],"afinatelor":["afinată"],"afișări":["afișare"],"afișarea":["afișare"],"afișării":["afișare"],"afișările":["afișare"],"afișărilor":["afișare"],"afinele":["afină"],"afiliat":["afiliat","afilia"],"afiliați":["afilia","afiliat"],"afiliatul":["afiliat"],"afiliatului":["afiliat"],"afiliații":["afiliat","afiliație"],"afiliaților":["afiliat"],"afiliată":["afiliat"],"afiliate":["afiliat"],"afiliata":["afiliat"],"afiliatei":["afiliat"],"afiliatele":["afiliat"],"afiliatelor":["afiliat"],"afiliatu":["afilia","afiliat"],"afinaje":["afinaj"]