{"L":{"feștanie":{"c":"substantiv feminin","t":"Slujbă religioasă oficiată de preot la începerea unei activități, la darea în folosință a unei construcții etc. sau la diferite cerințe ale credincioșilor, constând în rugăciuni și în stropirea cu apă sfințită. [Var.: (reg.) feștanie s. f.]","s":"DEX '98"},"festivitate":{"c":"substantiv feminin","t":"Serbare cu caracter solemn, de obicei pentru celebrarea unui eveniment important.","s":"DEX '98"},"festonare":{"c":"substantiv feminin","t":"Acțiunea de a festona și rezultatul ei. - V. festona.","s":"DEX '98"},"festona":{"c":"verb","t":"Tranz. A tivi, a împodobi cu feston.","s":"DEX '98"},"feșteli":{"c":"verb","t":"1. Tranz. și refl. (Reg.) A (se) murdări, a (se) mânji. 2. Tranz. (Fam.; în expr.) A o feșteli = a o păți, a intra într-o încurcătură; a se face de râs.","s":"DEX '98"},"feștelire":{"c":"substantiv feminin","t":"Acțiunea de a (se) feșteli și rezultatul ei. - V. feșteli.","s":"DEX '98"},"fesă":{"c":"substantiv feminin","t":"Fiecare dintre cele două părți posterioare, cărnoase, ale corpului omenesc ori al unor animale; bucă.","s":"DEX '98"},"festă":{"c":"substantiv feminin","t":"Păcăleală, farsă. ♦ Expr. A face (sau a juca etc.) o festă sau festa (cuiva) = a păcăli (pe cineva).","s":"DEX '98"},"feștilă":{"c":"substantiv feminin","t":"Fitil (de lumânare, de lampă, de opaiț); p. ext. lumânare.","s":"DEX '98"},"fesfesea":{"c":"substantiv feminin","t":"pl. (Reg.) Zorzoane, podoabe (mărunte).","s":"DEX '98"},"fes":{"c":"substantiv neutru","t":"Acoperământ al capului pentru bărbați, de forma unui trunchi de con, făcut din pâslă sau postav (roșu) și adesea împodobit cu un ciucure, purtat mai ales de musulmani. ♦ Expr. (Fam.) Interesul poartă fesul, se spune la adresa celui care face anumite acțiuni numai pentru a dobândi avantaje. A-i turti (cuiva) fesul = a face pe cineva să rămână uimit în fața unei prostii săvârșite; a comite o mare prostie. …","s":"DEX '98"},"feșnic":{"c":"substantiv neutru","t":"Suport special pentru lumânări, cu unul sau cu mai multe brațe. [Var.: (reg.) șfeșnic, feșnic s. n.]","s":"DEX '98"},"festin":{"c":"substantiv neutru","t":"(Livr.) Banchet bogat, somptuos.","s":"DEX '98"},"festiv":{"c":"adjectiv","t":"De sărbătoare, pentru sărbătoare; sărbătoresc; măreț, somptuos, maiestuos.","s":"DEX '98"},"festivalier":{"c":"adjectiv","t":"De festival. [Pr.: -li-er]","s":"DEX '98"},"feston":{"c":"substantiv neutru","t":"Broderie (în formă de mici semicercuri) cu care se tivește marginea unui obiect de pânză. ◊ Ornament de arhitectură care imită o astfel de broderie.","s":"DEX '98"},"feștelit":{"c":"adjectiv","t":"(Reg.) Murdărit, mânjit, pătat. - V. feșteli.","s":"DEX '98"},"festonat":{"c":"adjectiv","t":"Tivit, împodobit cu feston. - V. festona.","s":"DEX '98"},"feștelitor":{"c":"adjectiv","t":"s. m. și f. (Reg.; peior.) (Persoană) care scrie urât sau prost, care mâzgălește. - Feșteli + suf. -tor.","s":"DEX '98"},"feștelitoare":{"c":"adjectiv","t":"s. m. și f. (Reg.; peior.) (Persoană) care scrie urât sau prost, care mâzgălește. - Feșteli + suf. -tor.","s":"DEX '98"},"festivalist":{"c":"substantiv masculin și feminin","t":"(Rar) Participant la un festival. - Festival + suf. -ist.","s":"DEX '98"},"festival":{"c":"substantiv neutru","t":"Manifestare artistică (muzicală, teatrală etc.) cuprinzând o serie de reprezentații și având caracter festiv.","s":"DEX '98"},"festivism":{"c":"substantiv neutru","t":"Caracter exagerat festiv. - Festiv + suf. -ism.","s":"DEX '98"},"festivist":{"c":"adjectiv","t":"Care denotă festivism. - Festiv + suf. -ist.","s":"DEX '98"},"fesier":{"c":"adjectiv","t":"Care aparține feselor, din regiunea feselor. [Pr.: -si-er]","s":"DEX '98"}},"F":{"feștanii":["feștanie"],"feștania":["feștanie"],"feștaniei":["feștanie"],"feștaniile":["feștanie"],"feștaniilor":["feștanie"],"festivități":["festivitate"],"festivitatea":["festivitate"],"festivității":["festivitate"],"festivitățile":["festivitate"],"festivităților":["festivitate"],"festonare":["festonare