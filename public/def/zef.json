{"L":{"zefir":{"c":"substantiv masculin","t":"(2) zefiruri, s. n. 1. S. m. Vânt lin, călduț, care suflă primăvara dinspre apus; p. gener. vânt cald, plăcut; adiere. 2. S. n. Țesătură ușoară de bumbac mercerizat, de o singură culoare sau cu dungi colorate, din care se confecționează obiecte de lenjerie; (la pl.) diverse sorturi din această țesătură.","s":"DEX '98"},"zeflemisi":{"c":"verb","t":"Tranz. A lua în râs, a ironiza (pe cineva sau ceva); a lua peste picior (pe cineva); a batjocori. - Zeflemea + suf. -isi.","s":"DEX '98"},"zeflemisit":{"c":"verb","t":"Tranz. A lua în râs, a ironiza (pe cineva sau ceva); a lua peste picior (pe cineva); a batjocori. - Zeflemea + suf. -isi.","s":"DEX '98"},"zeflemist":{"c":"adjectiv","t":"(Adesea substantivat) Ironic, batjocoritor, zeflemitor. - Zeflemea + suf. -ist.","s":"DEX '98"},"zefliu":{"c":"adjectiv","t":"(Turcism înv.) Vesel, glumeț.","s":"DEX '98"},"zeflemitor":{"c":"adjectiv","t":"(Rar) Care ironizează; zeflemist. - Zeflemea + suf. -itor.","s":"DEX '98"},"zeflemea":{"c":"substantiv feminin","t":"Ironie ușoară, luare în râs, glumă batjocoritoare. ♦ Expr. A lua în zeflemea = a-și bate joc de cineva, a lua în râs.","s":"DEX '98"},"zeflemisire":{"c":"substantiv feminin","t":"Acțiunea de a zeflemisi și rezultatul ei; ironizare. - V. zeflemisi.","s":"DEX '98"},"zeflemism":{"c":"substantiv neutru","t":"(Rar) Înclinare, atitudine, dispoziție de a lua totul în zeflemea. - Zeflemea + suf. -ism.","s":"DEX '98"}},"F":{"zefiri":["zefir"],"zefirul":["zefir"],"zefirului":["zefir"],"zefirii":["zefir"],"zefirilor":["zefir"],"zeflemisit":["zeflemisit","zeflemisi"],"zeflemisiți":["zeflemisi","zeflemisit"],"zeflemisitu":["zeflemisi","zeflemisit"],"zefiruri":["zefir"],"zefirurile":["zefir"],"zefirurilor":["zefir"],"zefire":["zefir"],"zefirele":["zefir"],"zefirelor":["zefir"],"zeflemistă":["zeflemist"],"zeflie":["zefliu"],"zeflemitoare":["zeflemitor"],"zeflemele":["zeflemea"],"zeflemeaua":["zeflemea"],"zeflemelei":["zeflemea"],"zeflemelele":