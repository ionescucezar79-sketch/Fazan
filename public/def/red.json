{"L":{"redevență":{"c":"substantiv feminin","t":"(Fin.) Datorie, obligație, rentă care se plătește periodic la date fixe și sub formă de cotă fixă.","s":"DEX '98"},"redibiție":{"c":"substantiv feminin","t":"(Jur.) Anulare a unei vânzări când actul vânzării are un viciu. [Pr.: -ți-u-]","s":"DEX '98"},"reductibilitate":{"c":"substantiv feminin","t":"Însușirea de a fi reductibil.","s":"DEX '98"},"redoare":{"c":"substantiv feminin","t":"(Rar) 1. Lipsă de suplețe; rigiditate. 2. (Med.) Limitare a mișcărilor unei articulații.","s":"DEX '98"},"redactare":{"c":"substantiv feminin","t":"Acțiunea de a redacta și rezultatul ei; formulare în scris, compunere. - V. redacta.","s":"DEX '98"},"redacta":{"c":"verb","t":"Tranz. 1. A compune, a formula în scris, a scrie, a întocmi (un studiu, un act etc.). 2. A asigura (la un ziar, la o editură etc.) finisarea, în conținut și formă, a unor manuscrise primite de la autori și destinate publicării.","s":"DEX '98"},"reda":{"c":"verb","t":"Tranz. 1. A da din nou cuiva un lucru, o situație etc.; a restitui. 2. Fig. A descrie, a exprima ceva prin viu grai, prin scris sau prin diverse mijloace artistice; a reproduce. - Re- + da (după fr. redonner).","s":"DEX '98"},"redare":{"c":"substantiv feminin","t":"Acțiunea de a reda și rezultatul ei; reproducere, exprimare, reprezentare. - V. reda.","s":"DEX '98"},"redatare":{"c":"substantiv feminin","t":"Acțiunea de a redata. - V. redata.","s":"DEX '98"},"redata":{"c":"verb","t":"Tranz. A data din nou, după corectarea unei erori de datare. - Re- + data.","s":"DEX '98"},"redeșteptare":{"c":"substantiv feminin","t":"Acțiunea de a (se) redeștepta și rezultatul ei. - V. redeștepta.","s":"DEX '98"},"redeștepta":{"c":"verb","t":"1. Tranz. și refl. A (se) deștepta, a (se) trezi din nou, a face să-și revină sau a-și reveni în fire, a readuce sau a reveni la viață. ◊ Fig. A izbucni sau a face să izbucnească din nou, a (se) stârni din nou. 2. Tranz. A aminti, a evoca. - Re- + deștepta.","s":"DEX '98"},"redija":{"c":"verb","t":"Tranz. (Înv.) A redacta. [Var.: redige vb. III]","s":"DEX '98"},"redijare":{"c":"substantiv feminin","t":"(Înv.) Acțiunea de a redija și rezultatul ei; redactare. - V. redija.","s":"DEX '98"},"redimensiona":{"c":"verb","t":"Tranz. A recalcula dimensiunile (unei construcții, unei mașini etc.) ◊ Fig. A aborda dintr-o nouă perspectivă; (rar) a regândi. [Pr.: -si-o-] - Re- + dimensiona.","s":"DEX '98"},"redimensionare":{"c":"substantiv feminin","t":"Acțiunea de a redimensiona. [Pr.: -si-o-] - V. redimensiona.","s":"DEX '98"},"rediscutare":{"c":"substantiv feminin","t":"Acțiunea de a rediscuta și rezultatul ei. - V. rediscuta.","s":"DEX '98"},"rediscuta":{"c":"verb","t":"Tranz. A repune (ceva) în discuție.","s":"DEX '98"},"redistila":{"c":"verb","t":"Tranz. A supune unui nou proces de distilare, pentru a obține un produs mai pur.","s":"DEX '98"},"redistilare":{"c":"substantiv feminin","t":"Acțiunea de a redistila și rezultatul ei. - V. redistila.","s":"DEX '98"},"redacțiune":{"c":"substantiv feminin","t":"1. Colectiv de redactori care lucrează la un ziar, la o revistă etc.; localul în care se găsesc birourile redactorilor unui ziar, ai unei reviste etc. 2. Redactare; felul, forma în care este redactată o publicație, o scriere. [Var.: (înv.) redacțiune s. f.]","s":"DEX '98"},"redefinire":{"c":"substantiv feminin","t":"Acțiunea de a redefini. - V. redefini.","s":"DEX '98"},"redefini":{"c":"verb","t":"Tranz. A defini din nou, mai corect, mai exact; a reveni asupra unei definiții anterioare.","s":"DEX '98"},"redeschidere":{"c":"substantiv feminin","t":"Acțiunea de a (se) redeschide și rezultatul ei. - V. redeschide.","s":"DEX '98"},"redeschide":{"c":"verb","t":"Tranz. și refl. A (se) deschide din nou. ◊ Refl. Fig. (Despre școli, instituții, întreprinderi) A-și relua activitatea întreruptă pentru un timp. - Re- + deschide.","s":"DEX '98"},"redescoperire":{"c":"substantiv feminin","t":"Acțiunea de a redescoperi și rezultatul ei. - V. redescoperi.","s":"DEX '98"},"redescoperi":{"c":"verb","t":"Tranz. A descoperi din nou. - Re- + descoperi.","s":"DEX '98"},"redevenire":{"c":"substantiv feminin","t":"Acțiunea de a redeveni. - V. redeveni.","s":"DEX '98"},"redeveni":{"c":"verb","t":"Intranz. A deveni, a fi din nou așa cum a fost înainte. - Re- + deveni. Cf. fr. redevenir.","s":"DEX '98"},"redibițiune":{"c":"substantiv feminin","t":"(Jur.) Anulare a unei vânzări când actul vânzării are un viciu. [Pr.: -ți-u-]","s":"DEX '98"},"redige":{"c":"verb","t":"Tranz. (Înv.) A redacta. [Var.: redige vb. III]","s":"DEX '98"},"redigere":{"c":"verb","t":"III v. redija.","s":"DEX '98"},"redispărere":{"c":"verb","t":"Intranz. (Rar) A dispărea din nou. - Re- + dispărea.","s":"DEX '98"},"redispărea":{"c":"verb","t":"Intranz. (Rar) A dispărea din nou. - Re- + dispărea.","s":"DEX '98"},"redistribui":{"c":"verb","t":"Tranz. A împărți, a repartiza din nou. - Re- + distribui. Cf. fr. redistribuer.","s":"DEX '98"},"redistribuire":{"c":"substantiv feminin","t":"Acțiunea de a redistribui și rezultatul ei. - V. redistribui.","s":"DEX '98"},"redobândire":{"c":"substantiv feminin","t":"Acțiunea de a redobândi și rezultatul ei. - V. redobândi.","s":"DEX '98"},"redobândi":{"c":"verb","t":"Tranz. A dobândi, a obține din nou un lucru pierdut, o situație, o stare etc.; a recâștiga. - Re- + dobândi.","s":"DEX '98"},"reducere":{"c":"substantiv feminin","t":"1. Acțiunea de a reduce și rezultatul ei. ◊ Micșorare, scădere, diminuare. 2. (Med.) Metodă ortopedică prin care oasele luxate sau fracturate sunt puse la loc; reducție. 3. Operație logică care constă în probarea validității modurilor silogistice, pornind de la considerentul că numai modurile primei figuri silogistice sunt valide, urmând ca validitatea celorlalte moduri să fie probată. …","s":"DEX '98"},"reduce":{"c":"verb","t":"Tranz. 1. A micșora, a scădea, a diminua (ca proporții, cantitate, intensitate). ◊ Spec. A micșora dimensiunile unei hărți, ale unei piese etc., păstrând aceleași proporții între elementele componente; a reproduce la dimensiuni mai mici. ◊ (Mat.; în expr.) A reduce o fracție = a suprima factorii comuni de la numitorul și de la numărătorul unei fracții. 2. A restrânge, a limita, a mărgini. ♦ Expr. …","s":"DEX '98"},"redingotă":{"c":"substantiv feminin","t":"Haină bărbătească de ceremonie (de culoare neagră), cu poalele lungi până la genunchi, încheiată cu două rânduri de nasturi.","s":"DEX '96"},"redondanță":{"c":"substantiv feminin","t":"Surplus de informație transmis față de strictul necesar și care asigură exactitatea transmiterii informației în telecomunicații. ◊ Abundență inutilă de expresii, de cuvinte sau de imagini în formularea unei idei. [Var.: redondanță s. f.]","s":"DEX '98"},"redundanță":{"c":"substantiv feminin","t":"Surplus de informație transmis față de strictul necesar și care asigură exactitatea transmiterii informației în telecomunicații. ◊ Abundență inutilă de expresii, de cuvinte sau de imagini în formularea unei idei. [Var.: redondanță s. f.]","s":"DEX '98"},"redută":{"c":"substantiv feminin","t":"1. Mic fort de apărare, de formă poligonală, înconjurat de șanțuri, folosit în trecut pentru apărarea circulară. 2. (Înv.) Local public de petrecere cu muzică și dans.","s":"DEX '98"},"redătător":{"c":"adjectiv","t":"(Rar) Care redă. - Re- + dătător.","s":"DEX '98"},"redondant":{"c":"adjectiv","t":"Care se referă la redundanță, care prezintă redundanță. [Var.: redondant, -ă adj.]","s":"DEX '98"},"reductibil":{"c":"adjectiv","t":"Care se poate reduce, care poate fi simplificat.","s":"DEX '98"},"redundant":{"c":"adjectiv","t":"Care se referă la redundanță, care prezintă redundanță. [Var.: redondant, -ă adj.]","s":"DEX '98"},"redutabil":{"c":"adjectiv","t":"De temut; puternic; valoros.","s":"DEX '98"},"redactat":{"c":"adjectiv","t":"(Despre acte oficiale, articole etc.) Formulat în scris. - V. redacta.","s":"DEX '98"},"redatat":{"c":"adjectiv","t":"Care a fost datat din nou, pentru a corecta o eroare. - V. redata.","s":"DEX '98"},"redefinit":{"c":"adjectiv","t":"Care a fost definit din nou (mai corect, mai exact). - V. redefini.","s":"DEX '98"},"redimensionat":{"c":"adjectiv","t":"1. (Despre construcții, mașini etc.) Ale cărui dimensiuni au fost recalculate. 2. (Fig.) Care a fost reevaluat, care a fost abordat din altă perspectivă. [Pr.: -si-o-] - V. redimensiona.","s":"DEX '98"},"redistilat":{"c":"verb","t":"Tranz. A supune unui nou proces de distilare, pentru a obține un produs mai pur.","s":"DEX '98"},"redresa":{"c":"verb","t":"1. Tranz. și refl. A aduce sau a reveni la poziția, la funcționarea etc. normală după o perturbație accidentală; a (se) îndrepta. ◊ Fig. A aduce sau a reveni pe calea cea bună; a (se) înviora, a (se) reface. 2. Tranz. …","s":"DEX '98"},"redresat":{"c":"adjectiv","t":"1. Care a revenit la poziția sau în situația normală (de la început). ◊ Fig. Care s-a îndreptat, a revenit pe calea cea bună. 2. (Despre curentul electric) Care a suferit o transformare prin redresare. - V. redresa.","s":"DEX '98"},"redus":{"c":"adjectiv","t":"1. Scăzut, micșorat, diminuat (ca proporții, cantitate, intensitate, valoare). ◊ (Despre funcții și expresii algebrice) Asupra căreia s-a efectuat operația pentru obținerea celei mai simple forme; simplificat. 2. (Despre oameni) Lipsit de inteligență, de cultură; mărginit, prost. 3. (Chim.; despre substanțe) Din care a fost scos oxigenul și care a câștigat electroni. - V. reduce.","s":"DEX '98"},"reduplicat":{"c":"verb","t":"Tranz. A dubla. ◊ (Fon.) A repeta unul sau mai multe foneme din rădăcina unui cuvânt, pentru a da cuvântului altă valoare morfologică sau stilistică sau pentru a forma un cuvânt nou.","s":"DEX '98"},"reduplica":{"c":"verb","t":"Tranz. A dubla. ◊ (Fon.) A repeta unul sau mai multe foneme din rădăcina unui cuvânt, pentru a da cuvântului altă valoare morfologică sau stilistică sau pentru a forma un cuvânt nou.","s":"DEX '98"},"reduplicație":{"c":"substantiv feminin","t":"Reduplicare.","s":"DEX '98"},"redibitoriu":{"c":"adjectiv","t":"(Jur.) Care face să se anuleze o vânzare.","s":"DEX '98"},"redan":{"c":"substantiv neutru","t":"1. Lucrare simplă de fortificație, alcătuită dintr-un zid în formă de unghi ieșit în afară, folosită în trecut pentru apărarea unei treceri. 2. Motiv decorativ sculptat în formă de dinți alăturați, folosit în arhitectura evului mediu. 3. Fiecare dintre treptele amenajate în partea superioară a unui zid construit pe un teren înclinat. 4. …","s":"DEX '98"},"reductor":{"c":"adjectiv","t":"1. (Despre aparate sau mecanisme; și substantivat, n.) Care reduce sau micșorează o viteză, o presiune etc. 2. (Despre substanțe chimice; și substantivat, m.) Care reduce un oxid.","s":"DEX '98"},"reducător":{"c":"substantiv masculin","t":"Substanță care, într-o reacție de oxidoreducere, pierde electroni, oxidându-se. - Reduce + suf. -ător.","s":"DEX '98"},"reducțional":{"c":"adjectiv","t":"De reducție. ♦ Diviziune reducțională = meioză. [Pr.: -ți-o-]","s":"DEX '98"},"redactor":{"c":"substantiv masculin și feminin","t":"1. Persoană care lucrează în redacția unui ziar, a unei reviste etc. sau care redactează (2). 2. Persoană care scrie, care întocmește, care compune un articol, un act etc.","s":"DEX '98"},"redactoare":{"c":"substantiv masculin și feminin","t":"1. Persoană care lucrează în redacția unui ziar, a unei reviste etc. sau care redactează (2). 2. Persoană care scrie, care întocmește, care compune un articol, un act etc.","s":"DEX '98"},"redacție":{"c":"substantiv feminin","t":"1. Colectiv de redactori care lucrează la un ziar, la o revistă etc.; localul în care se găsesc birourile redactorilor unui ziar, ai unei reviste etc. 2. Redactare; felul, forma în care este redactată o publicație, o scriere. [Var.: (înv.) redacțiune s. f.]","s":"DEX '98"},"redacțional":{"c":"adjectiv","t":"Care aparține redacției, privitor la redacție sau la activitatea unui redactor. [Pr.: -ți-o-]","s":"DEX '98"},"redempțiune":{"c":"substantiv feminin","t":"(Rar) Mântuire, izbăvire. [Pr.: -ți-u-]","s":"DEX '98"},"redhibitoriu":{"c":"adjectiv","t":"(Jur.) Care face să se anuleze o vânzare.","s":"DEX '98"},"redhibițiune":{"c":"substantiv feminin","t":"(Jur.) Anulare a unei vânzări când actul vânzării are un viciu. [Pr.: -ți-u-]","s":"DEX '98"},"redie":{"c":"substantiv feminin","t":"Larvă în dezvoltarea gălbezei, cu corpul alungit, plin cu celule germinative.","s":"DEX '98"},"rediu":{"c":"substantiv neutru","t":"(Reg.) Pădure mică și tânără. [Var.: rădiu s. n.]","s":"DEX '98"},"redresare":{"c":"substantiv feminin","t":"Acțiunea de a (se) redresa și rezultatul ei. ◊ Acțiune prin care o aeronavă în coborâre ajunge în poziția de zbor orizontal, în urma comenzilor date de pilot sau a reacțiilor aerodinamice provocate de deplasarea ei. ◊ Transformare a energiei electromagnetice de curent alternativ în energie electromagnetică de curent continuu. - V. redresa.","s":"DEX '98"},"redresor":{"c":"substantiv neutru","t":"adj. I. S. n. 1. Aparat sau dispozitiv cu ajutorul căruia se obține, dintr-un curent electric alternativ, un curent electric continuu. 2. Lentilă, sistem de lentile sau de prisme, folosite pentru a îndrepta imaginea răsturnată dată de obiectivul unui instrument optic. 3. Dispozitiv care readuce în direcția inițială un curent de fluid abătut de un obstacol oarecare. II. Adj. Care redresează.","s":"DEX '98"},"reducție":{"c":"substantiv feminin","t":"1. Faptul de a reduce. ◊ (Concr.) Copie în mic a unui obiect. ◊ (Concr.) Piesă de legătură între tuburi sau țevi cu diametre diferite. 2. (Med.) Reducere (2). 3. (Jur.; în forma reducțiune) Restrângere prin hotărâre judecătorească, după moartea unei persoane, a liberalităților făcute de ea prin încălcarea drepturilor unor moștenitori. [Var.: reducțiune s. f.]","s":"DEX '98"},"reducțiune":{"c":"substantiv feminin","t":"1. Faptul de a reduce. ◊ (Concr.) Copie în mic a unui obiect. ◊ (Concr.) Piesă de legătură între tuburi sau țevi cu diametre diferite. 2. (Med.) Reducere (2). 3. (Jur.; în forma reducțiune) Restrângere prin hotărâre judecătorească, după moartea unei persoane, a liberalităților făcute de ea prin încălcarea drepturilor unor moștenitori. [Var.: reducțiune s. f.]","s":"DEX '98"},"reducționism":{"c":"substantiv neutru","t":"Modalitate de explicare sau interpretare a unor fenomene, structuri sau valori complexe ale realității sau ale cunoașterii, prin reducerea lor la concepte, structuri, legi sau configurații mai simple. ◊ Simplificare excesivă. [Pr.: -ți-o-]","s":"DEX '98"},"reduplicare":{"c":"substantiv feminin","t":"Acțiunea de a reduplica și rezultatul ei; reduplicație. - V. reduplica.","s":"DEX '98"},"reduplicativ":{"c":"adjectiv","t":"Privitor la o reduplicare, rezultat în urma unei reduplicări.","s":"DEX '98"}},"F":{"redevența":["redevență"],"redibiții":["redibiție"],"redibiția":["redibiție"],"redibiției":["redibiție"],"redibițiile":["redibiție"],"redibițiilor":["redibiție"],"reductibilități":["reductibilitate"],"reductibilitatea":["reductibilitate"],"reductibilității":["reductibilitate"],"reductibilitățile":["reductibilitate"],"reductibilităților":["reductibilitate"],"redori":["redoare"],"redoarea":["redoare"],"redorii":["redoare"],"redorile":["redoare"],"redorilor":["redoare"],"redactare":["redactare","redacta"],"redactări":["redactare"],"redactarea":["redactare"],"redactării":["redactare"],"redactările":["redactare"],"redactărilor":["redactare"],"redare":["redare","reda"],"redări":["redare"],"redarea":["redare"],"redării":["redare"],"redările":["redare"],"redărilor":["redare"],"redatare":["redatare","redata"],"redatări":["redatare"],"redatarea":["redatare"],"redatării":["redatare"],"redatările":["redatare"],"redatărilor":["redatare"],"redeșteptare":["redeșteptare","redeștepta"],"redeșteptări":["redeșteptare"],"redeșteptarea":["redeșteptare"],"redeșteptării":["redeșteptare"],"redeșteptările":["redeșteptare"],"redeșteptărilor":["redeșteptare"],"redijare":["redijare","redija"],"redijări":["redijare"],"redijarea":["redijare"],"redijării":["redijare"],"redijările":["r