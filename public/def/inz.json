{"L":{"înzeuat":{"c":"adjectiv","t":"(Înv.) Îmbrăcat în zale, cu platoșă. [Pr.: -ză-uat. - Var.: înzeuat, -ă adj.] - În + za + suf. -al.","s":"DEX '98"},"înzăpezi":{"c":"verb","t":"Tranz. și refl. A (se) acoperi cu zăpadă; a deveni sau a face să devină impracticabil din cauza zăpezii; a (se) troieni, a (se) întroieni. ◊ (Despre vehicule; p. ext. despre călători) A (se) imobiliza, a (se) înfunda în zăpadă. - În + zăpadă.","s":"DEX '98"},"înzăpezit":{"c":"adjectiv","t":"(Despre drumuri sau locuri) Care este acoperit cu zăpadă; care a devenit impracticabil din cauza zăpezii; troienit, întroienit. ◊ (Despre vehicule; p. ext. despre călători) Care este imobilizat, înfundat, blocat în zăpadă. - V. înzăpezi.","s":"DEX '98"},"înzăpezire":{"c":"substantiv feminin","t":"Acțiunea de a (se) înzăpezi și rezultatul ei; troienire, întroienire. - V. înzăpezi.","s":"DEX '98"},"înzăuat":{"c":"adjectiv","t":"(Înv.) Îmbrăcat în zale, cu platoșă. [Pr.: -ză-uat. - Var.: înzeuat, -ă adj.] - În + za + suf. -al.","s":"DEX '98"},"înzăvorî":{"c":"verb","t":"Tranz. (Tehn.) A împiedica intenționat mișcarea unei piese față de alta cu ajutorul unor mecanisme de închidere. - În + zăvor.","s":"DEX '98"},"înzăvorât":{"c":"adjectiv","t":"(Tehn.; despre piese) Care este împiedicat să se miște printr-un mecanism de închidere. - V. înzăvorî.","s":"DEX '98"},"înzăvorâre":{"c":"substantiv feminin","t":"(Tehn.) Acțiunea de a înzăvorî. - V. înzăvorî.","s":"DEX '98"},"înzdrăvenit":{"c":"adjectiv","t":"Însănătoșit; întremat, întărit. - V. înzdrăveni.","s":"DEX '98"},"înzdrăveni":{"c":"verb","t":"Refl. A se însănătoși (după o boală), a deveni (iarăși) puternic, zdravăn; a se întrema, a se întări, a se învoinici. ♦ Tranz. Tratamentul l-a înzdrăvenit. - În + zdravăn.","s":"DEX '98"},"înzdrăvenire":{"c":"substantiv feminin","t":"Acțiunea de a (se) înzdrăveni; însănătoșire, întremare, întărire. - V. înzdrăveni.","s":"DEX '98"},"înzeci":{"c":"verb","t":"Tranz. și refl. A face sau a deveni de zece ori mai mare, p. ext. a (se) mări mult. - În + zece.","s":"DEX '98"},"înzecit":{"c":"adjectiv","t":"De zece ori mai mare, mai mult; p. ext. mult mai mult, mult mai mare. - V. înzeci.","s":"DEX '98"},"înzecire":{"c":"substantiv feminin","t":"Acțiunea de a (se) înzeci. - V. înzeci.","s":"DEX '98"},"înzestra":{"c":"verb","t":"Tranz. 1. A da zestre unei fete (când se mărită). ◊ A acorda cuiva un bun, o sursă de venituri etc. 2. A prevedea cu cele necesare o întreprindere, o instituție etc.; a dota. 3. Fig. A dota pe cineva cu calități morale, fizice etc. - În + zestre.","s":"DEX '98"},"înzestrat":{"c":"adjectiv","t":"Prevăzut cu cele necesare. ◊ Fig. Dotat cu calități deosebite, talentat. - V. înzestra.","s":"DEX '98"},"înzestrare":{"c":"substantiv feminin","t":"Acțiunea de a înzestra și rezultatul ei. ◊ Fig. Sumă de calități; capacitate, talent. - V. înzestra.","s":"DEX '98"},"înzidi":{"c":"verb","t":"Tranz. A fixa o piesă, un element de construcție într-un masiv de zidărie. - În + zid.","s":"DEX '98"},"înzidit":{"c":"adjectiv","t":"Fixat într-un masiv de zidărie. - V. înzidi.","s":"DEX '98"},"înzili":{"c":"verb","t":"(Pop.) 1. Tranz. A face să trăiască mult. 2. Refl. A-și ține zilele cu greu, a o duce de azi pe mâine. - În + zile (pl. lui zi).","s":"DEX '98"},"înzorzona":{"c":"verb","t":"Refl. și tranz. A (se) împodobi peste măsură și fără gust, a(-și) pune zorzoane; a (se) împopoțona. - În + zorzoane.","s":"DEX '98"},"înzorzonare":{"c":"substantiv feminin","t":"Acțiunea de a (se) înzorzona și rezultatul ei; împopoțonare. - V. înzorzona.","s":"DEX '98"},"înzelat":{"c":"adjectiv","t":"(Înv.) Îmbrăcat în zale, cu platoșă. [Pr.: -ză-uat. - Var.: înzeuat, -ă adj.] - În + za + suf. -al.","s":"DEX '98"},"înzidire":{"c":"substantiv feminin","t":"Acțiunea de a înzidi. - V. înzidi.","s":"DEX '98"},"înzorzonat":{"c":"adjectiv","t":"Împodobit peste măsură și fără gust; împopoțonat. - V. înzorzona.","s":"DEX '98"}},"F":{"înzeuați":["înzeuat"],"înzeuatul":["înzeuat"],"înzeuatului":["înzeuat"],"înze