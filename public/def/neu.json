{"L":{"neutralizat":{"c":"adjectiv","t":"Făcut sau devenit neutru. [Pr.: ne-u-] - V. neutraliza.","s":"DEX '98"},"neurotomie":{"c":"substantiv feminin","t":"v. nevrotomie.","s":"DEX '98"},"neutrodinare":{"c":"substantiv feminin","t":"(Elt.) Compensare a unei reacții existente între ieșirea și intrarea unui etaj amplificator cu circuite acordate. - După fr. neutrodynation.","s":"DEX '98"},"neurolimfă":{"c":"substantiv feminin","t":"(Anat.) Lichid cefalorahidian. [Pr.: ne-u-]","s":"DEX '98"},"neuitat":{"c":"adjectiv","t":"Care nu se poate uita; a cărui amintire a rămas neștearsă; vrednic de aducere aminte, memorabil; p. ext. veșnic, etern. [Pr.: ne-ui-] - Ne- + uitat.","s":"DEX '98"},"neuroendocrin":{"c":"adjectiv","t":"(Med.) Care se referă la relațiile dintre sistemul nervos și cel endocrin. [Pr.: ne-u-]","s":"DEX '98"},"neuropatologie":{"c":"substantiv feminin","t":"Ramură a neurologiei care se ocupă cu studierea bolilor sistemului nervos. [Pr.: ne-u-]","s":"DEX '98"},"neurom":{"c":"substantiv neutru","t":"v. nevrom.","s":"DEX '98"},"neuropsihologic":{"c":"adjectiv","t":"De neuropsihologie. [Pr.: ne-u-]","s":"DEX '98"},"neutil":{"c":"adjectiv","t":"Care nu este folositor, care nu servește la nimic; inutil. [Pr.: ne-u-] - Ne- + util.","s":"DEX '98"},"neuzat":{"c":"adjectiv","t":"Care nu este degradat, deteriorat, stricat (prin folosire îndelungată). [Pr.: ne-u-] - Ne- + uzat (după fr. non-usé).","s":"DEX '98"},"neuzitat":{"c":"adjectiv","t":"Care nu se folosește în mod curent; (rar) neobișnuit. [Pr.: ne-u-] - Ne- + uzitat.","s":"DEX '98"},"neurastenizat":{"c":"adjectiv","t":"Bolnav de neurastenie; p. ext. cu nervii slăbiți, sensibilizați. [Pr.: ne-u-] - V. neurasteniza.","s":"DEX '98"},"neurasteniza":{"c":"verb","t":"Refl. și tranz. A (se) îmbolnăvi de neurastenie. [Pr.: ne-u-]","s":"DEX '98"},"neutraliza":{"c":"verb","t":"1. Tranz. A pune în imposibilitate de a se manifesta, a face inofensiv, a reduce la pasivitate, a paraliza; a anihila acțiunea unei forțe prin altă forță contrară, a contracara, a zădărnici. ◊ Tranz. și refl. (Lingv.) A determina sau a suferi o neutralizare. 2. Tranz. fact. și refl. (Chim.) A (se) face neutru (4). 3. Tranz. …","s":"DEX '98"},"neurochirurgie":{"c":"substantiv feminin","t":"Ramură a chirurgiei având ca obiect bolile sistemului nervos care necesită o intervenție chirurgicală. [Pr.: ne-u-]","s":"DEX '98"},"neuropsihiatrie":{"c":"substantiv feminin","t":"Ramură a medicinii care studiază în ansamblu afecțiunile sistemului nervos, incluzând și bolile psihice. [Pr.: ne-u-ro-psi-hi-a-]","s":"DEX '98"},"neuropsihologie":{"c":"substantiv feminin","t":"Disciplină care studiază fenomenele psihice în legătură cu sistemul nervos central. [Pr.: ne-u-]","s":"DEX '98"},"neutrin":{"c":"substantiv masculin","t":"(Fiz.) Particulă elementară neutră, stabilă, cu masa foarte mică. [Pr.: ne-u-]","s":"DEX '98"},"neutral":{"c":"adjectiv","t":"1. (Rar) Neutru (1). 2. (Despre sensul cuvintelor) Care este indiferent față de genul (feminin sau masculin) indicat de forma cuvântului; care se poate referi la obiecte de orice gen. 3. (Chim.; rar) Neutru (4). [Pr.: ne-u-]","s":"DEX '98"},"neuropsihic":{"c":"adjectiv","t":"De neuropsihiatrie. [Pr.: ne-u-]","s":"DEX '98"},"neurastenie":{"c":"substantiv feminin","t":"Boală caracterizată prin tulburări funcționale ale scoarței cerebrale, care se manifestă prin dureri de cap, insomnie, oboseală, depresiune psihică, anxietate, palpitații, sufocări etc. [Pr.: ne-u-]","s":"DEX '98"},"neurocit":{"c":"substantiv neutru","t":"(Anat.) Neuron. [Pr.: ne-u-]","s":"DEX '98"},"neuroleptic":{"c":"adjectiv","t":"s. n. (Medicament, substanță) cu efect sedativ asupra sistemului nervos. [Pr.: ne-u-]","s":"DEX '98"},"neurolog":{"c":"substantiv masculin și feminin","t":"Medic specialist în boli ale sistemului nervos. [Pr.: ne-u-]","s":"DEX '98"},"neurologie":{"c":"substantiv feminin","t":"Ramură a medicinii care studiază formarea, structura, funcțiile și bolile sistemului nervos. [Pr.: ne-u-]","s":"DEX '98"},"neurologă":{"c":"substantiv masculin și feminin","t":"Medic specialist în boli ale sistemului nervos. [Pr.: ne-u-]","s":"DEX '98"},"neuroloagă":{"c":"substantiv masculin și feminin","t":"Medic specialist în boli ale sistemului nervos. [Pr.: ne-u-]","s":"DEX '98"},"neuroplegic":{"c":"adjectiv","t":"s. n. (Medicament, substanță) care are o acțiune deconectantă asupra sistemului nervos central, provocând o reducere a stării de tensiune psihică, fără să producă somn. [Pr.: ne-u-]","s":"DEX '98"},"neurotrop":{"c":"adjectiv","t":"s. m. (Microorganism, virus) care se fixează și provoacă modificări în special în sistemul nervos. [Pr.: ne-u-]","s":"DEX '98"},"neutrino":{"c":"substantiv masculin","t":"(Fiz.) Particulă elementară neutră, stabilă, cu masa foarte mică. [Pr.: ne-u-]","s":"DEX '98"},"neutru":{"c":"adjectiv","t":"1. (Despre state, popoare etc.) Care este în stare de neutralitate, care nu face parte din beligeranți sau dintre părțile adverse; neutral (1). ♦ Zonă neutră sau teritoriu neutru = teritoriu situat între granițele a două țări pe care nu staționează forțe armate. ◊ P. ext. (Despre oameni sau grupuri sociale) Care nu se încadrează în nici un partid, în nici un curent etc.; …","s":"DEX '98"},"neumblat":{"c":"adjectiv","t":"1. (Despre drumuri, locuri) Care este puțin umblat, pe care se trece rareori; pe unde nu au trecut niciodată oamenii; p. ext. care nu este populat; pustiu. 2. (Despre oameni) Care a călătorit puțin. [Pr.: ne-um-] - Ne- + umblat.","s":"DEX '98"},"neunire":{"c":"substantiv feminin","t":"(Rar) Lipsă de unire, de înțelegere (între mai multe persoane, colectivități etc.); neînțelegere. [Pr.: ne-u-] - Ne- + unire.","s":"DEX '98"},"neural":{"c":"adjectiv","t":"Care face parte din sistemul nervos, care este în legătură cu sistemul nervos. ◊ Canal neural = șanț care brăzdează ectodermul embrionului, din pereții căruia ia naștere sistemul nervos. [Pr.: ne-u-]","s":"DEX '98"},"neurastenică":{"c":"substantiv masculin și feminin","t":"adj. 1. S. m. și f., adj. (Persoană) bolnavă de neurastenie. 2. Adj. Privitor la neurastenie; specific neurasteniei. [Pr.: ne-u-]","s":"DEX '98"},"neurastenic":{"c":"substantiv masculin și feminin","t":"adj. 1. S. m. și f., adj. (Persoană) bolnavă de neurastenie. 2. Adj. Privitor la neurastenie; specific neurasteniei. [Pr.: ne-u-]","s":"DEX '98"},"neurastenizant":{"c":"adjectiv","t":"(Rar) Care produce neurastenie. [Pr.: ne-u-] - Neurasteniza + suf. -ant.","s":"DEX '98"},"neurină":{"c":"substantiv feminin","t":"Substanță organică toxică care se găsește de obicei în materiile intrate în putrefacție. [Pr.: ne-u-]","s":"DEX '98"},"neurofibromatoză":{"c":"substantiv feminin","t":"Boală caracterizată prin apariția pe piele a unor pete pigmentare sau a unor tumori care își au originea în țesutul fibros al tecilor nervilor. [Pr.: ne-u-]","s":"DEX '98"},"neurologic":{"c":"adjectiv","t":"Care aparține neurologiei, privitor la neurologie. [Pr.: ne-u-]","s":"DEX '98"},"neuromuscular":{"c":"adjectiv","t":"Care aparține nervilor sistemului muscular, privitor la acești nervi. [Pr.: ne-u-]","s":"DEX '98"},"neuron":{"c":"substantiv masculin","t":"Element structural și funcțional de bază al sistemului nervos compus dintr-un corp celular protoplasmatic, care conține un nucleu, și din prelungiri protoplasmatice; neurocit. [Pr.: ne-u-]","s":"DEX '98"},"neurosimpatic":{"c":"adjectiv","t":"Privitor la sistemul nervos al marelui simpatic, care aparține acestui sistem. [Pr.: ne-u-]","s":"DEX '98"},"neurovegetativ":{"c":"adjectiv","t":"1. (În sintagma) Sistem nervos neurovegetativ = totalitatea organelor nervoase de transmisiune ale organismului care reglează funcțiile de nutriție. 2. Care ține de sistemul nervos neurovegetativ, care aparține sau este propriu, caracteristic acestui sistem. [Pr.: ne-u-]","s":"DEX '98"},"neutralitate":{"c":"substantiv feminin","t":"Situație, atitudine a unui stat care nu se amestecă în conflictul dintre două sau mai multe state, care nu participă la pacte sau la alianțe militare și întreține relații pașnice cu fiecare stat beligerant în parte; p. ext. stare, atitudine neutră (1) a unei persoane sau a unui grup social. [Pr.: ne-u-]","s":"DEX '98"},"neutralizare":{"c":"substantiv feminin","t":"Acțiunea de a (se) neutraliza. ◊ (Lingv.) Suprimarea, în condiții determinate, a unei opoziții existente între două unități. [Pr.: ne-u-] - V. neutraliza.","s":"DEX '98"},"neutralizant":{"c":"adjectiv","t":"Care neutralizează. [Pr.: ne-u-]","s":"DEX '98"},"neutron":{"c":"substantiv masculin","t":"(Fiz.) Particulă elementară neutră din nucleul atomului, lipsită de sarcină electrică, cu masa puțin mai mare decât cea a protonului. [Pr.: ne-u-]","s":"DEX '98"},"neutronic":{"c":"adjectiv","t":"Care aparține neutronilor, care se referă la neutroni; alcătuit din neutroni. [Pr.: ne-u-]","s":"DEX '98"}},"F":{"neutralizații":["neutralizat"],"neurotomii":["neurotomie"],"neurotomia":["neurotomie"],"neurotomiei":["neurotomie"],"neurotomiile":["neurotomie"],"neurotomiilor":["neurotomie"],"neutrodinări":["neutrodinare"],"neutrodinarea":["neutrodinare"],"neutrodinării":["neutrodinare"],"neutrodinările":["neutrodinare"],"neutrodinărilor":["neutrodinare"],"neurolimfe":["neurolimfă"],"neurolimfa":["neurolimfă"],"neurolimfei":["neurolimfă"],"neurolimfele":["neurolimfă"],"neurolimfelor":["neurolimfă"],"neuitați":["neuitat"],"neuitatul":["neuitat"],"neuitatului":["neuitat"],"neuitații":["neuitat"],"neuitaților":["neuitat"],"neuitată":["neuitat"],"neuitate":["neuitat"],"neuitata":["neuitat"],"neuitatei":["neuitat"],"neuitatele":["neuitat"],"neuitatelor":["neuitat"],"neuroendocrini":["neuroendocrin"],"neuroendocrinul":["neuroendocrin"],"neuroendocrinului":["neuroendocrin"],"neuroendocrinii":["neuroendocrin"],"neuroendocrinilor":["neuroendocrin"],"neuroendocrină":["neuroendocrin"],"neuroendocrine":["neuroendocrin"],"neuroendocrina":["neuroendocrin"],"neuroendocrinei":["neuroendocrin"],"neuroendocrinele":["neuroendocrin"],"neuroendocrinelor":["neuroendocrin"],"neuro