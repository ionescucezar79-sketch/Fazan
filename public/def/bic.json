{"L":{"bichirire":{"c":"verb","t":"Tranz. (Reg.) A face, a drege un lucru pe îndelete, migălind.","s":"DEX '98"},"bichiri":{"c":"verb","t":"Tranz. (Reg.) A face, a drege un lucru pe îndelete, migălind.","s":"DEX '98"},"bicicletă":{"c":"substantiv feminin","t":"Vehicul cu două roți pus în mișcare prin două pedale acționate cu picioarele și folosit, de obicei, pentru transportul unei singure persoane. ♦ Bicicletă-tandem = bicicletă pentru două persoane, fiecare acționând câte o pereche de pedale.","s":"DEX '98"},"bicolor":{"c":"adjectiv","t":"Care are două culori.","s":"DEX '98"},"biciclic":{"c":"adjectiv","t":"Cu două cicluri. - Bi- + ciclic.","s":"DEX '98"},"bichirit":{"c":"verb","t":"Tranz. (Reg.) A face, a drege un lucru pe îndelete, migălind.","s":"DEX '98"},"bicher":{"c":"substantiv masculin","t":"(Fam.) Burlac, holtei.","s":"DEX '98"},"biceps":{"c":"substantiv masculin","t":"Mușchi cu extremitatea superioară despărțită în două ligamente; (în special) mușchiul dintre umăr și cot, care face să se îndoaie antebrațul.","s":"DEX '98"},"bicișor":{"c":"substantiv neutru","t":"Diminutiv al lui bici. - Bici + suf. -ușor.","s":"DEX '98"},"bici":{"c":"substantiv neutru","t":"(Adesea fig.) Obiect alcătuit dintr-o curea sau o împletitură de curele, mai rar de cânepă, legată de un băț, cu care se lovesc sau se îndeamnă animalele să meargă. ◊ Lovitură dată cu obiectul descris mai sus. [Var.: (reg.) zbici s. n.]","s":"DEX '98"},"bichiș":{"c":"substantiv neutru","t":"(Pop. și fam.) 1. (La pl.; adesea fig.) Obiecte mărunte, piese, accesorii (lipsite de importanță) care completează un sistem și ajută la buna lui funcționare. ♦ Loc. adv. Cu dichis (sau cu tot dichisul) = cu toate cele necesare, fără să lipsească nimic; cu grijă, ordonat. 2. Podoabă, găteală, ornament.","s":"DEX '98"},"biciclu":{"c":"substantiv neutru","t":"Velociped cu două roți inegale, dintre care prima este roata motoare.","s":"DEX '98"},"bicisnic":{"c":"adjectiv","t":"s. m. și f. (Pop.) 1. (Om) vrednic de compătimire, lipsit de personalitate, de inteligență și de energie; ticăit. 2. (Om) debil, slăbănog, neputincios, bolnăvicios. [Var.: bicisnic, -ă adj., s. m. și f.]","s":"DEX '98"},"bicisnicie":{"c":"substantiv feminin","t":"(Pop.) 1. Faptă de becisnic. 2. Starea omului becisnic. - Becisnic + suf. -ie.","s":"DEX '98"},"bicisnică":{"c":"adjectiv","t":"s. m. și f. (Pop.) 1. (Om) vrednic de compătimire, lipsit de personalitate, de inteligență și de energie; ticăit. 2. (Om) debil, slăbănog, neputincios, bolnăvicios. [Var.: bicisnic, -ă adj., s. m. și f.]","s":"DEX '98"},"bicefal":{"c":"adjectiv","t":"(Despre un animal) Cu două capete.","s":"DEX '98"},"bicorn":{"c":"substantiv neutru","t":"Pălărie bărbătească (de uniformă) cu două colțuri.","s":"DEX '98"},"bicuspid":{"c":"adjectiv","t":"(Despre unele formații anatomice) cu două vârfuri.","s":"DEX '98"},"bicameral":{"c":"adjectiv","t":"(Despre sistemul reprezentativ al unui stat) Care constă din două adunări reprezentative, denumite, uneori, camere.","s":"DEX '98"},"bicarbonat":{"c":"substantiv masculin","t":"Sare a acidului carbonic, în care un atom de hidrogen a fost înlocuit printr-un metal. ♦ Bicarbonat (de sodiu) = sare în formă de pulbere albă, folosită în farmacie și în bucătărie.","s":"DEX '98"},"bicarpelar":{"c":"adjectiv","t":"(Despre gineceu) Format din două carpele.","s":"DEX '98"},"bicentenar":{"c":"adjectiv","t":"s. n. 1. Adj. Care durează de două secole, care a împlinit două sute de ani. 2. S. n. Împlinire a două secole de la un eveniment (important); a doua suta aniversare a unui eveniment.","s":"DEX '98"},"biciclist":{"c":"substantiv masculin și feminin","t":"Persoană care umblă pe bicicletă; ciclist (1).","s":"DEX '98"},"biciclistă":{"c":"substantiv masculin și feminin","t":"Persoană care umblă pe bicicletă; ciclist (1).","s":"DEX '98"},"biciușor":{"c":"substantiv neutru","t":"Diminutiv al lui bici. - Bici + suf. -ușor.","s":"DEX '98"},"biciui":{"c":"verb","t":"1. Tranz. și refl. A (se) lovi cu biciul. ◊ Tranz. A lovi cu ceva (subțire ca biciul), producând usturime; a flagela; a cravașa. 2. Tranz. Fig. A critica, a satiriza fără cruțare. [Prez. ind. și biciui. - Var.: (reg.) zbiciui vb. IV] - Bici + suf. -ui.","s":"DEX '98"},"biciuire":{"c":"substantiv feminin","t":"Acțiunea de a (se) biciui și rezultatul ei; biciuială. - V. biciui.","s":"DEX '98"},"biciuială":{"c":"substantiv feminin","t":"Biciuire. [Pr.: -ciu-ia-] - Biciui + suf. -eală.","s":"DEX '98"},"biciușcă":{"c":"substantiv feminin","t":"1. Cravașă. 2. Bici scurt și subțire. - Bici + suf. -ușcă.","s":"DEX '98"},"biconcav":{"c":"adjectiv","t":"Care are două fețe concave opuse.","s":"DEX '98"},"biconvex":{"c":"adjectiv","t":"Care are două fețe convexe opuse.","s":"DEX '98"},"bicromat":{"c":"substantiv masculin","t":"Sare obținută prin tratarea cu acid a cromatului unui metal. ♦ Bicromat de potasiu = sare cristalizată, portocalie, întrebuințată ca oxidant și colorant.","s":"DEX '98"},"biciuitor":{"c":"adjectiv","t":"(Adesea fig.) Care biciuiește; usturător. - Biciui + suf. -tor.","s":"DEX '98"}},"F":{"bichirire":["bichirire","bichiri"],"biciclete":["bicicletă"],"biciclici":["biciclic"],"biciclicul":["biciclic"],"biciclicului":["biciclic"],"biciclicii":["biciclic"],"biciclicilor":["biciclic"],"biciclică":["biciclic"],"biciclice":["biciclic"],"biciclica":["biciclic"],"biciclicei":["biciclic"],"biciclicele":["biciclic"],"biciclicelor":["biciclic"],"bichirit":["bichirit","bichiri"],"bichiriți":["bichiri","bichirit"],"bichiritu":["bichiri","bichirit"],"bicheri":["bicher"],"bicherul":["bicher"],"bicherului":["bicher"],"bicherii":["bicher"],"bicherilor":["bicher"],"bicepsuri":["biceps"],"bicepsul":["biceps"],"bicepsului":["biceps"],"bicepsurile":["biceps"],"bicepsurilor":["biceps"],"bicișoare":["bicișor"],"bicișorul":["bicișor"],"bicișorului":["bicișor"],"bicișoarele":["bicișor"],"bicișoarelor":["bicișor"],"biciuri":["bici"],"biciul":["bici"],"biciului":["bici"],"biciurile":["bici"],"biciurilor":["bici"],"bichișuri":["b