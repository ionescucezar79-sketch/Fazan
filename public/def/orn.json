{"L":{"ornicărie":{"c":"substantiv feminin","t":"(Înv.) Meseria ceasornicarului. - Ornicar (înv. \"ceasornicar\" < ornic) + suf. -ie.","s":"DEX '98"},"ornitofilie":{"c":"substantiv feminin","t":"1. Grijă pentru păsări, pasiune de a crește păsări exotice și cântătoare. 2. Polenizare prin intermediul păsărilor.","s":"DEX '98"},"ornitofil":{"c":"substantiv masculin și feminin","t":"adj. 1. S. m. și f. Iubitor de păsări. 2. Adj. (Despre plante) La care polenizarea se face cu ajutorul păsărilor. 3. Adj. De ornitofilie.","s":"DEX '98"},"ornamentare":{"c":"substantiv feminin","t":"Acțiunea de a ornamenta și rezultatul ei; împodobire, înfrumusețare. - V. ornamenta.","s":"DEX '98"},"ornamenta":{"c":"verb","t":"Tranz. A împodobi, a înfrumuseța cu ornamente; a decora cu un motiv.","s":"DEX '98"},"ornare":{"c":"substantiv feminin","t":"Acțiunea de a orna; împodobire, decorare. - V. orna.","s":"DEX '98"},"orna":{"c":"verb","t":"Tranz. A pune în valoare, a înfrumuseța un lucru adăugându-i o podoabă; a împodobi, a decora.","s":"DEX '98"},"ornamentațiune":{"c":"substantiv feminin","t":"Faptul de a împodobi cu ornamente; arta, tehnica ornamentării; totalitatea elementelor care ornamentează ceva; ansamblu ornamental.","s":"DEX '98"},"ornitofaună":{"c":"substantiv feminin","t":"Totalitatea păsărilor dintr-o regiune, într-o epocă geologică. [Pr.: -fa-u-]","s":"DEX '98"},"ornitoză":{"c":"substantiv feminin","t":"Boală infecțioasă întâlnită la păsări și transmisibilă la om, care se manifestă, la păsări, prin conjunctivită, coriză, diaree și tulburări generale, iar la om prin pneumonii, tulburări circulatorii și digestive etc.","s":"DEX '98"},"ornat":{"c":"adjectiv","t":"Împodobit, decorat. - V. orna.","s":"DEX '98"},"ornamental":{"c":"adjectiv","t":"Care servește ca ornament, ca podoabă; decorativ. ♦ Plante ornamentale = grup de plante cultivate în parcuri, grădini sau locuințe în scopuri decorative.","s":"DEX '98"},"ornant":{"c":"adjectiv","t":"Care servește drept podoabă, care împodobește. - Orna + suf. -ant.","s":"DEX '98"},"ornic":{"c":"substantiv neutru","t":"(Înv.) Ceasornic (de perete); orologiu, pendulă. - Oră + suf. -nic sau refăcut din [ceas]ornic.","s":"DEX '98"},"ornitologic":{"c":"adjectiv","t":"Care aparține ornitologiei, privitor la ornitologie.","s":"DEX '98"},"ornamentație":{"c":"substantiv feminin","t":"Faptul de a împodobi cu ornamente; arta, tehnica ornamentării; totalitatea elementelor care ornamentează ceva; ansamblu ornamental.","s":"DEX '98"},"ornament":{"c":"substantiv neutru","t":"1. Detaliu sau obiect adăugat la un ansamblu pentru a-l înfrumuseța; accesoriu, element decorativ folosit în artele plastice, în arhitectură, în tipografie pentru a întregi o compoziție și a-i reliefa semnificația. ♦ Loc. adj. De ornament = decorativ, ornamental. ◊ (Rar) Distincție, însemn, decorație. 2. …","s":"DEX '98"},"ornitolog":{"c":"substantiv masculin și feminin","t":"Specialist în ornitologie; ornitologist.","s":"DEX '98"},"ornitologie":{"c":"substantiv feminin","t":"Parte a zoologiei care se ocupă cu studiul sistematicii, al morfologiei și al ecologiei păsărilor.","s":"DEX '98"},"ornitologă":{"c":"substantiv masculin și feminin","t":"Specialist în ornitologie; ornitologist.","s":"DEX '98"},"ornitologist":{"c":"substantiv masculin și feminin","t":"(Înv.) Ornitolog.","s":"DEX '98"},"ornitologistă":{"c":"substantiv masculin și feminin","t":"(Înv.) Ornitolog.","s":"DEX '98"},"ornamentică":{"c":"substantiv feminin","t":"1. Mod specific unui popor sau unui stil de a concepe și a dispune ornamentele în arhitectură și în arta aplicată. 2. Totalitatea motivelor ornamentale specifice unui popor sau unui stil. 3. (Muz.) Totalitatea sunetelor care împodobesc linia melodică inițială.","s":"DEX '98"},"ornamentist":{"c":"substantiv masculin și feminin","t":"Artist specializat în executarea lucrărilor ornamentale. - Ornament + suf. -ist.","s":"DEX '98"},"ornitofilă":{"c":"substantiv masculin și feminin","t":"adj. 1. S. m. și f. Iubitor de păsări. 2. Adj. (Despre plante) La care polenizarea se face cu ajutorul păsărilor. 3. Adj. De ornitofilie.","s":"DEX '98"},"ornitorinc":{"c":"substantiv masculin","t":"Animal mamifer semiacvatic din Australia, cu gura în forma ciocului de rață și cu membrane înotătoare între degete, care depune ouă, dar alăptează puii ieșiți din ouă (Ornithorhynchus anatinus).","s":"DEX '98"},"ornitopter":{"c":"substantiv neutru","t":"Aeronavă mai grea decât aerul, cu aripi batante, care imită zborul păsărilor; ortopter.","s":"DEX '98"}},"F":{"ornicării":["ornicărie"],"ornicăria":["ornicărie"],"ornicăriei":["ornicărie"],"ornicăriile":["ornicărie"],"ornicăriilor":["ornicărie"],"ornitofilii":["ornitofil","ornitofilie"],"ornitofilia":["ornitofilie"],"ornitofiliei":["ornitofilie"],"ornitofiliile":["ornitofilie"],"ornitofiliilor":["ornitofilie"],"ornamentare":["ornamentare","ornamenta"],"ornamentări":["ornamentare"],"ornamentarea":["ornamentare"],"ornamentării":["ornamentare"],"ornamentările":["ornamentare"],"ornamentărilor":["ornamentare"],"ornare":["ornare","orna"],"ornări":["ornare"],"ornarea":["ornare"],"ornării":["ornare"],"ornările":["ornare"],"ornărilor":["ornare"],"ornamentațiuni":["ornamentațiune"],"ornamentațiunea":["ornamentațiune"],"ornamentațiunii":["ornamentațiune"],"ornamentațiunile":["ornamentațiune"],"ornamentațiunilor":["ornamentațiune"],"ornitofaune":["ornitofaună"],"ornitofauna":["ornitofaună"],"ornitofaunei":["ornitofaună"],"ornitofaunele":["ornitofaună"],"ornitofaunelor":["ornitofaună"],"ornitoze":["ornitoză"],"ornitoza":["ornitoză"],"ornitozei":["ornitoză"],"ornitozele":["ornitoză"],"ornitozelor":["ornitoză"],"ornate":["ornat"],"ornatele":["ornat"],"ornatelor":["ornat"],"ornata":["ornat"],"ornamentali":["ornamental"],"ornamentalul":["ornamental"],"ornamentalului":["ornamental"],"ornamentalii":["ornamental"],"ornamentalilor":["ornamental"],"ornamentală":["ornamental"],"ornamentale":["ornamental"],"ornamentala":["ornamental"],"ornamentalei":["ornamental"],"ornamentalele":["orname