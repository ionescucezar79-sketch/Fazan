cători.","s":"DEX '98"},"maximafilist":{"c":"substantiv masculin și feminin","t":"Specialist în maximafilie. - Maximafilie + suf. -ist.","s":"DEX '98"},"maximafilistă":{"c":"substantiv masculin și feminin","t":"Specialist în maximafilie. - Maximafilie + suf. -ist.","s":"DEX '98"},"maxit":{"c":"substantiv neutru","t":"Oțel rapid standardizat, cu fier, molibden, wolfram, crom etc. în compoziție.","s":"DEX '98"},"maximafil":{"c":"adjectiv","t":"Referitor la maximafilie, de maximafilie.","s":"DEX '98"},"maximafilie":{"c":"substantiv feminin","t":"Colecționare de cărți poștale cu o temă care se regăsește în marcaj și în obliterare.","s":"DEX '98"},"maxwell":{"c":"substantiv masculin","t":"(Fiz.) Unitate de măsură a fluxului magnetic. [Pr.: maxuel]","s":"DEX '98"}},"F":{"maximizare":["maximizare","maximiza"],"maximizări":["maximizare"],"maximizarea":["maximizare"],"maximizării":["maximizare"],"maximizările":["maximizare"],"maximizărilor":["maximizare"],"maxijupe":["maxijup","maxijupă"],"maxijupa":["maxijupă"],"maxijupei":["maxijupă"],"maxijupele":["maxijup","maxijupă"],"maxijupelor":["maxijup","maxijupă"],"maxile":["maxilă"],"maxila":["maxilă"],"maxilei":["maxilă"],"maxilele":["maxilă"],"maxilelor":["maxilă"],"maximă":["maximă","maxim"],"maxime":["maxim","maximă"],"maxima":["maxim","maximă"],"maximei":["maxim","maximă"],"maximele":["maxim","maximă"],"maximelor":["maxim","maximă"],"maxilari":["maxilar"],"maxilarul":["maxilar"],"maxilarului":["maxilar"],"maxilarii":["maxilar"],"maxilarilor":["maxilar"],"maxilară":["maxilar"],"maxilare":["maxilar"],"maxilara":["maxilar"],"maxilarei":["maxilar"],"maxilarele":["maxilar"],"maxilarelor":["maxilar"],"maximizat":["maximizat","maximiza"],"maximizați":["maximiza","maximizat"],"maximizatul":["maximizat"],"maximizatului":["maximizat"],"maximizații":["maximizat"],"maximizaților":["maximizat"],"maximizată":["maximizat"],"maximizate":["maximizat"],"maximizata":["maximizat"],"maximizatei":["maximizat"],"maximizatele":["maximizat"],"maximi