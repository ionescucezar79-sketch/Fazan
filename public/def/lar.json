{"L":{"laringopatie":{"c":"substantiv feminin","t":"(Med.) Denumire generică pentru bolile laringelui.","s":"DEX '98"},"laringostroboscopie":{"c":"substantiv feminin","t":"(Fon.) Observare a coardelor vocale cu laringostroboscopul.","s":"DEX '98"},"larice":{"c":"substantiv feminin","t":"(Bot.) Zadă. [Var.: lariță s. f.]","s":"DEX '98"},"larici":{"c":"substantiv feminin","t":"(Bot.) Zadă. [Var.: lariță s. f.]","s":"DEX '98"},"larga":{"c":"verb","t":"Tranz. A desprinde un obiect (balast, lest) dintr-o aeronavă în zbor, prin aruncare sau cu ajutorul unui mecanism.","s":"DEX '98"},"largare":{"c":"substantiv feminin","t":"Acțiunea de a larga și rezultatul ei. - V. larga.","s":"DEX '98"},"lărgime":{"c":"substantiv feminin","t":"1. Însușirea de a fi larg; întindere în toate direcțiile; lățime, amploare; dimensiunea transversală a unui recipient, a unei cavități. ♦ Expr. Lărgime de vederi = orizont intelectual deschis, înțelegere cuprinzătoare. 2. Loc larg deschis; spațiu larg în care cineva se poate mișca nestingherit. - Larg + suf. -ime.","s":"DEX '98"},"lărgi":{"c":"verb","t":"Tranz. și refl. A (se) face (mai) larg; a da sau a căpăta lărgime; a (se) întinde. ◊ Fig. A da amploare, a extinde. ◊ Fig. A se împrăștia, a se răspândi.","s":"DEX '98"},"lărgire":{"c":"substantiv feminin","t":"Acțiunea de a (se) lărgi și rezultatul ei. - V. lărgi.","s":"DEX '98"},"lărmui":{"c":"verb","t":"Intranz. A face larmă, a produce zgomot mare. - Larmă + suf. -ui.","s":"DEX '98"},"lărmuire":{"c":"substantiv feminin","t":"(Rar) Acțiunea de a lărmui și rezultatul ei; larmă. - V. lărmui.","s":"DEX '98"},"laringită":{"c":"substantiv feminin","t":"Boală care constă în inflamația (mucoasei) laringelui.","s":"DEX '98"},"lariță":{"c":"substantiv feminin","t":"(Bot.) Zadă. [Var.: lariță s. f.]","s":"DEX '98"},"larmă":{"c":"substantiv feminin","t":"1. Zgomot mare; gălăgie. ◊ Fig. (Rar) Frământare, zbucium. 2. (Înv.) Alarmă.","s":"DEX '98"},"larvă":{"c":"substantiv feminin","t":"Stadiu în dezvoltarea individuală a unor animale la ieșirea din ou, deosebit prin formă și mod de viață de stadiul adult.","s":"DEX '98"},"laringal":{"c":"adjectiv","t":"(Despre sunete) Care se articulează în regiunea laringelui.","s":"DEX '96"},"lărmălău":{"c":"substantiv neutru","t":"(Rar) Hărmălaie, gălăgie, zarvă. - Larmă + suf. -ălău.","s":"DEX '98"},"larariu":{"c":"substantiv neutru","t":"(Livr.) Încăpere în casele romane unde se păstrau statuetele larilor și penaților.","s":"DEX '98"},"lărgitor":{"c":"substantiv neutru","t":"Nume dat mai multor unelte care servesc la lărgirea unui obiect, a unei piese, a unei găuri etc. - Lărgi + suf. -tor.","s":"DEX '98"},"lărguț":{"c":"adjectiv","t":"Diminutiv al lui larg; destul de larg, de lejer. - Larg + suf. -uț.","s":"DEX '98"},"laringologic":{"c":"adjectiv","t":"(Med.) Referitor la laringologie.","s":"DEX '98"},"laringoscopic":{"c":"adjectiv","t":"Referitor la laringoscop, de laringoscop.","s":"DEX '98"},"laringospasm":{"c":"substantiv neutru","t":"(Med.) Spasm al mușchilor glotici.","s":"DEX '98"},"larvar":{"c":"adjectiv","t":"Care este în stare de larvă; referitor la larvă. ◊ Fig. Ascuns, latent, nevăzut.","s":"DEX '98"},"largat":{"c":"verb","t":"Tranz. A desprinde un obiect (balast, lest) dintr-o aeronavă în zbor, prin aruncare sau cu ajutorul unui mecanism.","s":"DEX '98"},"lărgit":{"c":"adjectiv","t":"Care a devenit mai larg, mai cuprinzător, mai amplu. - V. lărgi.","s":"DEX '98"},"laringostroboscop":{"c":"substantiv neutru","t":"(Fon.) Stroboscop specializat pentru studiul coardelor vocale în timpul fonației.","s":"DEX '98"},"larinx":{"c":"substantiv neutru","t":"(Anat.) Partea superioară a traheii, formată din mai multe cartilaje, în structura căreia intră și coardele vocale; beregată.","s":"DEX '98"},"larg":{"c":"adjectiv","t":"(II) larguri, s. n. I. Adj. 1. Care ocupă o suprafață mare, care este extins în toate direcțiile; întins, vast. ♦ Expr. În lumea largă = a) în locuri depărtate, departe; b) pretutindeni. 2. De dimensiuni mari; lat. ♦ Loc. adv. Pe larg = în mod amplu, amănunțit. ◊ (Despre recipiente sau cavități) Cu dimensiunea transversală mare; p. ext. cuprinzător, încăpător. ♦ Expr. …","s":"DEX '98"},"largo":{"c":"adverb","t":"(Indică modul de executare a unei bucăți muzicale) Într-un tempo foarte lent. ◊ (Substantivat, n.) Compoziție sau parte dintr-o compoziție muzicală creată în acest tempo. - Cuv. it.","s":"DEX '98"},"larghețe":{"c":"substantiv feminin","t":"Dărnicie, generozitate.","s":"DEX '98"},"lar":{"c":"substantiv masculin","t":"pl. Nume dat în mitologia romană unor divinități considerate a fi ocrotitoarele casei și ale familiei.","s":"DEX '98"},"larghetto":{"c":"adverb","t":"(Indică modul de executare a unei bucăți muzicale) Într-un tempo intermediar între largo și andante. ◊ (Substantivat, n.) Compoziție sau parte dintr-o compoziție muzicală creată în acest tempo. - Cuv. it.","s":"DEX '98"},"laringe":{"c":"substantiv neutru","t":"(Anat.) Partea superioară a traheii, formată din mai multe cartilaje, în structura căreia intră și coardele vocale; beregată.","s":"DEX '98"},"lariformă":{"c":"substantiv feminin","t":"(La pl.) Ordin de păsări acvatice palmipede, din care fac parte pescărușii; (și la sg.) pasăre din acest ordin.","s":"DEX '98"},"laringofon":{"c":"substantiv neutru","t":"Microfon care se aplică pe gât, în dreptul laringelui, folosit mai ales în transmisiunile din tanc sau din avion.","s":"DEX '98"},"laringolog":{"c":"substantiv masculin și feminin","t":"Medic specializat în laringologie.","s":"DEX '98"},"laringologie":{"c":"substantiv feminin","t":"Parte a medicinii care se ocupă cu studiul laringelui și al bolilor lui.","s":"DEX '98"},"laringologă":{"c":"substantiv masculin și feminin","t":"Medic specializat în laringologie.","s":"DEX '98"},"laringoloagă":{"c":"substantiv masculin și feminin","t":"Medic specializat în laringologie.","s":"DEX '98"},"laringoscop":{"c":"substantiv neutru","t":"Instrument alcătuit dintr-o oglindă prevăzută cu coadă lungă, folosit la examinarea laringelui.","s":"DEX '98"},"laringoscopie":{"c":"substantiv feminin","t":"Examinare medicală a laringelui cu ajutorul laringoscopului.","s":"DEX '98"},"laringotomie":{"c":"substantiv feminin","t":"Operație chirurgicală care constă în deschiderea sau secționarea laringelui.","s":"DEX '98"},"larvicid":{"c":"substantiv neutru","t":"Substanță care ucide larvele unor insecte. ♦ (Adjectival) Substanță larvicidă.","s":"DEX '98"},"laringectomie":{"c":"substantiv feminin","t":"(Med.) Incizie, extirpare a laringelui.","s":"DEX '98"},"laringian":{"c":"adjectiv","t":"Care ține de laringe, al laringelui. [Pr.: -gi-an]","s":"DEX '98"},"lard":{"c":"substantiv neutru","t":"(Reg.) Slănină grasă.","s":"DEX '98"}},"F":{"laringopatii":["laringopatie"],"laringopatia":["laringopatie"],"laringopatiei":["laringopatie"],"laringopatiile":["laringopatie"],"laringopatiilor":["laringopatie"],"laringostroboscopii":["laringostroboscopie"],"laringostroboscopia":["laringostroboscopie"],"laringostroboscopiei":["laringostroboscopie"],"laringostroboscopiile":["laringostroboscopie"],"laringostroboscopiilor":["laringostroboscopie"],"larici":["larici","larice"],"laricea":["larice"],"laricii":["larice"],"laricile":["larice"],"laricilor":["larice"],"lare":["la"],"largare":["largare","larga"],"largări":["largare"],"largarea":["largare"],"largării":["largare"],"largările":["largare"],"largărilor":["largare"],"lărgimi":["lărgime"],"lărgimea":["lărgime"],"lărgimii":["lărgime"],"lărgimile":["lărgime"],"lărgimilor":["lărgime"],"lărgire":["lărgire","lărgi"],"lărgiri":["lărgire"],"lărgirea":["lărgire"],"lărgirii":["lărgire"],"lărgirile":["lărgire"],"lărgirilor":["lărgire"],"lărmuire":["lărmuire","lărmui"],"lărmuiri":["lărmuire"],"lărmuirea":["lărmuire"],"lărmuirii":["lărmuire"],"lărmuirile":["lărmuire"],"lărmuirilor":["lărmuire"],"laringite":["laringită"],"laringita":["laringită"],"laringitei":["laringită"],"laringitele":["laringită"],"laringitelor":["laringită"],"larițe":["lariță"],"larița":["lariță"],