{"L":{"blazgonie":{"c":"substantiv feminin","t":"Lucru bizar, de mirare, de necrezut. ◊ (Fam.) Năzbâtie, poznă, ștrengărie.","s":"DEX '98"},"blăni":{"c":"verb","t":"Tranz. A căptuși cu blană un obiect de îmbrăcăminte; a blănui. - În + blană.","s":"DEX '98"},"blănuire":{"c":"verb","t":"Tranz. (Înv.) A îmblăni. - Blană + suf. -ui.","s":"DEX '98"},"blănui":{"c":"verb","t":"Tranz. (Înv.) A îmblăni. - Blană + suf. -ui.","s":"DEX '98"},"blând":{"c":"adjectiv","t":"s. f. I. Adj. 1. (Despre oameni) Care este omenos, pașnic, prietenos; blajin. ◊ (Despre fapte, sentimente etc.) De om bun. ◊ (Despre animale) Care nu fuge de om; care nu se sperie. 2. Fig. (Despre timp, natură etc.) Care nu este aspru, care nu este excesiv, care este plăcut. II. S. f. (Pop.) Urticarie.","s":"DEX '98"},"blândă":{"c":"adjectiv","t":"s. f. I. Adj. 1. (Despre oameni) Care este omenos, pașnic, prietenos; blajin. ◊ (Despre fapte, sentimente etc.) De om bun. ◊ (Despre animale) Care nu fuge de om; care nu se sperie. 2. Fig. (Despre timp, natură etc.) Care nu este aspru, care nu este excesiv, care este plăcut. II. S. f. (Pop.) Urticarie.","s":"DEX '98"},"blastur":{"c":"substantiv masculin","t":"Bucățică de pânză pe care s-a întins o pastă medicinală densă și lipicioasă, care se aplică pe o rană pentru a o feri de infecție sau cu care se fixează un pansament; emplastru. ◊ (Pop.) Cataplasmă. [Var.: plastur s. m.]","s":"DEX '98"},"blăstămare":{"c":"verb","t":"Tranz. A invoca urgia divinității împotriva cuiva. ◊ Intranz. A înjura, a ocărî, a huli.[Prez. ind. acc. și: blestem]","s":"DEX '98"},"blăstăma":{"c":"verb","t":"Tranz. A invoca urgia divinității împotriva cuiva. ◊ Intranz. A înjura, a ocărî, a huli.[Prez. ind. acc. și: blestem]","s":"DEX '98"},"blajin":{"c":"adjectiv","t":"(Adesea fig.) Blând, omenos, pașnic. ◊ (Despre fizionomia, firea, manifestările oamenilor) Care exprimă bunătate, blândețe. ◊ (Substantivat, f. pl. art.; mitol. pop.) Ființe blânde și evlavioase care trăiesc departe de lume, pe apa Sâmbetei.","s":"DEX '98"},"blagian":{"c":"adjectiv","t":"De Blaga, al lui Blaga; în maniera lui Blaga. [Pr.: -gi-an] - Blaga + suf. -ian.","s":"DEX '98"},"blastomer":{"c":"substantiv neutru","t":"(Biol.) Celulă formată în urma diviziunii primare a zigotului.","s":"DEX '98"},"blagoslovit":{"c":"adjectiv","t":"Binecuvântat. - V. blagoslovi.","s":"DEX '98"},"blagoslovi":{"c":"verb","t":"Tranz. (Adesea fig.) A binecuvânta.","s":"DEX '98"},"blamat":{"c":"adjectiv","t":"1. Care a fost dezaprobat în mod public. 2. Defăimat. - V. blama.","s":"DEX '98"},"blama":{"c":"verb","t":"Tranz. A exprima public dezaprobarea față de o atitudine, un act, un gest etc. considerate reprobabile. ◊ A vorbi de rău, a defăima.","s":"DEX '98"},"blănuit":{"c":"verb","t":"Tranz. (Înv.) A îmblăni. - Blană + suf. -ui.","s":"DEX '98"},"blaza":{"c":"verb","t":"Refl. și tranz. A(-și) toci, a(-și) pierde sau a face să piardă intensitatea simțurilor și a emoțiilor; a (se) dezgusta, a deveni sau a face să devină indiferent.","s":"DEX '98"},"blazat":{"c":"adjectiv","t":"Dezgustat, incapabil de emoții și de sentimente, indiferent. - V. blaza.","s":"DEX '98"},"blanchetă":{"c":"substantiv feminin","t":"Formular (pentru telegrame, polițe etc.).","s":"DEX '98"},"blazon":{"c":"substantiv neutru","t":"Ansamblu de elemente convenționale care constituie emblema unui stat, a unei provincii, a unui oraș, a unei familii nobile, a unei bresle etc.; armoarii.","s":"DEX '98"},"blană":{"c":"substantiv feminin","t":"1. Părul sau lâna care acoperă pielea unor animale. ◊ Piele de animal cu păr cu tot, prelucrată. 2. Haină îmblănită; haină confecționată din blană (I 1). II. (Pop.) Scândură groasă. [Pl. și: (I) blănuri]","s":"DEX '98"},"blăstăm":{"c":"substantiv neutru","t":"Invocare a urgiei divinității împotriva cuiva; nenorocire a cuiva pusă pe seama furiei divine. [Acc. și: blestem]","s":"DEX '98"},"blăstem":{"c":"substantiv neutru","t":"Invocare a urgiei divinității împotriva cuiva; nenorocire a cuiva pusă pe seama furiei divine. [Acc. și: blestem]","s":"DEX '98"},"blăstema":{"c":"verb","t":"Tranz. A invoca urgia divinității împotriva cuiva. ◊ Intranz. A înjura, a ocărî, a huli.[Prez. ind. acc. și: blestem]","s":"DEX '98"},"blăstămat":{"c":"adjectiv","t":"1. Lovit, ajuns de blestem. ◊ Rău, neprielnic, dușmănos. 2. (Adesea substantivat) Cu purtări rele; depravat, rău, ticălos. - V. blestema.","s":"DEX '98"},"blăstemare":{"c":"verb","t":"Tranz. A invoca urgia divinității împotriva cuiva. ◊ Intranz. A înjura, a ocărî, a huli.[Prez. ind. acc. și: blestem]","s":"DEX '98"},"blăstămăție":{"c":"substantiv feminin","t":"Purtare, faptă de om blestemat. ◊ Depravare. - Blestemat + suf. -ie.","s":"DEX '98"},"blândeță":{"c":"substantiv feminin","t":"Însușirea omului blând; purtare de om blând. - Blând + suf. -ețe.","s":"DEX '98"},"blândețe":{"c":"substantiv feminin","t":"Însușirea omului blând; purtare de om blând. - Blând + suf. -ețe.","s":"DEX '98"},"blasfemator":{"c":"adjectiv","t":"s. m. și f. (Livr.) (Persoană) care defăimează (cele sfinte).","s":"DEX '98"},"blasfematoare":{"c":"adjectiv","t":"s. m. și f. (Livr.) (Persoană) care defăimează (cele sfinte).","s":"DEX '98"},"blază":{"c":"substantiv feminin","t":"Parte a unei instalații de distilare în formă de recipient, în care se introduce amestecul distilat.","s":"DEX '98"},"blasfemie":{"c":"substantiv feminin","t":"(Livr.) Defăimare a religiei, a dogmelor și a obiectelor de cult; defăimare a lucrurilor sfinte; hulă.","s":"DEX '98"},"blanșare":{"c":"substantiv feminin","t":"Operație de sterilizare, prin opărire, a alimentelor, folosită în industria conservelor.","s":"DEX '98"},"blaz":{"c":"substantiv feminin","t":"Parte a unei instalații de distilare în formă de recipient, în care se introduce amestecul distilat.","s":"DEX '98"},"blazer":{"c":"substantiv neutru","t":"Jachetă bărbătească din stofă, catifea etc. (cu buzunare aplicate). [Pr.: bleizăr]","s":"DEX '98"},"blănărie":{"c":"substantiv feminin","t":"1. Meseria blănarului. 2. Atelier în care se confecționează îmbrăcăminte din blană; magazin de vânzare a blănurilor. - Blănar + suf. -ie.","s":"DEX '98"},"blagoslovenie":{"c":"substantiv feminin","t":"Blagoslovire.","s":"DEX '98"},"blagoslovire":{"c":"substantiv feminin","t":"Acțiunea de a blagoslovi; binecuvântare, blagoslovenie. - V. blagoslovi.","s":"DEX '98"},"blau":{"c":"substantiv neutru","t":"(Rar; în expr.) A face blau= a lipsi de la lucru a doua zi după o sărbătoare.","s":"DEX '98"},"blacheu":{"c":"substantiv neutru","t":"Bucată (semiovală) de tablă care se aplică pe vârful și pe tocul încălțămintei pentru a le proteja. [Var.: placheu s. n.]","s":"DEX '98"},"blajinătate":{"c":"substantiv feminin","t":"(Rar) Însușirea de a fi blajin. - Blajin + suf. -ătate.","s":"DEX '98"},"blam":{"c":"substantiv neutru","t":"Dezaprobare, condamnare publică a unei atitudini; exprimare a unei astfel de dezaprobări.","s":"DEX '98"},"blamare":{"c":"substantiv feminin","t":"Acțiunea de a blama. - V. blama.","s":"DEX '98"},"blamabil":{"c":"adjectiv","t":"(Livr.) Care merită să fie blamat; reprobabil.","s":"DEX '98"},"blanc":{"c":"substantiv neutru","t":"1. Piele tăbăcită, suplă și elastică, folosită în marochinărie. 2. Fâșie de material insensibil adăugată la capetele bobinelor de film sau de bandă magnetică pentru a le proteja.","s":"DEX '98"},"blanșir":{"c":"substantiv neutru","t":"Rest nefolositor rezultat de la blanșiruire.","s":"DEX '98"},"blanșiruire":{"c":"substantiv feminin","t":"Operație de curățire a dosului pieilor tăbăcite.","s":"DEX '98"},"blastru":{"c":"substantiv masculin","t":"Bucățică de pânză pe care s-a întins o pastă medicinală densă și lipicioasă, care se aplică pe o rană pentru a o feri de infecție sau cu care se fixează un pansament; emplastru. ◊ (Pop.) Cataplasmă. [Var.: plastur s. m.]","s":"DEX '98"},"blastulă":{"c":"substantiv feminin","t":"Stadiu embrionar la metazoare, de formă globulară, cu celulele dispuse într-un singur strat și cu o cavitate în interior.","s":"DEX '98"},"blat":{"c":"substantiv neutru","t":"Foaie din aluat special preparată pentru tort.","s":"DEX '98"},"blazare":{"c":"substantiv feminin","t":"Faptul de a (se) blaza. - V. blaza.","s":"DEX '98"},"blănar":{"c":"substantiv masculin","t":"Meseriaș care face îmbrăcăminte din blană; negustor de blănuri. - Blană + suf. -ar.","s":"DEX '98"},"blănăreasă":{"c":"substantiv feminin","t":"Femeie care face îmbrăcăminte din blană; negustoreasă de blănuri. ◊ Soția blănarului. - Blănar + suf. -easă.","s":"DEX '98"},"blănit":{"c":"adjectiv","t":"(Despre îmbrăcăminte) Căptușit cu blană. - V. îmblăni.","s":"DEX '98"},"blăniță":{"c":"substantiv feminin","t":"Diminutiv al lui blană (1). - Blană + suf. -iță.","s":"DEX '98"},"blănos":{"c":"adjectiv","t":"(Rar; despre animale sau haine) Cu blană bogată. - Blană + suf. -os.","s":"DEX '98"}},"F":{"blazgonii":["blazgonie"],"blazgonia":["blazgonie"],"blazgoniei":["blazgonie"],"blazgoniile":["blazgonie"],"blazgoniilor":["blazgonie"],"blănire":["blăni"],"blănuire":["blănuire","blănui"],"blândă":["blândă","blând"],"blânde":["blând","blândă"],"blânda":["blând","blândă"],"blândei":["blând","blândă"],"blândele":["blând","blândă"],"blândelor":["blând","blândă"],"blasture":["blastur"],"blasturele":["blastur"],"blăstămare":["blăstămare","blăstăma"],"blajinii":["blajin"],"blastăm":["blăstăma"],"blagieni":["blagian"],"blagianul":["blagian"],"blagianului":["blagian"],"blagienii":["blagian"],"blagienilor":["blagian"],"blagiană":["blagian"],"blagiene":["blagian"],"blagiana":["blagian"],"blagienei":["blagian"],"blagienele":["blagian"],"blagienelor":["blagian"],"blânzi":["blând"],"blândul":["blând"],"blândului":["blând"],"blânzii":["blând"],"blânzilor":["blând"],"blastomere":["blastomer"],"blastomerul":["blastomer"],"blastomerului":["blastomer"],"blastomerele":["blastomer"],"blastomerelor":["blastomer"],"blagoslovit":["blagoslovit","blagoslovi"],"blagosloviți":["blagoslovi","blagoslovit"],"blagoslovitul":["blagoslovit"],"blagoslovitului":["blagoslovit"],"blagosloviții":["bl