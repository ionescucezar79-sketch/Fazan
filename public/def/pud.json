{"L":{"pudibonderie":{"c":"substantiv feminin","t":"(Livr.) Afectare a unei pudori exagerate. [Var.: pudibunderie s. f.]","s":"DEX '98"},"pudoare":{"c":"substantiv feminin","t":"Sentiment de sfială, de jenă, de decență manifestat în comportarea cuiva; pudicitate; p. ext. curățenie morală. ◊ (Jur.) Castitate, virginitate. ◊ Atentat la pudoare = infracțiune care constă în încercarea de a viola o femeie.","s":"DEX '98"},"pudlare":{"c":"substantiv feminin","t":"Acțiunea de a pudla. - V. pudla.","s":"DEX '98"},"pudla":{"c":"verb","t":"Tranz. (Metalurgie) A supune oțelul operației de pudlaj.","s":"DEX '98"},"pudrui":{"c":"verb","t":"Tranz. și refl. (Înv.) A (se) pudra (1). - Pudră + suf. -ui.","s":"DEX '98"},"pudruire":{"c":"verb","t":"Tranz. și refl. (Înv.) A (se) pudra (1). - Pudră + suf. -ui.","s":"DEX '98"},"pudl":{"c":"substantiv masculin","t":"Rasă de câini de mărime mijlocie, cu părul lung și lățos, ușor de dresat, folosită la vânatul păsărilor acvatice. [Var.: (rar) pudl s. m.]","s":"DEX '98"},"pudic":{"c":"adjectiv","t":"Plin de pudoare; candid.","s":"DEX '98"},"pud":{"c":"substantiv neutru","t":"Unitate (rusească) de măsură pentru greutăți egală cu 16,38 kg.","s":"DEX '98"},"pudibond":{"c":"adjectiv","t":"(Livr.) Care afișează o pudoare exagerată.","s":"DEX '98"},"pudibund":{"c":"adjectiv","t":"(Livr.) Care afișează o pudoare exagerată.","s":"DEX '98"},"puding":{"c":"substantiv neutru","t":"Preparat alimentar de origine engleză, făcut din făină, ouă, grăsime de vacă, zahăr, măduvă, prune și aromat cu o băutură alcoolică.","s":"DEX '98"},"pudlat":{"c":"adjectiv","t":"(Despre oțel) Care a fost supus operației de pudlaj. - V. pudla.","s":"DEX '98"},"pudra":{"c":"verb","t":"1. Tranz. și refl. A (se) da cu pudră (pe față), a (se) farda cu pudră; a (se) pudrui. 2. Tranz. A acoperi cu un strat subțire de pulbere (de făină, de zahăr etc.).","s":"DEX '98"},"pudrat":{"c":"adjectiv","t":"Dat, acoperit cu pudră; cu fața acoperită de un strat de pudră; pudruit. - V. pudra.",